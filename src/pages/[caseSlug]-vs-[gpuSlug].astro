---
import hardwareData from '../data/hardware.json';
import { calculateClearance } from '../utils/clearanceEngine';
import { ClearanceCanvas } from '../components/ClearanceCanvas';
import { AffiliateBanners } from '../components/AffiliateBanners';
import '../styles/global.css';

// Esta función es el corazón del pSEO. Le dice a Astro qué URLs debe fabricar.
export function getStaticPaths() {
  // Add ': any[]' to explicitly type the paths array
  const paths: any[] = []; 

  // ... rest of your code

  // Cruzamos todas las cajas con todas las GPUs
  hardwareData.cases.forEach((caseItem) => {
    hardwareData.gpus.forEach((gpuItem) => {
      paths.push({
        params: {
          caseSlug: caseItem.slug,
          gpuSlug: gpuItem.slug,
        },
        props: {
          caseObj: caseItem,
          gpuObj: gpuItem,
          // Para el análisis base SEO asumimos que no hay refrigeración líquida frontal (AIO "none")
          aioObj: hardwareData.aios.find(aio => aio.slug === 'none') || hardwareData.aios[0],
        },
      });
    });
  });

  return paths; // Con tus datos actuales, esto devolverá 9 páginas distintas
}

// Extraemos los datos que getStaticPaths acaba de inyectar para la URL actual
const { caseObj, gpuObj, aioObj } = Astro.props;
const result = calculateClearance(caseObj, gpuObj, aioObj);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>¿Cabe la {gpuObj.brand} {gpuObj.model} en la {caseObj.brand} {caseObj.model}? - PC Clearance Lab</title>
    <meta name="description" content={`Comprueba visualmente si la tarjeta gráfica ${gpuObj.brand} ${gpuObj.model} cabe en la caja ${caseObj.brand} ${caseObj.model}. Análisis de colisión y conector 12VHPWR.`} />

    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">

  </head>
  <body class="bg-[#0B0F17] text-slate-200 min-h-screen p-4 md:p-8 font-sans">
    <main class="max-w-4xl mx-auto space-y-8">
      
      <header class="text-center space-y-2">
        <h1 
  class="text-3xl sm:text-4xl font-extrabold tracking-wide text-white uppercase text-center" 
  style="font-family: 'Zen Dots', sans-serif;"
>
  Analisis de Compatibilidad
</h1>
        <p class="text-slate-400">
          Caja: <span class="text-[#00F0FF]">{caseObj.brand} {caseObj.model}</span> | GPU: <span class="text-white">{gpuObj.brand} {gpuObj.model}</span>
        </p>
      </header>

<ClearanceCanvas
  caseObj={caseObj}
  gpuObj={gpuObj}
  status={result.status} 
  client:load
/>
      
      <AffiliateBanners 
        caseObj={caseObj} 
        gpuObj={gpuObj} 
        result={result} 
      />

    </main>
  </body>
</html>