---
import hardwareData from '../data/hardware.json';
import { calculateClearance } from '../utils/clearanceEngine';
import { ClearanceCanvas } from '../components/ClearanceCanvas';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export async function getStaticPaths() {
  const { cases, gpus } = hardwareData;
  const paths = [];

  for (const caseItem of cases) {
    for (const gpuItem of gpus) {
      paths.push({
        params: { caseSlug: caseItem.slug, gpuSlug: gpuItem.slug },
        props: { caseObj: caseItem, gpuObj: gpuItem },
      });
    }
  }
  return paths;
}

const { caseObj, gpuObj } = Astro.props;
const result = calculateClearance(caseObj, gpuObj);
const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Es compatible la {gpuObj.brand} {gpuObj.model} con la caja {caseObj.brand} {caseObj.model}? - Lidunax</title>
    <meta name="description" content={`Análisis técnico de compatibilidad física entre la tarjeta gráfica ${gpuObj.brand} ${gpuObj.model} y la caja ${caseObj.brand} ${caseObj.model}.`} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Datos Estructurados JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": `Compatibilidad: ${caseObj.brand} ${caseObj.model} vs ${gpuObj.brand} ${gpuObj.model}`,
      "description": `Informe técnico de tolerancia física, espacio libre y holgura entre la caja ${caseObj.brand} ${caseObj.model} y la gráfica ${gpuObj.brand} ${gpuObj.model}.`,
      "url": canonicalURL.toString(),
      "about": [
        {
          "@type": "Thing",
          "name": `${caseObj.brand} ${caseObj.model}`
        },
        {
          "@type": "Thing",
          "name": `${gpuObj.brand} ${gpuObj.model}`
        }
      ]
    })} />
  </head>

  <body class="bg-black text-slate-100 min-h-screen font-sans flex flex-col justify-between selection:bg-[#00F0FF] selection:text-black relative overflow-x-hidden">
    
    <!-- FONDO: Malla de puntitos + Degradado cian (#00F0FF) desde Esquina Izquierda -->
    <div class="fixed inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-45 pointer-events-none"></div>
    <div class="fixed -top-20 -left-20 w-[900px] h-[700px] bg-gradient-to-br from-[#00F0FF]/35 via-[#00F0FF]/10 to-transparent blur-[140px] pointer-events-none"></div>

    <div class="relative z-10">
      <header class="border-b border-white/10 backdrop-blur-md bg-black/40">
        <div class="max-w-6xl mx-auto px-6 h-16 sm:h-20 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3">
            <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-black border border-[#00F0FF]/50 flex items-center justify-center shadow-[0_0_10px_rgba(0,240,255,0.2)]">
              <span class="text-[#00F0FF] text-xs sm:text-sm font-bold" style="font-family: 'Orbitron', sans-serif;">LDX</span>
            </div>
            <span class="text-base sm:text-lg tracking-wider font-bold text-white" style="font-family: 'Orbitron', sans-serif;">LID<span class="text-[#00F0FF]">UNAX</span></span>
          </a>

          <nav class="flex gap-6 text-sm font-mono text-slate-300">
            <a href="/" class="hover:text-[#00F0FF] transition-colors">Inicio</a>
            <a href="/faq" class="hover:text-[#00F0FF] transition-colors">FAQ</a>
          </nav>
        </div>
      </header>

      <main class="max-w-6xl mx-auto px-4 py-6 sm:py-8 space-y-8">
        
        <!-- Título Compacto -->
        <div class="text-center space-y-1">
          <h1 class="text-xl sm:text-3xl font-extrabold text-white" style="font-family: 'Orbitron', sans-serif;">
            {caseObj.brand} {caseObj.model} <span class="text-[#00F0FF]">VS</span> {gpuObj.brand} {gpuObj.model}
          </h1>
          <p class="text-slate-400 font-mono text-xs sm:text-sm">
            Tolerancia física y comprobación de holgura.
          </p>
        </div>

        <!-- BLOQUE HERÓICO 2 COLUMNAS (ABOVE THE FOLD) -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
          
          <!-- Columna Izquierda: Gráfico Visual Completo Sin Scroll (7 cols) -->
          <div class="lg:col-span-7 bg-slate-950/60 border border-white/10 p-4 rounded-2xl flex items-center justify-center backdrop-blur-sm overflow-hidden">
            <div class="w-full flex justify-center [&>svg]:w-full [&>svg]:h-auto [&>svg]:max-h-[380px]">
              <ClearanceCanvas client:load caseObj={caseObj} gpuObj={gpuObj} />
            </div>
          </div>

          <!-- Columna Derecha: Resultado & Tiendas Estilizadas (5 cols) -->
          <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
            
            <!-- Panel de Estado -->
            <div class={`p-4 rounded-2xl border backdrop-blur-sm ${
              result.status === 'GREEN' 
                ? 'bg-emerald-950/20 border-emerald-500/40 text-emerald-400' 
                : result.status === 'YELLOW' 
                ? 'bg-amber-950/20 border-amber-500/40 text-amber-400' 
                : 'bg-rose-950/20 border-rose-500/40 text-rose-400'
            }`}>
              <div class="flex items-center gap-2">
                <span class={`w-3 h-3 rounded-full animate-pulse ${
                  result.status === 'GREEN' ? 'bg-emerald-400' : result.status === 'YELLOW' ? 'bg-amber-400' : 'bg-rose-500'
                }`}></span>
                <h2 class="font-bold text-sm sm:text-base font-mono uppercase tracking-wide">
                  {result.status === 'GREEN' && 'Compatibilidad Confirmada'}
                  {result.status === 'YELLOW' && 'Espacio Ajustado / Precaución'}
                  {result.status === 'RED' && 'Incompatibilidad Física'}
                </h2>
              </div>
              <p class="text-xs font-mono mt-2 text-slate-300 leading-relaxed">
                Holgura bruta: <strong class="text-white">+{result.grossFrontMarginMM} mm</strong>. Libre neto: <strong class="text-white">{result.frontMarginMM} mm</strong> (descontando {result.frontDiscount}mm de ventilación).
              </p>
            </div>

            <!-- Bloques de Tiendas (Bordes de color, texto blanco neutro) -->
            <div class="bg-slate-950/60 border border-white/10 p-4 rounded-2xl space-y-3 flex-1 flex flex-col justify-center backdrop-blur-sm">
              <span class="text-xs font-mono text-slate-400 uppercase tracking-wider block">
                Comprobar precios por tienda:
              </span>

              <div class="space-y-3 font-mono text-xs">
                
                <!-- TIENDA 1: Amazon (Borde Dorado / Texto Neutro) -->
                <div class="p-3 rounded-xl bg-black/50 border border-amber-500/50 space-y-2">
                  <div class="text-slate-200 font-bold text-xs uppercase tracking-wider">
                    Amazon ES
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <a 
                      href={`https://www.amazon.es/s?k=${encodeURIComponent(caseObj.brand + ' ' + caseObj.model)}&tag=lidunax-21`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-amber-500/30 hover:border-amber-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      Caja Amazon →
                    </a>
                    <a 
                      href={`https://www.amazon.es/s?k=${encodeURIComponent(gpuObj.brand + ' ' + gpuObj.model)}&tag=lidunax-21`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-amber-500/30 hover:border-amber-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      GPU Amazon →
                    </a>
                  </div>
                </div>

                <!-- TIENDA 2: PcComponentes (Borde Naranja / Texto Neutro) -->
                <div class="p-3 rounded-xl bg-black/50 border border-orange-500/50 space-y-2">
                  <div class="text-slate-200 font-bold text-xs uppercase tracking-wider">
                    PcComponentes
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <a 
                      href={`https://www.pccomponentes.com/buscar/?query=${encodeURIComponent(caseObj.brand + ' ' + caseObj.model)}`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-orange-500/30 hover:border-orange-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      Caja PcComp →
                    </a>
                    <a 
                      href={`https://www.pccomponentes.com/buscar/?query=${encodeURIComponent(gpuObj.brand + ' ' + gpuObj.model)}`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-orange-500/30 hover:border-orange-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      GPU PcComp →
                    </a>
                  </div>
                </div>

                <!-- TIENDA 3: Coolmod (Borde Azul / Texto Neutro) -->
                <div class="p-3 rounded-xl bg-black/50 border border-blue-500/50 space-y-2">
                  <div class="text-slate-200 font-bold text-xs uppercase tracking-wider">
                    Coolmod
                  </div>
                  <div class="grid grid-cols-2 gap-2">
                    <a 
                      href={`https://www.coolmod.com/buscar/?search=${encodeURIComponent(caseObj.brand + ' ' + caseObj.model)}`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-blue-500/30 hover:border-blue-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      Caja Coolmod →
                    </a>
                    <a 
                      href={`https://www.coolmod.com/buscar/?search=${encodeURIComponent(gpuObj.brand + ' ' + gpuObj.model)}`}
                      target="_blank" rel="noopener noreferrer"
                      class="px-2.5 py-1.5 bg-black/60 border border-blue-500/30 hover:border-blue-400 text-slate-200 hover:text-white rounded-lg text-center font-semibold transition-all truncate"
                    >
                      GPU Coolmod →
                    </a>
                  </div>
                </div>

              </div>
            </div>

          </div>

        </div>

        <!-- Tabla de Especificaciones Comparativas -->
        <section class="bg-slate-950/60 border border-white/10 p-6 rounded-2xl space-y-4 backdrop-blur-sm">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider font-mono">
            Métricas de Dimensiones Comparadas
          </h2>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm font-mono border-collapse">
              <thead>
                <tr class="border-b border-white/10 text-[#00F0FF]">
                  <th class="py-3 px-2">Parámetro</th>
                  <th class="py-3 px-2">Caja: {caseObj.model}</th>
                  <th class="py-3 px-2">GPU: {gpuObj.model}</th>
                  <th class="py-3 px-2">Resultado / Margen</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 text-slate-300">
                <tr>
                  <td class="py-3 px-2 font-semibold">Longitud Máxima</td>
                  <td class="py-3 px-2">{caseObj.maxGpuLengthMM} mm</td>
                  <td class="py-3 px-2">{gpuObj.dimensions.lengthMM} mm</td>
                  <td class="py-3 px-2">
                    <span class="font-bold text-[#00F0FF]">+{result.grossFrontMarginMM} mm brutos</span>
                    <span class="text-xs text-slate-400 block">({result.frontMarginMM} mm libres restando {result.frontDiscount}mm de ventilación)</span>
                  </td>
                </tr>
                <tr>
                  <td class="py-3 px-2 font-semibold">Ancho / Margen Lateral</td>
                  <td class="py-3 px-2">{caseObj.internalWidthMM} mm</td>
                  <td class="py-3 px-2">{gpuObj.dimensions.widthMM} mm</td>
                  <td class="py-3 px-2">{result.lateralMarginMM} mm para cable</td>
                </tr>
                <tr>
                  <td class="py-3 px-2 font-semibold">Conector / Alimentación</td>
                  <td class="py-3 px-2">-</td>
                  <td class="py-3 px-2">{gpuObj.connectorType}</td>
                  <td class="py-3 px-2">{result.status === 'RED' ? 'Incompatible' : 'Compatible'}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Análisis Técnico y Evaluación Dinámica -->
        <section class="bg-slate-950/40 border border-white/10 p-6 rounded-2xl space-y-4 text-sm font-mono text-slate-300 leading-relaxed backdrop-blur-sm">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider font-mono">
            Análisis de Ensamblaje y Flujo de Aire
          </h2>
          
          <p>
            Al instalar la <strong>{gpuObj.brand} {gpuObj.model}</strong> (longitud de <strong>{gpuObj.dimensions.lengthMM} mm</strong>) dentro del chasis <strong>{caseObj.brand} {caseObj.model}</strong> (capaz de albergar hasta <strong>{caseObj.maxGpuLengthMM} mm</strong>), el espacio frontal restante bruto es de <strong>+{result.grossFrontMarginMM} mm</strong>. Tras instalar los ventiladores frontales estándar ({result.frontDiscount} mm), la holgura neta para la tarjeta es de <strong>{result.frontMarginMM} mm</strong>.
          </p>

          <!-- Condicional por margen frontal (AIO/Refrigeración) -->
          {result.frontMarginMM < 15 && result.frontMarginMM >= 0 && (
            <p class="text-amber-400">
              <strong>Nota sobre AIO/Refrigeración:</strong> El espacio libre neto es ajustado ({result.frontMarginMM} mm). Si planeas montar un radiador de refrigeración líquida frontal, recuerda que un AIO añade entre 27 mm y 55 mm extra (radiador + ventiladores), por lo que se recomienda instalar la refrigeración líquida en el panel superior.
            </p>
          )}

          <!-- Condicional por conector 12VHPWR / Alimentación -->
          {gpuObj.connectorType?.includes('16-pin') || gpuObj.connectorType?.includes('12VHPWR') ? (
            <p class="text-slate-300">
              <strong>Gestión de Cableado:</strong> Esta tarjeta gráfica utiliza el conector <strong>{gpuObj.connectorType}</strong>. Se recomienda verificar que la holgura lateral supere los 30 mm respecto al panel lateral de cristal para evitar doblados pronunciados en el cable de alimentación.
            </p>
          ) : null}

          <!-- Lista de avisos del motor de compatibilidad -->
          <div class="space-y-2 mt-4">
            {result.warnings.map((warning) => (
              <p class={result.status === 'GREEN' ? "text-[#00FF66]" : result.status === 'YELLOW' ? "text-[#FFCC00]" : "text-[#FF0055]"}>
                <strong>Aviso técnico:</strong> {warning}
              </p>
            ))}
          </div>
        </section>

      </main>
    </div>

    <Footer />
  </body>
</html>