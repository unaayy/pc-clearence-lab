---
import cpusData from '../data/cpus.json';
import coolersData from '../data/coolers.json';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getStoresForLocale } from '../config/stores.js';

// 1. GENERADOR DE RUTAS (REQUERIDO POR ASTRO EN MODO ESTÁTICO)
export async function getStaticPaths() {
  // Limitamos a 100x100 para que el build no se quede colgado horas procesando combinaciones
  const cpus = cpusData.slice(0, 100);
  const coolers = coolersData.slice(0, 100);

  const paths = [];
  for (const cpu of cpus) {
    for (const cooler of coolers) {
      paths.push({
        params: { cpuSlug: cpu.slug, coolerSlug: cooler.slug },
        props: { cpu, cooler }
      });
    }
  }
  return paths;
}

// 2. RECUPERAR DATOS DE LA COMBINACIÓN ACTUAL
const { cpu, cooler } = Astro.props;

if (!cpu || !cooler) {
  return Astro.redirect('/404');
}

// Configuración dinámica de tiendas por idioma/región
const currentLang = Astro.url.searchParams.get('lang') || Astro.currentLocale || 'es';
const stores = getStoresForLocale(currentLang);

const cpuQuery = `${cpu.brand} ${cpu.model}`.trim();
const coolerQuery = `${cooler.brand} ${cooler.model}`.trim();

// 3. MOTOR DE CÁLCULO TÉRMICO
const cpuTdp = cpu.tdp || cpu.watts || 120;

// Estimación matemática de disipación
const getCoolerCapacity = (cooler) => {
  if (cooler.type === 'AIO' || cooler.isLiquid) {
    if (cooler.radiatorSizeMM >= 360) return 320;
    if (cooler.radiatorSizeMM >= 280) return 280;
    if (cooler.radiatorSizeMM >= 240) return 250;
    return 200;
  }
  if (cooler.heightMM >= 162) return 250; 
  if (cooler.heightMM >= 155) return 230; 
  return 180; 
};

const coolerCapacity = getCoolerCapacity(cooler);
const margin = coolerCapacity - cpuTdp;

// Lógica de colores semáforo térmico
let status = 'verde';
let colorHex = '#10b981'; // Emerald (Frío)
let statusText = 'DESPEJE TÉRMICO ÓPTIMO';
let statusMessage = 'TEMPERATURAS ESTABLES / SIN THROTTLING';

if (margin < -15) {
  status = 'rojo';
  colorHex = '#f43f5e'; // Rose (Caliente)
  statusText = 'CRÍTICO / THROTTLING TÉRMICO';
  statusMessage = 'DÉFICIT DE DISIPACIÓN SEVERO';
} else if (margin < 20) {
  status = 'amarillo';
  colorHex = '#fbbf24'; // Amber (Ajustado)
  statusText = 'MARGEN TÉRMICO AJUSTADO';
  statusMessage = 'ADVERTENCIA BAJO CARGA MÁXIMA';
}

const isAIO = Boolean(
  cooler.type === 'AIO' || 
  cooler.isLiquid || 
  cooler.isLiquid === 'true' ||
  /kraken|aio|liquid|water|360|240|280|420/i.test(`${cooler.brand || ''} ${cooler.model || ''}`)
);

// Texto SEO declarativo para la animación al hacer scroll
const statement = `El análisis de compatibilidad térmica de Lidunax evalúa la generación de calor TDP del procesador ${cpu.brand} ${cpu.model} frente a la capacidad de disipación del disipador ${cooler.brand} ${cooler.model}, comprobando la compatibilidad de socket y el despeje físico.`;
const statementWords = statement.split(' ');

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Compatibilidad térmica: {cpu.brand} {cpu.model} y disipador {cooler.brand} {cooler.model} - LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.webp?v=5" />
    <meta name="description" content={`Análisis técnico térmico: Comprueba si el disipador ${cooler.brand} ${cooler.model} puede enfriar eficientemente los ${cpuTdp}W de calor generados por el procesador ${cpu.model}.`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen font-sans selection:bg-[#00ffff] selection:text-black">
    
    <!-- Navbar -->
    <header class="border-b border-white/10 bg-black/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logoancho.webp" alt="LDX" width="160" height="32" class="h-8 w-auto object-contain" />
          <span class="font-orbitron font-bold tracking-widest hidden sm:block">LIDUNAX</span>
        </a>
        <nav class="flex gap-6 text-sm font-orbitron tracking-wider text-slate-400">
          <a href="/cpu-refrig" class="hover:text-[#00ffff] transition-colors">← VOLVER AL BUSCADOR</a>
        </nav>
      </div>
    </header>

    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12">
      
      <!-- Encabezado del reporte -->
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-bold font-orbitron mb-3 uppercase tracking-wide">
          <span class="text-slate-400 block text-lg mb-1">Informe de Termodinámica</span>
          {cpu.brand} {cpu.model}
        </h1>
        <p class="text-slate-400 max-w-2xl text-sm sm:text-base mx-auto sm:mx-0">
          Evaluación de transferencia térmica y compatibilidad de montaje (Socket {cpu.socket}) usando refrigeración <strong class="text-white">{cooler.brand} {cooler.model}</strong>.
        </p>
      </div>

      <!-- Diagrama visual y panel de diagnóstico -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 mb-12">
        
        <!-- DIAGRAMA VISUAL ESQUEMÁTICO REALISTA -->
        <div class="relative bg-[#0a0a0c] border border-white/5 rounded-[24px] overflow-hidden min-h-[460px] flex items-center justify-center p-4 sm:p-8 shadow-[inset_0_0_80px_rgba(0,0,0,0.8)]">
          <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          
          <svg viewBox="0 0 500 550" class="w-full max-w-[500px] relative z-10 drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
            <defs>
              <filter id="glow" x="-30%" y="-30%" width="160%" height="160%">
                <feGaussianBlur stdDeviation="5" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="softGlow">
                <feGaussianBlur stdDeviation="2" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <pattern id="fins" width="10" height="6" patternUnits="userSpaceOnUse">
                <line x1="0" y1="3" x2="10" y2="3" stroke="#30363d" stroke-width="1.5"/>
              </pattern>
            </defs>

            {/* PLACA BASE Y SOCKET */}
            <g transform="translate(50, 420)">
              <rect x="0" y="0" width="400" height="30" rx="4" fill="#090d13" stroke="white" stroke-opacity="0.2" stroke-width="2" />
              
              <rect x="30" y="-35" width="50" height="35" rx="2" fill="#161b22" stroke="white" stroke-opacity="0.3" stroke-width="1.5" />
              <path d="M 35 -35 V 0 M 45 -35 V 0 M 55 -35 V 0 M 65 -35 V 0 M 75 -35 V 0" stroke="white" stroke-opacity="0.1" stroke-width="2"/>
              
              <g transform="translate(300, -50)">
                <rect x="0" y="0" width="8" height="50" rx="1" fill="#161b22" stroke="white" stroke-opacity="0.2"/>
                <rect x="16" y="0" width="8" height="50" rx="1" fill="#161b22" stroke="white" stroke-opacity="0.2"/>
                <rect x="32" y="0" width="8" height="50" rx="1" fill="#161b22" stroke="white" stroke-opacity="0.2"/>
                <rect x="48" y="0" width="8" height="50" rx="1" fill="#161b22" stroke="white" stroke-opacity="0.2"/>
                <text x="28" y="65" fill="#888" font-family="monospace" font-size="9" text-anchor="middle">DIMM SLOTS</text>
              </g>

              <rect x="140" y="-15" width="120" height="15" fill="#1a202c" stroke="white" stroke-opacity="0.4" stroke-width="1.5" />
              <path d="M 265 -8 L 285 -8 L 285 -30 L 275 -30" fill="none" stroke="white" stroke-opacity="0.5" stroke-width="2.5" stroke-linecap="round"/>
              
              <text x="200" y="20" fill="white" font-family="monospace" font-size="11" text-anchor="middle" opacity="0.6" letter-spacing="1">MOTHERBOARD | {cpu.socket}</text>
            </g>

            {/* SISTEMA DE REFRIGERACIÓN */}
            {isAIO ? (
              <g transform="translate(0, 0)">
                <path d="M 210 390 C 130 250 130 150 180 80" fill="none" stroke="#090d13" stroke-width="18" stroke-linecap="round" stroke-opacity="0.8"/>
                <path d="M 290 390 C 370 250 370 150 320 80" fill="none" stroke="#090d13" stroke-width="18" stroke-linecap="round" stroke-opacity="0.8"/>

                <path d="M 180 80 C 130 150 130 250 210 390" fill="none" stroke="#00ffff" stroke-width="6" stroke-linecap="round" class="liquid-cold" filter="url(#glow)"/>
                <path d="M 290 390 C 370 250 370 150 320 80" fill="none" stroke={colorHex} stroke-width="6" stroke-linecap="round" class="liquid-hot" filter="url(#glow)"/>

                <rect x="200" y="350" width="100" height="45" rx="8" fill="#161b22" stroke="white" stroke-opacity="0.6" stroke-width="2" />
                <circle cx="250" cy="372" r="16" fill="#0d1117" stroke={colorHex} stroke-width="2.5" filter="url(#glow)"/>
                
                <g transform="translate(110, 30)">
                  <rect x="0" y="20" width="280" height="30" rx="3" fill="#161b22" stroke="white" stroke-opacity="0.5" stroke-width="2" />
                  <rect x="5" y="25" width="270" height="20" fill="url(#fins)" stroke="none" />
                  
                  <rect x="5" y="5" width="85" height="15" rx="2" fill="#1a202c" stroke="white" stroke-opacity="0.3" stroke-width="1.5" />
                  <rect x="97" y="5" width="85" height="15" rx="2" fill="#1a202c" stroke="white" stroke-opacity="0.3" stroke-width="1.5" />
                  {(cooler.radiatorSizeMM || 360) >= 360 && <rect x="189" y="5" width="85" height="15" rx="2" fill="#1a202c" stroke="white" stroke-opacity="0.3" stroke-width="1.5" />}
                </g>
                <text x="250" y="20" fill="white" font-family="Orbitron" font-size="14" text-anchor="middle" filter="url(#softGlow)">RADIADOR AIO {cooler.radiatorSizeMM || 360}mm</text>
              </g>
            ) : (
              <g transform="translate(0, 0)">
                <path d="M 215 395 V 150 M 235 395 V 150 M 255 395 V 150 M 275 395 V 150 M 285 395 V 150" fill="none" stroke="#b87333" stroke-width="6" stroke-linecap="round" stroke-opacity="0.8"/>
                <path d="M 215 395 V 150 M 235 395 V 150 M 255 395 V 150 M 275 395 V 150 M 285 395 V 150" fill="none" stroke={colorHex} stroke-width="2" stroke-linecap="round" class="heatpipe-glow" filter="url(#glow)"/>

                <rect x="195" y="385" width="110" height="10" rx="2" fill="#c9d1d9" stroke="#8b949e" stroke-width="1.5" />

                <rect x="180" y="140" width="140" height="220" rx="4" fill="#090d13" stroke="white" stroke-opacity="0.5" stroke-width="2" />
                <rect x="182" y="142" width="136" height="216" fill="url(#fins)" />

                <g transform="translate(325, 150)">
                  <rect x="0" y="0" width="25" height="200" rx="3" fill="#161b22" stroke="#00ffff" stroke-opacity="0.6" stroke-width="1.5" />
                  <rect x="-5" y="80" width="10" height="40" fill="#0d1117" stroke="#30363d" />
                </g>

                <g class="wind-effect">
                  <path d="M 480 180 Q 250 185 80 180" fill="none" stroke="#00ffff" stroke-width="1.5" stroke-linecap="round" class="wind-line w1"/>
                  <path d="M 480 250 Q 250 245 80 250" fill="none" stroke="#00ffff" stroke-width="1.5" stroke-linecap="round" class="wind-line w2"/>
                  <path d="M 480 320 Q 250 325 80 320" fill="none" stroke="#00ffff" stroke-width="1.5" stroke-linecap="round" class="wind-line w3"/>
                </g>

                <text x="250" y="125" fill="white" font-family="Orbitron" font-size="14" text-anchor="middle" filter="url(#softGlow)">TORRE AIRE {cooler.heightMM || 155}mm</text>
              </g>
            )}

            {/* CPU IHS */}
            <g transform="translate(205, 395)">
              <rect x="-5" y="22" width="100" height="6" fill="#00ffff" opacity="0.2" />
              <path d="M 5 0 L 85 0 L 90 5 L 90 22 L 0 22 L 0 5 Z" fill="#090d13" stroke={colorHex} stroke-width="2" filter="url(#glow)"/>
              
              <rect x="15" y="-30" width="60" height="22" rx="11" fill="#050507" stroke={colorHex} stroke-opacity="0.3" stroke-width="1"/>
              <text x="45" y="-14" fill={colorHex} font-family="Orbitron" font-size="14" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{cpuTdp}W</text>
              
              <text x="45" y="16" fill="white" font-family="monospace" font-size="12" text-anchor="middle" font-weight="bold">CPU</text>
            </g>

            {/* BADGE CENTRAL */}
            <g transform="translate(370, 260)">
              <rect x="0" y="0" width="90" height="30" rx="15" fill="#0d1117" stroke={colorHex} stroke-width="2" filter="url(#glow)"/>
              <text x="45" y="20" fill={colorHex} font-family="monospace" font-size="12" font-weight="bold" text-anchor="middle">{margin > 0 ? `+${margin}W` : `${margin}W`}</text>
            </g>
          </svg>

          <style>
            @keyframes liquidHot {
              from { stroke-dashoffset: 90; }
              to { stroke-dashoffset: 0; }
            }
            @keyframes liquidCold {
              from { stroke-dashoffset: 0; }
              to { stroke-dashoffset: 90; }
            }
            .liquid-hot {
              stroke-dasharray: 20 10;
              animation: liquidHot 1.5s linear infinite;
            }
            .liquid-cold {
              stroke-dasharray: 20 10;
              animation: liquidCold 1.5s linear infinite;
            }

            @keyframes heatRise {
              from { stroke-dashoffset: 50; }
              to { stroke-dashoffset: 0; }
            }
            .heatpipe-glow {
              stroke-dasharray: 10 40;
              animation: heatRise 1.5s linear infinite;
            }

            @keyframes wind {
              0% { stroke-dashoffset: 500; opacity: 0; }
              10% { opacity: 0; }
              30% { opacity: 0.3; }
              70% { opacity: 0.3; }
              90% { opacity: 0; }
              100% { stroke-dashoffset: -100; opacity: 0; }
            }
            .wind-line {
              stroke-dasharray: 200 600;
              opacity: 0;
            }
            .w1 { animation: wind 2.5s cubic-bezier(0.4, 0, 0.2, 1) infinite 0s; }
            .w2 { animation: wind 3s cubic-bezier(0.4, 0, 0.2, 1) infinite 0.8s; }
            .w3 { animation: wind 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite 1.5s; }
          </style>
        </div>

        <!-- Panel lateral de estado y disponibilidad -->
        <div class="flex flex-col gap-4">
          
          <!-- TARJETA DE DIAGNÓSTICO -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${colorHex}`}></div>
            
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style={`background-color: ${colorHex}`}></span>
                <span class="relative inline-flex rounded-full h-3 w-3" style={`background-color: ${colorHex}`}></span>
              </span>
              <h2 class="font-orbitron font-bold tracking-widest text-sm uppercase" style={`color: ${colorHex}`}>
                {statusMessage}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">CAPACIDAD COOLER</span>
                <span class="font-orbitron font-bold text-2xl text-white">~{coolerCapacity} <small class="text-[0.5em] text-slate-400">W</small></span>
              </div>
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">MARGEN TÉRMICO</span>
                <span class="font-orbitron font-bold text-2xl" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin}` : margin} <small class="text-[0.5em]">W</small></span>
              </div>
            </div>
          </div>

          <!-- ESCÁNER DE DISPONIBILIDAD MULTI-TIENDA DINÁMICO CORREGIDO -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-2xl flex flex-col justify-between flex-1 animate-reveal" style="animation-delay: 0.22s;">
            <h3 class="font-orbitron text-xs tracking-[0.2em] text-slate-400 mb-4 uppercase">
              {currentLang === 'es' ? 'COMPROBAR HARDWARE:' : 'CHECK AVAILABILITY:'}
            </h3>

            <div class="space-y-3">
              {stores.map((store) => (
                <div 
                  class="relative bg-white/[0.02] border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10 overflow-hidden"
                >
                  <!-- TÍTULO EN BLANCO LISO -->
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-orbitron text-xs font-bold tracking-wider text-white uppercase">
                      {store.name}
                    </span>
                  </div>

                  <!-- BOTONES DE BÚSQUEDA PARA CPU Y COOLER -->
                  <div class="grid grid-cols-2 gap-3">
                    <a
                      href={store.buildUrl(cpuQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>CPU</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    <a
                      href={store.buildUrl(coolerQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>Disipador</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  </div>

                  <!-- LÍNEA INFERIOR EN DEGRADADO -->
                  <div 
                    class="absolute bottom-0 left-0 right-0 h-[2px]" 
                    style={`background: linear-gradient(90deg, transparent 0%, ${store.color} 50%, transparent 100%);`}
                  ></div>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Tabla de Métricas -->
      <h2 class="text-2xl font-bold font-orbitron mb-6 mt-12">Métricas y Compatibilidad Física</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] overflow-hidden mb-12 text-sm sm:text-base">
        <div class="grid grid-cols-4 px-6 py-4 border-b border-white/5 text-[10px] sm:text-xs font-orbitron text-[#00ffff] tracking-widest uppercase">
          <div>Parámetro</div>
          <div>Procesador</div>
          <div>Refrigeración</div>
          <div>Diagnóstico</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center">
          <div class="font-bold">Socket Placa Base</div>
          <div class="text-slate-300 font-mono">{cpu.socket}</div>
          <div class="text-slate-300 font-mono">Compatible {cpu.socket}</div>
          <div class="font-orbitron font-bold text-emerald-400">ANCLAJE OK</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center bg-white/[0.02]">
          <div class="font-bold">Disipación de Calor (TDP)</div>
          <div class="text-slate-300">{cpuTdp} W (Max Turbo)</div>
          <div class="text-slate-300">~{coolerCapacity} W</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{status === 'rojo' ? 'INSUFICIENTE' : 'ÓPTIMO'}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 items-center">
          <div class="font-bold">Holgura y Factor de Forma</div>
          <div class="text-slate-300">IHS Estándar</div>
          <div class="text-slate-300">
            {isAIO ? `Radiador ${cooler.radiatorSizeMM || 360}mm` : `Torre de ${cooler.heightMM || 155}mm`}
          </div>
          <div class="font-orbitron font-bold text-slate-300">Validar con Chasis</div>
        </div>
      </div>

      <!-- Análisis narrativo de ensamblaje con TEXTO SCROLLER -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold font-orbitron mb-4">¿Cómo evaluamos la compatibilidad térmica en LIDUNAX?</h2>
        
        <p class="lit mb-8" data-lit>
          {statementWords.map((word) => (<><span class="w">{word}</span>{' '}</>))}
        </p>

        <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] p-6 sm:p-8 text-slate-300 leading-relaxed">
          <p class="mb-6">
            Al combinar el procesador <strong class="text-white">{cpu.brand} {cpu.model}</strong> ({cpuTdp}W de calor bajo carga) con la solución térmica <strong class="text-[#00ffff]">{cooler.brand} {cooler.model}</strong>, obtenemos un balance neto de disipación térmica.
          </p>

          <div class="bg-[#111] border border-white/10 rounded-xl p-5 mb-6">
            <strong class="font-orbitron text-[11px] text-white tracking-widest uppercase mb-2 block">RIESGO DE THERMAL THROTTLING:</strong>
            <p class="text-sm">
              Si el margen térmico es negativo, la CPU alcanzará su temperatura límite (generalmente 90ºC - 100ºC) y reducirá automáticamente sus frecuencias de reloj para proteger el silicio, perdiendo rendimiento en tareas pesadas y juegos.
            </p>
          </div>

          <ul class="space-y-3 text-sm">
            {status === 'verde' && (
              <li class="flex items-start gap-2 text-emerald-400">
                <span>↳</span> <span class="text-slate-300"><strong class="text-emerald-400 font-normal">Sin pérdida de rendimiento:</strong> Tienes {margin}W de margen positivo. Los ventiladores no necesitarán girar al 100% de RPM, manteniendo una acústica silenciosa incluso en renderizados pesados.</span>
              </li>
            )}
            {status === 'amarillo' && (
              <li class="flex items-start gap-2 text-amber-400">
                <span>↳</span> <span class="text-slate-300"><strong class="text-amber-400 font-normal">Capacidad justa:</strong> El cooler puede manejar el calor, pero requerirá curvas de ventilación agresivas (mayor ruido de ventiladores) para no sobrepasar los límites en pruebas sintéticas o de estrés continuo.</span>
              </li>
            )}
            {status === 'rojo' && (
              <li class="flex items-start gap-2 text-rose-500">
                <span>↳</span> <span class="text-slate-300"><strong class="text-rose-500 font-normal">Refrigeración insuficiente:</strong> El disipador no puede evacuar los {cpuTdp}W de forma continuada. Experimentarás caídas severas de FPS (Throttling) en tareas exigentes prolongadas.</span>
              </li>
            )}
          </ul>
        </div>
      </section>

    </main>

    <Footer />

    <!-- Script de control de iluminación por Scroll -->
    <script>
      function initLit() {
        const el = document.querySelector('[data-lit]') as HTMLElement | null;
        if (!el || el.dataset.ready) return;
        el.dataset.ready = '1';
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const words = Array.from(el.querySelectorAll('.w')) as HTMLElement[];
        el.classList.add('armed');
        let ticking = false;
        let listening = false;
        const update = () => {
          ticking = false;
          if (!el.isConnected) return;
          const vh = window.innerHeight;
          const rect = el.getBoundingClientRect();
          const start = vh * 0.9; const end = vh * 0.35;
          const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height)));
          const lit = Math.round(progress * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        const startListening = () => {
          if (listening) return;
          listening = true;
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          onScroll();
        };
        const stopListening = () => {
          if (!listening) return;
          listening = false;
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        };
        const io = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) startListening();
          else stopListening();
        });
        io.observe(el);
      }

      document.addEventListener('astro:page-load', initLit);
      initLit();
    </script>

    <style>
      .lit {
        max-width: 38em;
        font-size: clamp(1.1rem, 2vw, 1.6rem);
        font-weight: 600;
        line-height: 1.4;
        color: #f5f5f7;
      }
      .lit.armed .w {
        color: rgba(245, 245, 247, 0.22);
        transition: color 0.35s ease;
      }
      .lit.armed .w.on {
        color: #f5f5f7;
      }
    </style>
  </body>
</html>