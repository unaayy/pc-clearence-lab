---
// src/pages/index.astro - Landing Page estilo SpaceX x Apple
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// Datos del selector (una sola fuente de verdad para las 4 opciones)
const secciones = [
{ href: '/gpu-caja',        img: '/gpu.png',    index: '01', tag: '01 // TELEMETRÍA', title: 'GPU + CAJA',          sub: 'Validar dimensiones y holguras exactas', disabled: false },
  { href: '/cpu-refrig',      img: '/cpu.png',    index: '02', tag: '02 // TÉRMICA',    title: 'CPU + REFRIGERACIÓN', sub: 'Sockets, alturas y despeje de memorias RAM', disabled: false },
  { href: '/fuente-psu',      img: '/fuente.png', index: '03', tag: '03 // ENERGÍA',    title: 'FUENTE / PSU',        sub: 'Vatios, conectores 12VHPWR y gestión de cables', disabled: false },
  { href: '/full-pc', img: '/pc.png', index: '04', tag: '04 // INTEGRAL', title: 'PC COMPLETO', sub: 'Escáner total de compatibilidad y ensamble' }
]
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LIDUNAX - Comprobador de Hardware y Compatibilidad Física</title>
    <link rel="icon" type="image/png" href="/logo2.png?v=5" />
    <meta name="description" content="Analizador dinámico de compatibilidad física para configuraciones de PC. Valida dimensiones de GPU, CPU, fuentes y chasis." />

    <!-- Carga directa e ininterrumpida de Orbitron de Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#050507] text-white min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-[#00ffff] selection:text-black">

    <!-- Canvas para partículas reactivas a la luz cenital -->
    <canvas id="dotsCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true"></canvas>

    <!-- Campana cenital estilo Ray Tracing -->
    <div class="spotlight-campana absolute top-0 left-1/2 -translate-x-1/2 w-[100vw] h-[620px] pointer-events-none z-0" aria-hidden="true"></div>

    <div class="page relative z-10 flex flex-col min-h-screen justify-between">

      <!-- Navbar de cristal -->
      <header class="nav sf">
        <div class="nav__in">
          <a href="/" class="brand flex items-center gap-3">
            <img src="/logoancho.png" alt="LDX" class="h-8 sm:h-10 w-auto object-contain" />
            <span class="brand__name orb">LIDUNAX</span>
          </a>
          <nav class="nav__links" aria-label="Principal">
            <a href="/" class="is-current" aria-current="page">Inicio</a>
            <a href="/faq">FAQ</a>
            <a href="/about">Sobre nosotros</a>
          </nav>
        </div>
      </header>

      <main class="main sf">

        <!-- HERO -->
        <section class="hero">
          <h1 class="h1 orb rise" style="--d:.05s">
            LIDUNAX
          </h1>
          <p class="hero__sub rise" style="--d:.2s">
            Selecciona los componentes que deseas analizar para tu próxima configuración.
          </p>
        </section>

        <!-- SELECTOR PREMIUM: paneles que se despliegan, con linterna de escaneo -->
        <section class="selector-section rise-soft" style="--d:.4s" aria-label="Selector de análisis">
          <div class="sel" data-selector role="group" aria-label="Elige qué quieres analizar">
            {secciones.map((s, i) => (
              <a
                href={s.href}
                class:list={['sel__panel', i === 0 && 'is-active']}
                aria-label={`${s.title}: ${s.sub}`}
              >
                <!-- Capa base: hardware apagado -->
                <div class="sel__layer sel__layer--base" aria-hidden="true">
                  <div class="sel__media"><img src={s.img} alt="" decoding="async" /></div>
                </div>
                <!-- Capa iluminada: solo se ve bajo el haz de luz del cursor -->
                <div class="sel__layer sel__layer--lit" aria-hidden="true">
                  <div class="sel__media"><img src={s.img} alt="" decoding="async" /></div>
                </div>

                <span class="sel__glow" aria-hidden="true"></span>
                <span class="sel__shade" aria-hidden="true"></span>
                <span class="sel__cross" aria-hidden="true"></span>
                <span class="sel__scan" aria-hidden="true"></span>
                <span class="sel__corner sel__corner--tl" aria-hidden="true"></span>
                <span class="sel__corner sel__corner--tr" aria-hidden="true"></span>
                <span class="sel__corner sel__corner--bl" aria-hidden="true"></span>
                <span class="sel__corner sel__corner--br" aria-hidden="true"></span>

                <!-- Estado plegado -->
                <span class="sel__index orb" aria-hidden="true">{s.index}</span>
                <span class="sel__rail orb" aria-hidden="true">{s.title}</span>

                <!-- Estado desplegado -->
                <div class="sel__body">
                  <span class="sel__tag orb">{s.tag}</span>
                  <h2 class="sel__title orb">{s.title}</h2>
                  <p class="sel__sub">{s.sub}</p>
                  <span class="sel__cta">
                    <span class="sel__cta-label orb">INICIAR ANÁLISIS</span>
                    <span class="sel__cta-icon">
                      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14M13 6l6 6-6 6" />
                      </svg>
                    </span>
                  </span>
                </div>
              </a>
            ))}
          </div>
        </section>

      </main>

      <!-- Footer global -->
      <Footer />

    </div>

    <!-- Script ejecutable para el canvas de partículas reactivas a la luz cenital -->
    <script>
      interface Dot {
        x: number;
        y: number;
        baseRadius: number;
        vx: number;
        vy: number;
        baseAlpha: number;
      }

      function initDots() {
        const canvas = document.getElementById('dotsCanvas') as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.ready) return;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D | null;
        if (!ctx) return;
        canvas.dataset.ready = '1';

        const speed = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1;
        let width = 0;
        let height = 0;

        const resize = () => {
          if (!canvas.isConnected) {
            window.removeEventListener('resize', resize);
            return;
          }
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth;
          height = window.innerHeight;
          canvas.width = Math.floor(width * dpr);
          canvas.height = Math.floor(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize();
        window.addEventListener('resize', resize);

        const dots: Dot[] = [];
        const numDots = Math.min(240, Math.floor((width * height) / 9000));
        for (let i = 0; i < numDots; i++) {
          dots.push({
            x: Math.random() * width,
            y: Math.random() * height,
            baseRadius: Math.random() * 1.3 + 0.4,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            baseAlpha: Math.random() * 0.35 + 0.15,
          });
        }

        const animate = () => {
          if (!canvas.isConnected) return;
          ctx.clearRect(0, 0, width, height);

          const lightX = width / 2;
          const lightY = -window.scrollY;
          const maxLight = Math.min(width, height) * 0.65;

          for (const dot of dots) {
            dot.x += dot.vx * speed;
            dot.y += dot.vy * speed;

            if (dot.x < 0) dot.x = width;
            if (dot.x > width) dot.x = 0;
            if (dot.y < 0) dot.y = height;
            if (dot.y > height) dot.y = 0;

            const distance = Math.hypot(dot.x - lightX, dot.y - lightY);
            ctx.beginPath();

            if (distance < maxLight) {
              const lightFactor = Math.pow(1 - distance / maxLight, 1.8);
              const radius = dot.baseRadius + lightFactor * 1.2;
              const alpha = Math.min(1, dot.baseAlpha + lightFactor * 0.65);

              ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);

              const r = Math.round(180 * (1 - lightFactor));
              const g = Math.round(180 * (1 - lightFactor) + 255 * lightFactor);
              const b = Math.round(190 * (1 - lightFactor) + 255 * lightFactor);
              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;

              if (lightFactor > 0.4) {
                ctx.shadowColor = 'rgba(0, 255, 255, 0.6)';
                ctx.shadowBlur = 6;
              } else {
                ctx.shadowBlur = 0;
              }
            } else {
              ctx.arc(dot.x, dot.y, dot.baseRadius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(180, 180, 190, ${dot.baseAlpha})`;
              ctx.shadowBlur = 0;
            }

            ctx.fill();
          }

          requestAnimationFrame(animate);
        };

        animate();
      }

      document.addEventListener('astro:page-load', initDots);
      initDots();
    </script>

    <!-- Script del selector: despliegue, linterna de escaneo y lanzamiento -->
    <script>
      function initSelector() {
        const root = document.querySelector<HTMLElement>('[data-selector]');
        if (!root || root.dataset.ready) return;
        root.dataset.ready = '1';

        const panels = Array.from(root.querySelectorAll<HTMLAnchorElement>('.sel__panel'));
        if (!panels.length) return;

        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const stacked = window.matchMedia('(max-width: 1024px)');
        const clamp = (v: number, min: number, max: number) => Math.min(max, Math.max(min, v));

        let lastPointer = 'mouse';
        let launching = false;

        const activate = (target: HTMLAnchorElement) => {
          if (launching) return;
          for (const p of panels) p.classList.toggle('is-active', p === target);
        };

        /* ── Apertura inicial: arranca plegado y despliega el primero ── */
        if (!reduce) {
          const first = panels.find((p) => p.classList.contains('is-active')) ?? panels[0];
          first.classList.remove('is-active');
          window.setTimeout(() => {
            if (!panels.some((p) => p.classList.contains('is-active'))) activate(first);
          }, 1000);
        }

        /* ── Estado de la luz por panel ── */
        const state = panels.map(() => ({ x: 0, y: 0, cx: 0, cy: 0, hot: false, seeded: false }));

        const seed = (i: number, r: DOMRect) => {
          const s = state[i];
          if (s.seeded) return;
          s.x = r.width * 0.5;
          s.y = r.height * 0.55;
          s.seeded = true;
        };

        panels.forEach((panel, i) => {
          const s = state[i];
          let intent = 0;

          panel.addEventListener('pointerenter', (e) => {
            lastPointer = e.pointerType;
            if (e.pointerType === 'touch') return;
            seed(i, panel.getBoundingClientRect());
            s.cx = e.clientX;
            s.cy = e.clientY;
            s.hot = true;
            panel.classList.add('is-hot');
            window.clearTimeout(intent);
            if (panel.classList.contains('is-active')) return;
            intent = window.setTimeout(() => activate(panel), 80);
          });

          panel.addEventListener('pointermove', (e) => {
            if (e.pointerType === 'touch') return;
            s.cx = e.clientX;
            s.cy = e.clientY;
          });

          panel.addEventListener('pointerleave', () => {
            window.clearTimeout(intent);
            s.hot = false;
            panel.classList.remove('is-hot');
          });
        });

        /* ── Bucle único: sigue al cursor o barre el hardware ── */
        let raf = 0;
        const tick = (t: number) => {
          if (!root.isConnected) return;
          panels.forEach((panel, i) => {
            const s = state[i];
            const idle = !reduce && panel.classList.contains('is-active');
            if (!s.hot && !idle) return;

            const r = panel.getBoundingClientRect();
            if (!r.width || !r.height) return;
            seed(i, r);

            let tx: number;
            let ty: number;
            if (s.hot) {
              tx = clamp(s.cx - r.left, 0, r.width);
              ty = clamp(s.cy - r.top, 0, r.height);
            } else {
              tx = r.width * (0.5 + 0.26 * Math.sin(t / 1900));
              ty = r.height * (0.52 + 0.2 * Math.sin(t / 1300 + 1.2));
            }

            const k = reduce ? 1 : s.hot ? 0.2 : 0.06;
            s.x += (tx - s.x) * k;
            s.y += (ty - s.y) * k;

            panel.style.setProperty('--mx', `${s.x.toFixed(1)}px`);
            panel.style.setProperty('--my', `${s.y.toFixed(1)}px`);
            panel.style.setProperty('--px', (s.x / r.width).toFixed(3));
            panel.style.setProperty('--py', (s.y / r.height).toFixed(3));
          });
          raf = requestAnimationFrame(tick);
        };

        const io = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            if (!raf) raf = requestAnimationFrame(tick);
          } else {
            cancelAnimationFrame(raf);
            raf = 0;
          }
        });
        io.observe(root);

        /* ── Teclado y foco ── */
        root.addEventListener('focusin', (e) => {
          const p = (e.target as Element).closest<HTMLAnchorElement>('.sel__panel');
          if (p && p.matches(':focus-visible')) activate(p);
        });

        root.addEventListener('keydown', (e) => {
          const i = panels.indexOf(document.activeElement as HTMLAnchorElement);
          if (i < 0) return;
          const next = e.key === 'ArrowRight' || (stacked.matches && e.key === 'ArrowDown');
          const prev = e.key === 'ArrowLeft' || (stacked.matches && e.key === 'ArrowUp');
          let n = i;
          if (next) n = (i + 1) % panels.length;
          else if (prev) n = (i - 1 + panels.length) % panels.length;
          else if (e.key === 'Home') n = 0;
          else if (e.key === 'End') n = panels.length - 1;
          else return;
          e.preventDefault();
          panels[n].focus();
          activate(panels[n]);
        });

        /* ── Táctil: 1er toque despliega, 2º toque entra ── */
        root.addEventListener('pointerdown', (e) => {
          lastPointer = e.pointerType;
        }, true);

        /* ── Lanzamiento ── */
        root.addEventListener('click', (e) => {
          const link = (e.target as Element).closest<HTMLAnchorElement>('.sel__panel');
          if (!link || launching) return;

          // Si el panel está deshabilitado, anulamos cualquier navegación
          if (link.classList.contains('is-disabled')) {
            e.preventDefault();
            activate(link);
            return;
          }

          if (!link.classList.contains('is-active') && lastPointer !== 'mouse') {
            e.preventDefault();
            activate(link);
            return;
          }

          if (e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (reduce) return;

          e.preventDefault();
          launching = true;
          root.classList.add('is-launching');
          link.classList.add('is-launching');
          window.setTimeout(() => window.location.assign(link.href), 380);
        });

        window.addEventListener('pageshow', (e) => {
          if (!e.persisted) return;
          launching = false;
          root.classList.remove('is-launching');
          panels.forEach((p) => p.classList.remove('is-launching'));
        });
      }

      document.addEventListener('astro:page-load', initSelector);
      initSelector();
    </script>

    <style>
      /* ───────── Tokens ───────── */
      .page {
        --cyan: #00ffff;
        --ink: #f5f5f7;
        --steel: #86868b;
        --line: rgba(255, 255, 255, 0.08);
      }

      /* Tipografías */
      .sf,
      .sf * {
        font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif !important;
      }
      .orb,
      .sf .orb,
      .sf .orb * {
        font-family: 'Orbitron', sans-serif !important;
      }

      .spotlight-campana {
        background: radial-gradient(
          ellipse 80% 50% at 50% 0%,
          rgba(0, 255, 255, 0.12) 0%,
          rgba(0, 255, 255, 0.03) 40%,
          rgba(0, 255, 255, 0.008) 70%,
          transparent 100%
        );
        filter: blur(60px);
      }

      a:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 4px;
        border-radius: 8px;
      }

      /* ───────── Navbar ───────── */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: rgba(5, 5, 7, 0.55);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        backdrop-filter: saturate(180%) blur(20px);
      }
      .nav__in {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 24px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .brand__name {
        font-size: 1.05rem;
        font-weight: 700;
        letter-spacing: 0.18em;
        color: #fff;
      }
      .nav__links {
        display: flex;
        gap: 32px;
        font-size: 14px;
        color: var(--steel);
      }
      .nav__links a {
        transition: color 0.25s;
      }
      .nav__links a:hover,
      .nav__links a.is-current {
        color: #fff;
      }
      @media (max-width: 560px) {
        .brand__name {
          display: none;
        }
        .nav__links {
          gap: 20px;
          font-size: 13px;
        }
      }

      /* ───────── Layout ───────── */
      .main {
        flex: 1;
        width: 100%;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px clamp(64px, 8vw, 120px);
      }

      /* ───────── Entrada animada ───────── */
      .rise {
        opacity: 0;
        animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards;
      }
      .rise-soft {
        opacity: 0;
        animation: rise-soft 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards;
      }
      @keyframes rise {
        from {
          opacity: 0;
          transform: translateY(16px);
          filter: blur(8px);
        }
        to {
          opacity: 1;
          transform: none;
          filter: none;
        }
      }
      @keyframes rise-soft {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }

      /* ───────── Hero ───────── */
      .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-top: clamp(48px, 9vh, 96px);
      }
      .h1 {
        font-size: clamp(2.5rem, 8vw, 5.5rem);
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        background: linear-gradient(180deg, #ffffff 30%, #8e8e93 115%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
      }
      .hero__sub {
        margin-top: 18px;
        max-width: 32rem;
        font-size: clamp(0.95rem, 1.5vw, 1.125rem);
        line-height: 1.6;
        color: var(--steel);
        text-wrap: balance;
      }

      /* ───────── Selector premium ───────── */
      .selector-section {
        margin-top: clamp(48px, 7vw, 80px);
      }
      .sel {
        --ease: cubic-bezier(0.22, 0.9, 0.2, 1);
        display: flex;
        gap: 12px;
        height: clamp(400px, calc(100vh - 430px), 540px);
        height: clamp(400px, calc(100svh - 430px), 540px);
      }

      .sel__panel {
        --r: 28px;
        --pad: 32px;
        --media-w: 680px;
        --par: 18px;
        --mx: 50%;
        --my: 55%;
        --px: 0.5;
        --py: 0.5;
        position: relative;
        flex: 1 1 0;
        min-width: 0;
        min-height: 0;
        isolation: isolate;
        overflow: hidden;
        border-radius: var(--r);
        text-decoration: none;
        -webkit-tap-highlight-color: transparent;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.015) 40%, rgba(0, 0, 0, 0.75));
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 24px 60px rgba(0, 0, 0, 0.7), inset 0 1px 1px rgba(255, 255, 255, 0.15);
        -webkit-backdrop-filter: blur(24px);
        backdrop-filter: blur(24px);
        transition: flex-grow 0.9s var(--ease), border-color 0.6s, box-shadow 0.6s, opacity 0.35s, filter 0.35s;
      }
      .sel__panel.is-active {
        flex-grow: 3.4;
        border-color: rgba(0, 255, 255, 0.4);
        box-shadow: 0 30px 90px rgba(0, 255, 255, 0.15), inset 0 1.5px 1px rgba(0, 255, 255, 0.5);
      }
      
      /* Estilos para estado Deshabilitado (Próximamente) */
      .sel__panel.is-disabled {
        cursor: not-allowed;
      }
      .sel__panel.is-disabled.is-active {
        border-color: rgba(255, 255, 255, 0.2);
        box-shadow: 0 30px 90px rgba(0, 0, 0, 0.5), inset 0 1.5px 1px rgba(255, 255, 255, 0.2);
      }
      .sel__panel.is-disabled .sel__cta-icon {
        background: rgba(255, 255, 255, 0.1);
        color: rgba(255, 255, 255, 0.5);
        box-shadow: none;
      }
      .sel__panel.is-disabled:hover .sel__cta-icon {
        transform: none;
        box-shadow: none;
      }
      .sel__panel.is-disabled .sel__tag {
        color: rgba(255, 255, 255, 0.5);
      }

      .sel__panel:focus-visible {
        outline: 2px solid var(--cyan);
        outline-offset: 4px;
        border-radius: var(--r);
      }
      .sel__panel::before {
        content: '';
        position: absolute;
        top: 0;
        left: 20%;
        width: 60%;
        height: 1px;
        z-index: 7;
        pointer-events: none;
        background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.4), transparent);
        opacity: 0.4;
        transition: opacity 0.6s, width 0.6s, left 0.6s;
      }
      .sel__panel.is-active::before {
        opacity: 1;
        left: 0;
        width: 100%;
      }

      .sel__layer {
        position: absolute;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        mix-blend-mode: screen;
      }
      .sel__media {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 50%;
        width: var(--media-w);
        transform: translate3d(
          calc(-50% + (var(--px) - 0.5) * var(--par) * -1),
          calc((var(--py) - 0.5) * var(--par) * -1),
          0
        );
      }
      .sel__media img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center;
        transform: scale(1.12);
        transition: transform 1.2s var(--ease), opacity 0.8s;
      }
      .sel__layer--base img {
        opacity: 0.28;
        filter: grayscale(100%) brightness(1.5) contrast(200%);
      }
      .sel__panel.is-active .sel__layer--base img {
        opacity: 0.4;
        transform: scale(1.02);
      }

      .sel__layer--lit {
        opacity: 0;
        transition: opacity 0.7s;
        -webkit-mask-image: radial-gradient(circle 250px at var(--mx) var(--my), #000 0%, rgba(0, 0, 0, 0.6) 50%, transparent 100%);
        mask-image: radial-gradient(circle 250px at var(--mx) var(--my), #000 0%, rgba(0, 0, 0, 0.6) 50%, transparent 100%);
      }
      .sel__layer--lit img {
        filter: grayscale(100%) contrast(1.8) brightness(2.1) sepia(1) hue-rotate(135deg) saturate(6);
      }
      .sel__layer--lit::after {
        content: '';
        position: absolute;
        inset: 0;
        background-image:
          linear-gradient(rgba(0, 255, 255, 0.18) 1px, transparent 1px),
          linear-gradient(90deg, rgba(0, 255, 255, 0.18) 1px, transparent 1px);
        background-size: 26px 26px;
      }
      .sel__panel.is-active .sel__layer--lit {
        opacity: 0.6;
      }
      .sel__panel.is-hot .sel__layer--lit {
        opacity: 1;
      }
      .sel__panel.is-active .sel__layer--lit img {
        transform: scale(1.02);
      }

      .sel__glow,
      .sel__cross {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.6s;
      }
      .sel__glow {
        background: radial-gradient(circle 260px at var(--mx) var(--my), rgba(0, 255, 255, 0.2), transparent 70%);
      }
      .sel__cross::before,
      .sel__cross::after {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
      }
      .sel__cross::before {
        bottom: 0;
        width: 1px;
        background: linear-gradient(180deg, transparent, rgba(0, 255, 255, 0.28), transparent);
        transform: translateX(var(--mx));
      }
      .sel__cross::after {
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, rgba(0, 255, 255, 0.28), transparent);
        transform: translateY(var(--my));
      }
      .sel__panel.is-hot .sel__glow,
      .sel__panel.is-hot .sel__cross {
        opacity: 1;
      }
      .sel__shade {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: linear-gradient(180deg, transparent 30%, rgba(5, 5, 7, 0.55) 68%, rgba(5, 5, 7, 0.94) 100%);
      }

      .sel__scan {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        pointer-events: none;
        opacity: 0;
        background: linear-gradient(90deg, transparent, var(--cyan), transparent);
        box-shadow: 0 0 18px 2px rgba(0, 255, 255, 0.55);
      }
      .sel__panel.is-active .sel__scan {
        animation: sel-scan 1.1s cubic-bezier(0.4, 0, 0.2, 1) 0.05s 1 both;
      }
      @keyframes sel-scan {
        0% { top: 0; opacity: 0; }
        12% { opacity: 1; }
        88% { opacity: 0.8; }
        100% { top: 100%; opacity: 0; }
      }
      .sel__flash {
        position: absolute;
        inset: 0;
        pointer-events: none;
        opacity: 0;
        background: radial-gradient(circle at var(--mx) var(--my), rgba(0, 255, 255, 0.6), rgba(0, 255, 255, 0) 65%);
      }
      .sel__panel.is-launching .sel__flash {
        animation: sel-flash 0.4s ease-out both;
      }
      @keyframes sel-flash {
        0% { opacity: 0; }
        35% { opacity: 1; }
        100% { opacity: 0.35; }
      }
      .sel.is-launching .sel__panel {
        pointer-events: none;
      }
      .sel.is-launching .sel__panel:not(.is-launching) {
        opacity: 0.25;
        filter: saturate(0);
      }

      .sel__corner {
        position: absolute;
        width: 16px;
        height: 16px;
        pointer-events: none;
        opacity: 0;
        border: 0 solid var(--cyan);
        transition: opacity 0.5s 0.15s, transform 0.7s var(--ease) 0.15s;
      }
      .sel__corner--tl { top: 16px; left: 16px; border-top-width: 1.5px; border-left-width: 1.5px; border-top-left-radius: 5px; transform: translate(14px, 14px); }
      .sel__corner--tr { top: 16px; right: 16px; border-top-width: 1.5px; border-right-width: 1.5px; border-top-right-radius: 5px; transform: translate(-14px, 14px); }
      .sel__corner--bl { bottom: 16px; left: 16px; border-bottom-width: 1.5px; border-left-width: 1.5px; border-bottom-left-radius: 5px; transform: translate(14px, -14px); }
      .sel__corner--br { bottom: 16px; right: 16px; border-bottom-width: 1.5px; border-right-width: 1.5px; border-bottom-right-radius: 5px; transform: translate(-14px, -14px); }
      .sel__panel.is-active .sel__corner {
        opacity: 0.9;
        transform: none;
      }

      .sel__index {
        position: absolute;
        top: var(--pad);
        left: var(--pad);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: var(--cyan);
        opacity: 0.85;
        transition: opacity 0.35s 0.1s;
      }
      .sel__rail {
        position: absolute;
        left: var(--pad);
        bottom: var(--pad);
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        white-space: nowrap;
        font-size: clamp(0.72rem, 0.95vw, 0.86rem);
        font-weight: 600;
        letter-spacing: 0.16em;
        color: rgba(255, 255, 255, 0.78);
        transition: opacity 0.35s 0.1s;
      }
      .sel__panel.is-active .sel__index,
      .sel__panel.is-active .sel__rail {
        opacity: 0;
        transition-delay: 0s;
      }

      .sel__body {
        position: absolute;
        left: var(--pad);
        bottom: var(--pad);
        width: 380px;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        pointer-events: none;
      }
      .sel__body > * {
        opacity: 0;
        transform: translateY(14px);
        transition: opacity 0.25s ease, transform 0.25s ease;
      }
      .sel__body > :nth-child(1) { --i: 0; }
      .sel__body > :nth-child(2) { --i: 1; }
      .sel__body > :nth-child(3) { --i: 2; }
      .sel__body > :nth-child(4) { --i: 3; }
      .sel__panel.is-active .sel__body > * {
        opacity: 1;
        transform: none;
        transition:
          opacity 0.6s ease calc(0.3s + var(--i) * 0.07s),
          transform 0.8s var(--ease) calc(0.3s + var(--i) * 0.07s);
      }
      .sel__tag {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.1em;
        color: rgba(0, 255, 255, 0.85);
      }
      .sel__title {
        font-size: clamp(1.35rem, 2vw, 1.75rem);
        font-weight: 700;
        line-height: 1.15;
        letter-spacing: 0.02em;
        color: #fff;
        text-wrap: balance;
      }
      .sel__sub {
        max-width: 30ch;
        font-size: 0.875rem;
        line-height: 1.45;
        color: rgba(255, 255, 255, 0.78);
      }
      .sel__cta {
        margin-top: 14px;
        display: inline-flex;
        align-items: center;
        gap: 14px;
      }
      .sel__cta-label {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.14em;
        color: #fff;
      }
      .sel__cta-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        color: #04141a;
        background: var(--cyan);
        box-shadow: 0 0 28px rgba(0, 255, 255, 0.45);
        transition: transform 0.4s var(--ease), box-shadow 0.4s;
      }
      .sel__panel:not(.is-disabled):hover .sel__cta-icon,
      .sel__panel:not(.is-disabled):focus-visible .sel__cta-icon {
        transform: translateX(4px);
        box-shadow: 0 0 40px rgba(0, 255, 255, 0.7);
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .sel {
          flex-direction: column;
          gap: 10px;
          height: clamp(540px, 82vh, 680px);
          height: clamp(540px, 82svh, 680px);
        }
        .sel__panel {
          --r: 22px;
          --pad: 22px;
          --par: 12px;
        }
        .sel__panel.is-active {
          flex-grow: 4;
        }
        .sel__media {
          top: 50%;
          bottom: auto;
          left: 0;
          width: 100%;
          height: 360px;
          transform: translate3d(
            calc((var(--px) - 0.5) * var(--par) * -1),
            calc(-50% + (var(--py) - 0.5) * var(--par) * -1),
            0
          );
        }
        .sel__corner { width: 12px; height: 12px; }
        .sel__corner--tl { top: 10px; left: 10px; }
        .sel__corner--tr { top: 10px; right: 10px; }
        .sel__corner--bl { bottom: 10px; left: 10px; }
        .sel__corner--br { bottom: 10px; right: 10px; }
        .sel__index {
          top: 50%;
          margin-top: -0.6em;
        }
        .sel__rail {
          top: 50%;
          bottom: auto;
          left: calc(var(--pad) + 36px);
          margin-top: -0.6em;
          writing-mode: horizontal-tb;
          transform: none;
          font-size: 0.85rem;
        }
        .sel__body {
          width: calc(100% - var(--pad) * 2);
          max-width: 420px;
        }
        .sel__title {
          font-size: clamp(1.2rem, 4.6vw, 1.5rem);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .rise,
        .rise-soft {
          animation: none !important;
          transition: none !important;
          opacity: 1 !important;
          transform: none !important;
        }
        .sel__panel {
          --par: 0px;
        }
        .sel__panel,
        .sel__panel::before,
        .sel__media img,
        .sel__layer--lit,
        .sel__glow,
        .sel__cross,
        .sel__corner,
        .sel__index,
        .sel__rail,
        .sel__body > *,
        .sel__cta-icon {
          transition-duration: 0.01s !important;
          transition-delay: 0s !important;
        }
        .sel__scan,
        .sel__flash {
          animation: none !important;
        }
      }
    </style>

  </body>
