---
import casesData from '../data/cases.json';
import gpusData from '../data/gpus.json';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 1. GENERADOR DE RUTAS (pSEO)
export async function getStaticPaths() {
  const cases = casesData && casesData.length > 0 ? casesData.slice(0, 50) : [];
  const gpus = gpusData && gpusData.length > 0 ? gpusData.slice(0, 50) : [];

  const paths = [];
  for (const pcCase of cases) {
    for (const gpu of gpus) {
      paths.push({
        params: { caseSlug: pcCase.slug, gpuSlug: gpu.slug },
        props: { pcCase, gpu }
      });
    }
  }
  return paths;
}

// 2. RECUPERAR DATOS DE LA COMBINACIÓN ACTUAL
const { pcCase, gpu } = Astro.props;

if (!pcCase || !gpu) {
  return Astro.redirect('/404');
}

// 3. CÁLCULOS Y ESTADOS (Intactos)
const caseMaxLength = pcCase.maxGpuLengthMM || pcCase.maxGpuLength || 350;
const gpuLength = gpu.dimensions?.lengthMM || gpu.length || gpu.lengthMM || 300;

const margin = caseMaxLength - gpuLength;

let status = 'verde';
let colorHex = '#10b981';
let statusText = 'COMPATIBILIDAD ÓPTIMA';
let statusMessage = 'HOLGURA CONFIRMADA';

if (margin < 0) {
  status = 'rojo';
  colorHex = '#f43f5e';
  statusText = 'INCOMPATIBILIDAD FÍSICA';
  statusMessage = 'COLISIÓN FRONTAL INMINENTE';
} else if (margin <= 15) {
  status = 'amarillo';
  colorHex = '#fbbf24';
  statusText = 'COMPATIBILIDAD AJUSTADA';
  statusMessage = 'ESPACIO EXTREMADAMENTE REDUCIDO';
}

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');

---
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Entra la {gpu.brand} {gpu.model} en la caja {pcCase.brand} {pcCase.model}? - LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.png?v=5" />
    <meta name="description" content={`Comprueba la compatibilidad física: La gráfica ${gpu.model} mide ${gpuLength}mm. Descubre si cabe en el chasis ${pcCase.model} (máximo ${caseMaxLength}mm).`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen font-sans selection:bg-[#00ffff] selection:text-black">
    
    <!-- Animaciones Globales Refinadas -->
    <style is:global>
      :root {
        /* Curvas de easing propias — mismo lenguaje de movimiento que Apple/SpaceX:
           aceleraciones suaves, sin rebotes, sin linealidad mecánica. */
        --ease-elegant: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
        --ease-fluid: cubic-bezier(0.22, 1, 0.36, 1);
      }

      /* Cableado — flujo constante de energía, sedoso en vez de nervioso */
      @keyframes dashFlow {
        from { stroke-dashoffset: 0; }
        to { stroke-dashoffset: -36; }
      }
      .animate-cable {
        animation: dashFlow 1.7s linear infinite;
      }

      /* Respiración del margen — pulso suave, no parpadeo */
      @keyframes pulseGlow {
        0%, 100% { opacity: 0.9; }
        50% { opacity: 0.45; }
      }
      .animate-glow {
        animation: pulseGlow 3.4s var(--ease-breathe) infinite;
      }

      /* Halo ambiental del chasis — vida sutil en el contorno */
      @keyframes ambientPulse {
        0%, 100% { opacity: 0.95; }
        50% { opacity: 0.6; }
      }
      .animate-ambient {
        animation: ambientPulse 5.2s var(--ease-breathe) infinite;
      }

      /* Ventiladores — rotación constante y realista */
      @keyframes fanSpin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
      }
      .fan-spin {
        animation: fanSpin 4s linear infinite;
      }

      /* Flujo de aire — estelas continuas tipo fibra óptica, sin cortes bruscos */
      @keyframes breeze {
        0% { transform: translateX(0) scaleX(0.85); opacity: 0; }
        18% { opacity: 0.55; }
        55% { opacity: 0.3; }
        100% { transform: translateX(-260px) scaleX(1.05); opacity: 0; }
      }
      .animate-breeze {
        animation: breeze 5.5s var(--ease-fluid) infinite;
      }

      /* Micro-convección térmica bajo la GPU — curva orgánica, sin tirones */
      @keyframes whirlwind {
        0% { transform: translateY(0) scale(0.92); opacity: 0; }
        30% { opacity: 0.32; }
        70% { opacity: 0.12; }
        100% { transform: translateY(32px) scale(1.15); opacity: 0; }
      }
      .animate-whirlwind {
        animation: whirlwind 3.6s var(--ease-fluid) infinite;
      }

      /* Indicador de estado — pulso lento tipo "system light", no ping abrupto */
      @keyframes statusBreathe {
        0% { transform: scale(1); opacity: 0.55; }
        100% { transform: scale(1.9); opacity: 0; }
      }
      .animate-status-pulse {
        animation: statusBreathe 2.6s var(--ease-breathe) infinite;
      }

      /* Aparición del render — materialización elegante al cargar */
      @keyframes materialize {
        from { opacity: 0; transform: scale(0.97); }
        to { opacity: 1; transform: scale(1); }
      }
      .animate-materialize {
        animation: materialize 1.1s var(--ease-elegant) both;
        animation-delay: 0.1s;
        transform-origin: center;
      }

      /* Entrada de paneles — fade + rise + blur-out, estilo keynote */
      @keyframes revealFade {
        from { opacity: 0; transform: translateY(14px); filter: blur(6px); }
        to { opacity: 1; transform: translateY(0); filter: blur(0); }
      }
      .animate-reveal {
        animation: revealFade 0.9s var(--ease-elegant) both;
      }

      @media (prefers-reduced-motion: reduce) {
        .animate-cable, .animate-glow, .animate-ambient, .fan-spin,
        .animate-breeze, .animate-whirlwind, .animate-status-pulse,
        .animate-reveal, .animate-materialize {
          animation: none !important;
        }
      }
    </style>

    <!-- Navbar -->
    <header class="border-b border-white/10 bg-black/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logoancho.png" alt="LDX" class="h-8 w-auto object-contain" />
          <span class="font-orbitron font-bold tracking-widest hidden sm:block">LIDUNAX</span>
        </a>
        <nav class="flex gap-6 text-sm font-orbitron tracking-wider text-slate-400">
          <a href="/" class="hover:text-[#00ffff] transition-colors">← VOLVER AL BUSCADOR</a>
        </nav>
      </div>
    </header>

    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12">
      
      <!-- ENCABEZADO -->
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-bold font-orbitron mb-3 uppercase tracking-wide">
          <span class="text-slate-400 block text-lg mb-1">Informe de Compatibilidad Dimensional</span>
          {pcCase.brand} {pcCase.model}
        </h1>
        <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
          Analizando el despeje volumétrico al instalar la tarjeta gráfica <strong class="text-white">{gpu.brand} {gpu.model}</strong>.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 mb-12">
        
        <!-- DIAGRAMA VISUAL -->
        <div class="relative bg-[#0a0a0c] border border-white/5 rounded-[24px] overflow-hidden min-h-[460px] flex items-center justify-center p-4 sm:p-8 shadow-[inset_0_0_80px_rgba(0,0,0,0.8)] animate-reveal">
          <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          
          <svg viewBox="0 0 500 400" class="w-full max-w-[500px] relative z-10 drop-shadow-[0_0_15px_rgba(0,0,0,0.5)] animate-materialize">
            <defs>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="softGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="1.4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <linearGradient id="windGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00ffff" stop-opacity="0" />
                <stop offset="50%" stop-color="#00ffff" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#00ffff" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="heatGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color={colorHex} stop-opacity="0.85" />
                <stop offset="100%" stop-color={colorHex} stop-opacity="0" />
              </linearGradient>
              <pattern id="dotPattern" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="3" height="3" fill="white" opacity="0.3"/>
              </pattern>
            </defs>

            <g transform="translate(50, 40)">
              <!-- CHASIS Y ESTRUCTURA -->
              <path class="animate-ambient" d="M 20 0 L 380 0 L 400 20 L 400 280 L 380 300 L 20 300 L 0 280 L 0 20 Z" fill="none" stroke={colorHex} stroke-width="3" filter="url(#glow)"/>
              <path d="M 25 10 L 375 10 L 390 25 L 390 275 L 375 290 L 25 290 L 10 275 L 10 25 Z" fill="none" stroke={colorHex} stroke-width="1" opacity="0.4"/>
              
              <path d="M 40 300 L 60 320 L 100 320 L 100 300 Z" fill="#111" stroke={colorHex} stroke-width="1.5" />
              <path d="M 300 300 L 300 320 L 340 320 L 360 300 Z" fill="#111" stroke={colorHex} stroke-width="1.5" />
              <rect x="382" y="40" width="10" height="220" fill="none" stroke={colorHex} stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
              
              <rect x="25" y="30" width="220" height="190" rx="4" fill="none" stroke="white" stroke-width="1" stroke-opacity="0.15"/>
              <text x="35" y="50" fill="#555" font-family="Orbitron" font-size="10" letter-spacing="1">MOTHERBOARD ATX</text>

              <!-- VENTILADORES FRONTALES -->
              <g opacity="0.5">
                <g class="fan-spin" style="transform-origin: 366px 80px; animation-duration: 4s;">
                  <circle cx="366" cy="80" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 64 L 366 96 M 350 80 L 382 80 M 355 69 L 377 91 M 355 91 L 377 69" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
                <g class="fan-spin" style="transform-origin: 366px 145px; animation-duration: 4.6s;">
                  <circle cx="366" cy="145" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 129 L 366 161 M 350 145 L 382 145 M 355 134 L 377 156 M 355 156 L 377 134" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
                <g class="fan-spin" style="transform-origin: 366px 210px; animation-duration: 4.3s;">
                  <circle cx="366" cy="210" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 194 L 366 226 M 350 210 L 382 210 M 355 199 L 377 221 M 355 221 L 377 199" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
              </g>

              <!-- ESTELAS DE VIENTO HORIZONTALES (Hacia atrás) -->
              <g stroke="url(#windGradient)" stroke-width="1.3" fill="none" stroke-linecap="round" filter="url(#softGlow)">
                <!-- Viento superior -->
                <path d="M 340 80 Q 250 82 150 75" class="animate-breeze" style="animation-delay: 0s;" opacity="0"/>
                <!-- Viento medio -->
                <path d="M 340 145 Q 250 145 150 145" class="animate-breeze" style="animation-delay: 1.5s;" opacity="0"/>
                <!-- Viento inferior -->
                <path d="M 340 210 Q 250 208 150 215" class="animate-breeze" style="animation-delay: 3s;" opacity="0"/>
                <!-- Capas extra para dar sensación de flujo constante -->
                <path d="M 340 110 Q 250 110 150 110" class="animate-breeze" style="animation-delay: 0.8s;" opacity="0"/>
                <path d="M 340 175 Q 250 175 150 175" class="animate-breeze" style="animation-delay: 2.2s;" opacity="0"/>
              </g>

              <!-- TARJETA GRÁFICA (GPU) -->
              {(() => {
                const maxGpuWidthSvg = 325; 
                const gpuWidthSvg = Math.min((gpuLength / caseMaxLength) * maxGpuWidthSvg, maxGpuWidthSvg);
                
                // Calculamos cuántos mini-torbellinos caben bajo la GPU
                const whirlwinds = Array.from({ length: Math.floor(gpuWidthSvg / 50) });

                return (
                  <g transform="translate(15, 170)">
                    
                    <!-- Cables -->
                    <path d={`M ${gpuWidthSvg - 45} 0 C ${gpuWidthSvg - 30} -40, ${gpuWidthSvg + 20} 50, ${gpuWidthSvg + 10} 120`} fill="none" stroke={colorHex} stroke-width="3" stroke-dasharray="10 8" class="animate-cable" filter="url(#glow)"/>
                    <path d={`M ${gpuWidthSvg - 35} 0 C ${gpuWidthSvg - 20} -40, ${gpuWidthSvg + 30} 50, ${gpuWidthSvg + 20} 120`} fill="none" stroke={colorHex} stroke-width="3" stroke-dasharray="10 8" class="animate-cable" filter="url(#glow)"/>
                    
                    <rect x={gpuWidthSvg - 50} y="-12" width="22" height="12" rx="2" fill="#111" stroke={colorHex} stroke-width="1.5"/>

                    <rect x="0" y="0" width={gpuWidthSvg} height="40" rx="4" fill="#0d1117" stroke={colorHex} stroke-width="2" filter="url(#glow)"/>
                    <rect x="15" y="10" width={gpuWidthSvg - 30} height="20" fill="url(#dotPattern)" />
                    
                    <rect x={(gpuWidthSvg / 2) - 110} y="10" width="220" height="20" fill="#0d1117" rx="2" />
                    <text x={gpuWidthSvg / 2} y="24" fill="white" font-family="Orbitron" font-size="11" font-weight="bold" text-anchor="middle" letter-spacing="0.5">{gpu.brand} {gpu.model}</text>

                    <!-- MINI TORBELLINOS DE CALOR HACIA ABAJO -->
                    <g stroke="url(#heatGradient)" stroke-width="1.3" fill="none" stroke-linecap="round">
                      {whirlwinds.map((_, i) => {
                        const startX = 25 + i * 50;
                        const delay = i * 0.6; // Desfase para que no bajen todos a la vez
                        return (
                          /* Curva de Bezier para simular un vórtice de aire bajando */
                          <path 
                            d={`M ${startX} 42 C ${startX - 15} 55, ${startX + 15} 65, ${startX - 5} 78`} 
                            class="animate-whirlwind" 
                            style={`animation-delay: ${delay}s;`} 
                            opacity="0"
                          />
                        );
                      })}
                    </g>

                    <!-- ETIQUETA DEL MARGEN -->
                    <g transform={`translate(${gpuWidthSvg + 15}, 0)`}>
                      <line x1="0" y1="20" x2="35" y2="20" stroke={colorHex} stroke-width="1.5" stroke-dasharray="4 4" class="animate-glow"/>
                      <rect x="15" y="5" width="60" height="26" rx="13" fill="#0d1117" stroke={colorHex} stroke-width="1.5" filter="url(#glow)"/>
                      <text x="45" y="22" fill={colorHex} font-family="Orbitron" font-size="11" font-weight="bold" text-anchor="middle">{margin > 0 ? `+${margin}mm` : `${margin}mm`}</text>
                    </g>
                  </g>
                );
              })()}
            </g>
          </svg>
        </div>

        <!-- PANEL LATERAL: DIAGNÓSTICO Y ESCÁNER DE TIENDAS -->
        <div class="flex flex-col gap-4">
          
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-xl relative overflow-hidden animate-reveal" style="animation-delay: 0.12s;">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${colorHex}`}></div>
            
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-status-pulse absolute inline-flex h-full w-full rounded-full" style={`background-color: ${colorHex}`}></span>
                <span class="relative inline-flex rounded-full h-3 w-3" style={`background-color: ${colorHex}`}></span>
              </span>
              <h2 class="font-orbitron font-bold tracking-widest text-sm uppercase" style={`color: ${colorHex}`}>
                {statusText}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">LONGITUD MÁXIMA</span>
                <span class="font-orbitron font-bold text-2xl text-white">{caseMaxLength} <small class="text-[0.5em] text-slate-400">mm</small></span>
              </div>
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">MARGEN TOTAL</span>
                <span class="font-orbitron font-bold text-2xl" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin}` : margin} <small class="text-[0.5em]">mm</small></span>
              </div>
            </div>
          </div>

          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-2xl flex flex-col justify-between flex-1 animate-reveal" style="animation-delay: 0.22s;">
            <h3 class="font-orbitron text-xs tracking-[0.2em] text-slate-400 mb-4 uppercase">
              ESCÁNER DE DISPONIBILIDAD:
            </h3>

            <div class="space-y-3">
              <div class="bg-[#141210]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-[11px] font-bold tracking-wider text-white block mb-3 uppercase">AMAZON ES</span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">Caja →</a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">GPU →</a>
                </div>
              </div>

              <div class="bg-[#18120d]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-[11px] font-bold tracking-wider text-white block mb-3 uppercase">PCCOMPONENTES</span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">Caja →</a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">GPU →</a>
                </div>
              </div>

              <div class="bg-[#0e111a]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-[11px] font-bold tracking-wider text-white block mb-3 uppercase">COOLMOD</span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">Caja →</a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">GPU →</a>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- TABLA DE MÉTRICAS -->
      <h2 class="text-2xl font-bold font-orbitron mb-6 mt-12">Métricas de Dimensiones Comparadas</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] overflow-hidden mb-12 text-sm sm:text-base">
        <div class="grid grid-cols-4 px-6 py-4 border-b border-white/5 text-[10px] sm:text-xs font-orbitron text-[#00ffff] tracking-widest uppercase">
          <div>Parámetro</div>
          <div>Chasis</div>
          <div>Tarjeta GPU</div>
          <div>Margen</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center">
          <div class="font-bold">Longitud Máxima</div>
          <div class="text-slate-300">{caseMaxLength} mm</div>
          <div class="text-slate-300">{gpuLength} mm</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin} mm` : `${margin} mm`}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 items-center bg-white/[0.02]">
          <div class="font-bold">Holgura con Frontal</div>
          <div class="text-slate-300">- 25 mm (Ventiladores)</div>
          <div class="text-slate-300">-</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{margin - 25 > 0 ? `+${margin - 25} mm Libres` : 'Ajustado / Colisión'}</div>
        </div>
      </div>

      <!-- ANÁLISIS SEO Y TEXTO DINÁMICO -->
      <h2 class="text-2xl font-bold font-orbitron mb-6">Análisis de Ensamblaje</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] p-6 sm:p-8 mb-16 text-slate-300 leading-relaxed">
        <p class="mb-6">
          Al instalar la <strong class="text-white">{gpu.brand} {gpu.model}</strong> (longitud de <strong class="text-[#00ffff]">{gpuLength} mm</strong>) dentro del chasis <strong class="text-white">{pcCase.brand} {pcCase.model}</strong>, el espacio frontal restante es de <strong>{margin > 0 ? `+${margin}` : margin} mm</strong>.
        </p>

        <div class="bg-[#111] border border-white/10 rounded-xl p-5 mb-6">
          <strong class="font-orbitron text-[11px] text-white tracking-widest uppercase mb-2 block">GESTIÓN DE CABLEADO (12VHPWR):</strong>
          <p class="text-sm">
            Debido al conector de esta gráfica y su rigidez, recomendamos usar un cable acodado a 90º o adaptador lateral para evitar presionar los pines contra el cristal templado lateral.
          </p>
        </div>

        <ul class="space-y-3 text-sm">
          {status === 'verde' && (
            <li class="flex items-start gap-2 text-emerald-400">
              <span>↳</span> <span class="text-slate-300"><strong class="text-emerald-400 font-normal">Holgura ideal:</strong> Con {margin}mm libres, el flujo de aire frontal no se verá obstruido y la instalación será sumamente sencilla, incluso con radiadores líquidos (AIO) instalados en el frontal.</span>
            </li>
          )}
          {status === 'amarillo' && (
            <li class="flex items-start gap-2 text-amber-400">
              <span>↳</span> <span class="text-slate-300"><strong class="text-amber-400 font-normal">Montaje difícil:</strong> Entra muy justa ({margin}mm libres). Tendrás que introducir la tarjeta en ángulo. Si planeas instalar un radiador de refrigeración líquida en el panel frontal, no cabrá.</span>
            </li>
          )}
          {status === 'rojo' && (
            <li class="flex items-start gap-2 text-rose-500">
              <span>↳</span> <span class="text-slate-300"><strong class="text-rose-500 font-normal">Colisión física:</strong> Faltan {Math.abs(margin)}mm para que la GPU quepa. Te sugerimos buscar una caja con un chasis de mayor formato o una tarjeta gráfica más corta.</span>
            </li>
          )}
        </ul>
      </div>

    </main>

    <Footer />
  </body>
</html>