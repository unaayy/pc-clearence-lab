---
import psusData from '../../data/psus.json';
import gpusData from '../../data/gpus.json';
import cpusData from '../../data/cpus.json';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getStoresForLocale } from '../../config/stores.js';
import { useTranslations } from '../../i18n/utils';

// 1. GENERADOR DE RUTAS AMBAS LENGUAS
export async function getStaticPaths() {
  const psus = psusData.slice(0, 10);
  const gpus = gpusData.slice(0, 10);
  const cpus = cpusData.slice(0, 10);

  const paths = [];
  const langs = [undefined, 'en'];

  for (const lang of langs) {
    for (const psu of psus) {
      for (const gpu of gpus) {
        for (const cpu of cpus) {
          paths.push({
            params: { 
              lang,
              psuSlug: psu.slug, 
              gpuSlug: gpu.slug, 
              cpuSlug: cpu.slug 
            },
            props: { psu, gpu, cpu }
          });
        }
      }
    }
  }
  return paths;
}

// 2. RECUPERAR DATOS DE LA COMBINACIÓN ACTUAL (UNA SOLA VEZ)
const { psu, gpu, cpu } = Astro.props;
const { lang: langParam } = Astro.params;
const lang = langParam === 'en' ? 'en' : 'es';

if (!psu || !gpu || !cpu) {
  return Astro.redirect('/404');
}

const t = useTranslations(lang);
const langPrefix = lang === 'en' ? '/en' : '';

// Configuración dinámica de tiendas por idioma
const currentLang = lang;
const stores = getStoresForLocale(currentLang);

const psuQuery = `${psu.brand} ${psu.model}`.trim();
const gpuQuery = `${gpu.brand} ${gpu.model}`.trim();

// Fallbacks de TDP
const gpuTdp = gpu.tdp || gpu.watts || 250;
const cpuTdp = cpu.tdp || cpu.watts || 120;

// MOTOR DE CÁLCULO ENERGÉTICO
const overhead = 80;
const rawDemand = gpuTdp + cpuTdp + overhead;
const recommendedDemand = Math.ceil(rawDemand * 1.25);
const psuPower = psu.wattage || psu.watts || 750;
const margin = psuPower - recommendedDemand;

let status = 'verde';
let colorHex = '#10b981';
let statusText = lang === 'en' ? 'OPTIMAL POWER' : 'POTENCIA ÓPTIMA';
let statusMessage = lang === 'en' ? 'STABLE POWER FLOW' : 'FLUJO ENERGÉTICO ESTABLE';

if (margin < 0) {
  status = 'rojo';
  colorHex = '#f43f5e';
  statusText = lang === 'en' ? 'INSUFFICIENT POWER' : 'POTENCIA INSUFICIENTE';
  statusMessage = lang === 'en' ? 'CRITICAL POWER DEFICIT' : 'DÉFICIT ENERGÉTICO CRÍTICO';
} else if (margin < 100) {
  status = 'amarillo';
  colorHex = '#fbbf24';
  statusText = lang === 'en' ? 'POWER AT LIMIT' : 'POTENCIA AL LÍMITE';
  statusMessage = lang === 'en' ? 'OVERLOAD WARNING' : 'ADVERTENCIA DE SOBRECARGA';
}

const statement = lang === 'en'
  ? `Lidunax telemetry engine analyzes peak consumption curves of graphics card ${gpu.brand} ${gpu.model} with processor ${cpu.brand} ${cpu.model}, verifying if power supply ${psu.brand} ${psu.model} (${psuPower}W) provides required current.`
  : `El motor de telemetría de Lidunax analiza la curva de consumo en pico de la tarjeta gráfica ${gpu.brand} ${gpu.model} junto al procesador ${cpu.brand} ${cpu.model}, verificando si la fuente ${psu.brand} ${psu.model} de ${psuPower}W ofrece la entrega de corriente estable requerida.`;
const statementWords = statement.split(' ');

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{psu.brand} {psu.model} + {gpu.brand} {gpu.model} + {cpu.model} - LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.webp?v=5" />
    <meta name="description" content={`PSU Power Telemetry: ${psuPower}W for ${gpu.brand} ${gpu.model} & ${cpu.model}`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen font-sans selection:bg-[#00ffff] selection:text-black">
    
    <!-- Navbar -->
    <header class="border-b border-white/10 bg-black/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href={langPrefix || '/'} class="flex items-center gap-3">
          <img src="/logoancho.webp" alt="LDX" width="160" height="32" class="h-8 w-auto object-contain" />
          <span class="font-orbitron font-bold tracking-widest hidden sm:block">LIDUNAX</span>
        </a>
        <nav class="flex gap-6 text-sm font-orbitron tracking-wider text-slate-400">
          <a href={`${langPrefix}/fuente-psu`} class="hover:text-[#00ffff] transition-colors">
            {lang === 'en' ? '← BACK TO SEARCH' : '← VOLVER AL BUSCADOR'}
          </a>
        </nav>
      </div>
    </header>

    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12">
      
      <!-- Encabezado del reporte -->
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-bold font-orbitron mb-3 uppercase tracking-wide">
          <span class="text-slate-400 block text-lg mb-1">
            {lang === 'en' ? 'Energy Telemetry Report' : 'Informe de Telemetría Energética'}
          </span>
          {psu.brand} {psu.model}
        </h1>
        <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
          {lang === 'en' ? 'Combined draw with GPU' : 'Consumo combinado con la gráfica'} <strong class="text-white">{gpu.brand} {gpu.model}</strong> {lang === 'en' ? 'and CPU' : 'y el procesador'} <strong class="text-white">{cpu.brand} {cpu.model}</strong>.
        </p>
      </div>

      <!-- Diagrama visual y panel de diagnóstico -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 mb-12">
        
        <!-- DIAGRAMA VISUAL ESQUEMÁTICO -->
        <div class="relative bg-[#0a0a0c] border border-white/5 rounded-[24px] overflow-hidden min-h-[460px] flex items-center justify-center p-4 sm:p-8 shadow-[inset_0_0_80px_rgba(0,0,0,0.8)]">
          <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          
          <svg viewBox="0 0 400 420" class="w-full max-w-[460px] relative z-10 drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
            <defs>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="softGlow">
                <feGaussianBlur stdDeviation="2" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <!-- CABLES ANIMADOS -->
            <path d="M 200 280 C 200 200 100 210 100 130" fill="none" stroke={colorHex} stroke-width="4" filter="url(#glow)" stroke-dasharray="10 8" class="animate-[dash_1s_linear_infinite]" />
            <path d="M 200 280 C 200 200 300 210 300 150" fill="none" stroke={colorHex} stroke-width="4" filter="url(#glow)" stroke-dasharray="10 8" class="animate-[dash_1s_linear_infinite]" />

            <!-- DIBUJO GPU -->
            <g transform="translate(30, 80)">
              <text x="70" y="-22" fill="white" font-family="Orbitron" font-size="14" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{gpuTdp}W</text>
              <text x="70" y="-8" fill="#888" font-family="monospace" font-size="9" text-anchor="middle" letter-spacing="1">TDP GPU</text>
              
              <rect x="0" y="0" width="140" height="50" rx="4" fill="#0d1117" stroke="white" stroke-width="1.5" stroke-opacity="0.3"/>
              <path d="M 10 0 L 130 0" stroke="white" stroke-width="2" stroke-opacity="0.6" />
              
              <circle cx="25" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="70" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="115" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              
              <path d="M 25 11 L 25 39 M 11 25 L 39 25" stroke="white" stroke-opacity="0.1" />
              <path d="M 70 11 L 70 39 M 56 25 L 84 25" stroke="white" stroke-opacity="0.1" />
              <path d="M 115 11 L 115 39 M 101 25 L 129 25" stroke="white" stroke-opacity="0.1" />

              <rect x="30" y="50" width="60" height="4" fill="#0d1117" stroke="white" stroke-opacity="0.4" stroke-width="1"/>
            </g>

            <!-- DIBUJO CPU -->
            <g transform="translate(265, 80)">
              <text x="35" y="-22" fill="white" font-family="Orbitron" font-size="14" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{cpuTdp}W</text>
              <text x="35" y="-8" fill="#888" font-family="monospace" font-size="9" text-anchor="middle" letter-spacing="1">TDP CPU</text>

              <rect x="0" y="0" width="70" height="70" rx="4" fill="#0d1117" stroke="white" stroke-width="1.5" stroke-opacity="0.3"/>
              <polygon points="4,4 10,4 4,10" fill="white" fill-opacity="0.4"/>
              <path d="M -2 10 L -2 60 M 72 10 L 72 60" stroke="white" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="2 3"/>
              
              <rect x="12" y="12" width="46" height="46" rx="4" fill="#151b23" stroke="white" stroke-width="1" stroke-opacity="0.4"/>
              <rect x="20" y="20" width="30" height="30" rx="2" fill="none" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
            </g>

            <!-- DIBUJO PSU -->
            <g transform="translate(130, 280)">
              <rect x="0" y="0" width="140" height="80" rx="6" fill="#0d1117" stroke={colorHex} stroke-width="2.5" filter="url(#glow)"/>
              
              <circle cx="50" cy="40" r="28" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="50" cy="40" r="10" fill="none" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <path d="M 22 40 L 78 40 M 50 12 L 50 68 M 30 20 L 70 60 M 30 60 L 70 20" stroke="white" stroke-opacity="0.1" stroke-width="1.5"/>

              <rect x="110" y="15" width="16" height="24" rx="2" fill="none" stroke="white" stroke-opacity="0.3"/>
              <rect x="114" y="20" width="8" height="4" fill="white" fill-opacity="0.4"/>
              <rect x="114" y="28" width="8" height="4" fill="white" fill-opacity="0.4"/>
              <rect x="110" y="50" width="16" height="16" rx="2" fill="#151b23" stroke="white" stroke-opacity="0.3"/>
              <circle cx="118" cy="58" r="3" fill="white" fill-opacity="0.5"/>

              <text x="70" y="112" fill="white" font-family="Orbitron" font-size="16" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{psuPower}W</text>
              <text x="70" y="128" fill={colorHex} font-family="monospace" font-size="10" text-anchor="middle" letter-spacing="1">{lang === 'en' ? 'POWER SUPPLY' : 'FUENTE PSU'}</text>
            </g>

            <!-- BADGE CENTRAL -->
            <g transform="translate(155, 200)">
              <rect x="0" y="0" width="90" height="26" rx="13" fill="#0d1117" stroke={colorHex} stroke-width="1.5" filter="url(#glow)"/>
              <text x="45" y="17" fill={colorHex} font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">{margin > 0 ? `+${margin}W` : `${margin}W`}</text>
            </g>
          </svg>

          <style>
            @keyframes dash {
              from { stroke-dashoffset: 0; }
              to { stroke-dashoffset: -36; }
            }
          </style>
        </div>

        <!-- Panel lateral de estado y disponibilidad -->
        <div class="flex flex-col gap-4">
          
          <!-- TARJETA DE DIAGNÓSTICO -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${colorHex}`}></div>
            
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style={`background-color: ${colorHex}`}></span>
                <span class="relative inline-flex rounded-full h-3 w-3" style={`background-color: ${colorHex}`}></span>
              </span>
              <h2 class="font-orbitron font-bold tracking-widest text-sm uppercase" style={`color: ${colorHex}`}>
                {statusMessage}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">
                  {lang === 'en' ? 'ESTIMATED DRAW' : 'DEMANDA ESTIMADA'}
                </span>
                <span class="font-orbitron font-bold text-2xl text-white">{recommendedDemand} <small class="text-[0.5em] text-slate-400">W</small></span>
              </div>
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">
                  {lang === 'en' ? 'FREE MARGIN' : 'MARGEN LIBRE'}
                </span>
                <span class="font-orbitron font-bold text-2xl" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin}` : margin} <small class="text-[0.5em]">W</small></span>
              </div>
            </div>
          </div>

          <!-- ESCÁNER DE DISPONIBILIDAD MULTI-TIENDA DINÁMICO CORREGIDO -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-2xl flex flex-col justify-between flex-1 animate-reveal" style="animation-delay: 0.22s;">
            <h3 class="font-orbitron text-xs tracking-[0.2em] text-slate-400 mb-4 uppercase">
              {lang === 'en' ? 'CHECK AVAILABILITY:' : 'COMPROBAR HARDWARE:'}
            </h3>

            <div class="space-y-3">
              {stores.map((store) => (
                <div 
                  class="relative bg-white/[0.02] border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10 overflow-hidden"
                >
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-orbitron text-xs font-bold tracking-wider text-white uppercase">
                      {store.name}
                    </span>
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <a
                      href={store.buildUrl(psuQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>{lang === 'en' ? 'PSU' : 'Fuente'}</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    <a
                      href={store.buildUrl(gpuQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>GPU</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  </div>

                  <div 
                    class="absolute bottom-0 left-0 right-0 h-[2px]" 
                    style={`background: linear-gradient(90deg, transparent 0%, ${store.color} 50%, transparent 100%);`}
                  ></div>
                </div>
              ))}
            </div>
          </div>

        </div>

      </div>

      <!-- Tabla de Métricas -->
      <h2 class="text-2xl font-bold font-orbitron mb-6 mt-12">
        {lang === 'en' ? 'Compared Energy Metrics' : 'Métricas de Energía Comparadas'}
      </h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] overflow-hidden mb-12 text-sm sm:text-base">
        <div class="grid grid-cols-4 px-6 py-4 border-b border-white/5 text-[10px] sm:text-xs font-orbitron text-[#00ffff] tracking-widest uppercase">
          <div>{lang === 'en' ? 'Parameter' : 'Parámetro'}</div>
          <div>{lang === 'en' ? 'Power Supply' : 'Fuente PSU'}</div>
          <div>{lang === 'en' ? 'Hardware (CPU+GPU)' : 'Hardware (CPU+GPU)'}</div>
          <div>{lang === 'en' ? 'Diagnosis' : 'Diagnóstico'}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center">
          <div class="font-bold">{lang === 'en' ? 'Rated Power' : 'Potencia Nominal'}</div>
          <div class="text-slate-300">{psuPower} W</div>
          <div class="text-slate-300">{rawDemand} W ({lang === 'en' ? 'Gross' : 'Bruto'})</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{status === 'rojo' ? (lang === 'en' ? 'INSUFFICIENT' : 'INSUFICIENTE') : 'OK'}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center bg-white/[0.02]">
          <div class="font-bold">{lang === 'en' ? 'Transient Spikes' : 'Picos Transitorios'}</div>
          <div class="text-slate-300">{lang === 'en' ? 'ATX Support' : 'Soporte ATX'}</div>
          <div class="text-slate-300">{recommendedDemand} W (+25%)</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin} W ${lang === 'en' ? 'FREE' : 'LIBRES'}` : `${margin} W ${lang === 'en' ? 'DEFICIT' : 'DÉFICIT'}`}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 items-center">
          <div class="font-bold">{lang === 'en' ? 'PCIe Connector' : 'Conector PCIe'}</div>
          <div class="text-slate-300">{psu.has12VHPWR ? (lang === 'en' ? 'Native 12VHPWR' : '12VHPWR Nativo') : (lang === 'en' ? 'Classic 8-pin' : '8 pines clásico')}</div>
          <div class="text-slate-300">{gpuTdp > 280 ? (lang === 'en' ? '12VHPWR Required' : '12VHPWR Requerido') : (lang === 'en' ? 'Standard' : 'Estándar')}</div>
          <div class="font-orbitron font-bold">
            {!psu.has12VHPWR && gpuTdp > 280 ? <span class="text-amber-400">{lang === 'en' ? 'Adapter Required' : 'Adaptador Necesario'}</span> : <span class="text-emerald-400">Compatible</span>}
          </div>
        </div>
      </div>

      <!-- Análisis narrativo de ensamblaje (SEO) con TEXTO SCROLLER -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold font-orbitron mb-4">
          {lang === 'en' ? 'How we evaluate power supply in LIDUNAX' : '¿Cómo evaluamos el suministro de energía en LIDUNAX?'}
        </h2>
        
        <p class="lit mb-8" data-lit>
          {statementWords.map((word) => (<><span class="w">{word}</span>{' '}</>))}
        </p>

        <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] p-6 sm:p-8 text-slate-300 leading-relaxed">
          <p class="mb-6">
            {lang === 'en'
              ? `When pairing the ${psu.brand} ${psu.model} power supply (${psuPower}W) with processor ${cpu.brand} ${cpu.model} and graphics card ${gpu.brand} ${gpu.model}, peak power draw reaches ${recommendedDemand}W.`
              : `Al emparejar la fuente de alimentación ${psu.brand} ${psu.model} de ${psuPower}W con el procesador ${cpu.brand} ${cpu.model} y la tarjeta gráfica ${gpu.brand} ${gpu.model}, la demanda eléctrica de pico alcanza los ${recommendedDemand}W.`}
          </p>

          <div class="bg-[#111] border border-white/10 rounded-xl p-5 mb-6">
            <strong class="font-orbitron text-[11px] text-white tracking-widest uppercase mb-2 block">
              {lang === 'en' ? 'TRANSIENT SPIKE MANAGEMENT:' : 'GESTIÓN DE PICOS DE TENSIÓN:'}
            </strong>
            <p class="text-sm">
              {lang === 'en'
                ? 'To prevent sudden OCP/OPP trips caused by transient power spikes on modern GPUs, Lidunax evaluates a strict 25% safety margin above theoretical consumption.'
                : 'Para evitar disparos intempestivos del OCP/OPP provocados por los picos transitorios de potencia de las GPUs modernas, Lidunax evalúa un margen de seguridad del 25% por encima del consumo teórico.'}
            </p>
          </div>

          <ul class="space-y-3 text-sm">
            {status === 'verde' && (
              <li class="flex items-start gap-2 text-emerald-400">
                <span>↳</span> <span class="text-slate-300"><strong class="text-emerald-400 font-normal">{lang === 'en' ? 'Optimal reserve:' : 'Capacidad holgada:'}</strong> {lang === 'en' ? `You have ${margin}W of reserve power. The PSU will operate in its peak efficiency curve.` : `Cuentas con ${margin}W de reserva. La fuente trabajará en su zona de máxima eficiencia energética (50%-70% de carga).`}</span>
              </li>
            )}
            {status === 'amarillo' && (
              <li class="flex items-start gap-2 text-amber-400">
                <span>↳</span> <span class="text-slate-300"><strong class="text-amber-400 font-normal">{lang === 'en' ? 'High load:' : 'Carga elevada:'}</strong> {lang === 'en' ? 'The power supply can run the build but will operate near thermal limits under stress.' : 'La fuente podrá alimentar el equipo, pero operará cerca del límite térmico bajo cargas pesadas.'}</span>
              </li>
            )}
            {status === 'rojo' && (
              <li class="flex items-start gap-2 text-rose-500">
                <span>↳</span> <span class="text-slate-300"><strong class="text-rose-500 font-normal">{lang === 'en' ? 'Overload detected:' : 'Sobrecarga detectada:'}</strong> {lang === 'en' ? `Power deficit of ${Math.abs(margin)}W. System shutdowns will occur under combined load.` : `Hay un déficit de ${Math.abs(margin)}W. Sufrirás apagados de protección cuando la GPU y la CPU alcancen su Boost simultáneo.`}</span>
              </li>
            )}
          </ul>
        </div>
      </section>

    </main>

    <Footer />

    <!-- Script de control de iluminación por Scroll -->
    <script>
      function initLit() {
        const el = document.querySelector('[data-lit]') as HTMLElement | null;
        if (!el || el.dataset.ready) return;
        el.dataset.ready = '1';
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const words = Array.from(el.querySelectorAll('.w')) as HTMLElement[];
        el.classList.add('armed');
        let ticking = false;
        let listening = false;
        const update = () => {
          ticking = false;
          if (!el.isConnected) return;
          const vh = window.innerHeight;
          const rect = el.getBoundingClientRect();
          const start = vh * 0.9; const end = vh * 0.35;
          const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height)));
          const lit = Math.round(progress * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        const startListening = () => {
          if (listening) return;
          listening = true;
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          onScroll();
        };
        const stopListening = () => {
          if (!listening) return;
          listening = false;
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        };
        const io = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) startListening();
          else stopListening();
        });
        io.observe(el);
      }

      document.addEventListener('astro:page-load', initLit);
      initLit();
    </script>

    <style>
      .lit {
        max-width: 38em;
        font-size: clamp(1.1rem, 2vw, 1.6rem);
        font-weight: 600;
        line-height: 1.4;
        color: #f5f5f7;
      }
      .lit.armed .w {
        color: rgba(245, 245, 247, 0.22);
        transition: color 0.35s ease;
      }
      .lit.armed .w.on {
        color: #f5f5f7;
      }
    </style>
  </body>
</html>