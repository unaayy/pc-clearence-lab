---
// src/pages/[...lang]/full-pc.astro
import SearchInterfaceFullPc from '../../components/SearchInterfaceFullPc.jsx';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // Genera /full-pc (Español)
    { params: { lang: 'en' } },      // Genera /en/full-pc (Inglés)
  ];
}

const { lang: langParam } = Astro.params;
const lang = langParam === 'en' ? 'en' : 'es';

const t = useTranslations(lang);
const langPrefix = lang === 'en' ? '/en' : '';

// Importamos individualmente los 8 datasets divididos desde ../../data/
import cpusData from '../../data/cpus.json';
import coolersData from '../../data/coolers.json';
import gpusData from '../../data/gpus.json';
import psusData from '../../data/psus.json';
import casesData from '../../data/cases.json';
import motherboardsData from '../../data/motherboards.json';
import ramsData from '../../data/rams.json';
import storageData from '../../data/storage.json';

const cpus = cpusData || [];
const coolers = coolersData || [];
const gpus = gpusData || [];
const psus = psusData || [];
const cases = casesData || [];
const motherboards = motherboardsData || [];
const rams = ramsData || [];
const storages = storageData || [];

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');

// Texto SEO para la animación de scroll
const statement = lang === 'en'
  ? 'Lidunax full scanner crosses thousands of parametric variables in milliseconds, validating chassis clearance, thermal bottlenecks, and peak power demands.'
  : 'El escáner integral de Lidunax cruza miles de variables paramétricas en milisegundos. Validamos holguras físicas en el chasis, cuellos de botella térmicos y demandas de potencia pico para garantizar un ensamblaje de PC impecable y sin sorpresas.';
const statementWords = statement.split(' ');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{lang === 'en' ? 'Full PC Builder & Compatibility | LIDUNAX' : 'Configurador PC Completo y Compatibilidad | LIDUNAX'}</title>
    <link rel="icon" type="image/png" href="/logo2.webp?v=5" />
    <meta name="description" content="Configurador de PC Completo. Verifica la compatibilidad física, térmica y energética de todos tus componentes antes de ensamblar tu setup." />
    <link rel="canonical" href={canonicalURL} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
  </head>

  <body class="bg-[#050507] text-white min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-[#00ffff] selection:text-black">

    <canvas id="dotsCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true"></canvas>
    <div class="spotlight-campana absolute top-0 left-1/2 -translate-x-1/2 w-[100vw] h-[620px] pointer-events-none z-0" aria-hidden="true"></div>

    <div class="page relative z-10 flex flex-col min-h-screen justify-between">

      <header class="nav sf">
        <div class="nav__in">
          <a href={langPrefix || '/'} class="brand flex items-center gap-3">
            <img src="/logoancho.webp" alt="LDX" width="160" height="32" class="h-8 sm:h-10 w-auto object-contain" />
            <span class="brand__name orb">LIDUNAX</span>
          </a>
          <nav class="nav__links" aria-label="Principal">
            <a href={langPrefix || '/'}>{t('nav.home')}</a>
            <a href={`${langPrefix}/faq`}>{t('nav.faq')}</a>
            <a href={`${langPrefix}/about`}>{t('nav.about')}</a>
          </nav>
        </div>
      </header>

      <main class="main flex-1 w-full max-w-[1300px] mx-auto px-4 sm:px-6 py-12 lg:py-20">

        <!-- HERO -->
        <section class="flex flex-col items-center text-center mb-8">
          <h1 class="font-orbitron font-extrabold text-4xl md:text-6xl tracking-tight text-transparent bg-clip-text bg-gradient-to-b from-white to-slate-500 uppercase mb-4 rise">
            {lang === 'en' ? 'FULL PC BUILD' : 'PC COMPLETO'}
          </h1>
          <p class="text-slate-400 max-w-2xl text-sm md:text-base rise" style="--d:.1s">
            {lang === 'en'
              ? 'Design your build step by step. The master algorithm crosses thermal, physical, and energy telemetry.'
              : 'Diseña tu configuración paso a paso. El algoritmo maestro cruzará las telemetrías térmicas, físicas y energéticas para garantizar un ensamblaje sin cuellos de botella ni incompatibilidades.'}
          </p>
        </section>

        <!-- BUSCADOR MÚLTIPLE HUD -->
        <SearchInterfaceFullPc 
          client:idle 
          cpus={cpus} coolers={coolers} gpus={gpus} psus={psus} cases={cases} 
          motherboards={motherboards} rams={rams} storages={storages} 
        />

        <!-- SECCIÓN DE TEXTO EXPLICATIVO DEBAJO DEL BUSCADOR (Bento Grid) -->
        <section class="section" aria-labelledby="como-evaluamos">
          <h2 id="como-evaluamos" class="h2 orb text-center md:text-left text-2xl md:text-3xl font-bold mb-4">
            {lang === 'en' ? 'The Ultimate Audit' : 'La Auditoría Definitiva'}
          </h2>
          <p class="lit text-center md:text-left mx-auto md:mx-0 mb-8" data-lit>
            {statementWords.map((word) => (<><span class="w">{word}</span>{' '}</>))}
          </p>
          
          <div class="bento">
            <article class="card card--wide">
              <div>
                <h3 class="orb text-[#00ffff]">
                  {lang === 'en' ? '3D Clearance Scanner' : 'Escáner Tridimensional de Holguras'}
                </h3>
                <p>
                  {lang === 'en'
                    ? 'Validate GPU length, CPU cooler height, and AIO radiator thickness mathematically against your chosen chassis.'
                    : 'Nadie quiere descubrir que su nueva RTX 4090 choca con los ventiladores frontales. Validamos que el largo de la gráfica, la altura de la torre de aire y el grosor de los radiadores AIO entren matemáticamente en el chasis elegido.'}
                </p>
              </div>
              <div class="stat">
                <span class="stat__n orb">100<small>%</small></span>
                <span class="stat__cap">{lang === 'en' ? 'physical clearance precision' : 'precisión en cálculo de clearance físico'}</span>
              </div>
            </article>
            
            <article class="card card--narrow">
              <div>
                <h3 class="orb text-[#00ffff]">
                  {lang === 'en' ? 'Thermodynamics' : 'Termodinámica'}
                </h3>
                <p>
                  {lang === 'en'
                    ? 'We verify that nominal CPU TDP under load does not exceed cooler dissipation capacity to avoid throttling.'
                    : 'Comprobamos que el TDP nominal de la CPU bajo estrés no exceda el límite de disipación de la refrigeración elegida, evitando el throttling térmico.'}
                </p>
              </div>
              <div class="stat">
                <span class="stat__n orb">TDP<small>MAX</small></span>
                <span class="stat__cap">{lang === 'en' ? 'temp peak validation' : 'validación de picos de temperatura'}</span>
              </div>
            </article>
            
            <article class="card card--full">
              <div>
                <h3 class="orb text-[#00ffff]">
                  {lang === 'en' ? 'Power Telemetry & ATX 3.0' : 'Telemetría de Potencia y ATX 3.0'}
                </h3>
                <p>
                  {lang === 'en'
                    ? 'We calculate combined energy draw and apply a strict safety margin for transient spikes and 12VHPWR connectors.'
                    : 'Sumamos la curva de demanda energética de la placa base, procesador, gráfica y periféricos. Aplicamos un margen de seguridad estricto para sobrellevar picos transitorios y comprobamos si necesitas cables nativos 12VHPWR para tarjetas de última generación.'}
                </p>
              </div>
              <svg class="slots mx-auto md:mx-0" viewBox="0 0 220 150" role="img" aria-label="Esquema de conexiones de energía">
                <g fill="none" stroke-width="1.5" stroke-linejoin="round">
                  <path class="dim-line" d="M30 110 C 30 50, 100 80, 140 30" stroke-dasharray="4 4" />
                  <rect class="on" x="130" y="10" width="60" height="30" rx="3" />
                  <rect class="off" x="20" y="110" width="80" height="30" rx="3" />
                </g>
                <text x="160" y="28" text-anchor="middle">GPU</text>
                <text x="60" y="128" text-anchor="middle">{lang === 'en' ? 'POWER' : 'FUENTE'}</text>
              </svg>
            </article>
          </div>
        </section>

      </main>

      <Footer />

    </div>

    <!-- Scripts (Partículas y Texto animado SEO) -->
    <script>
      interface Dot { x: number; y: number; baseRadius: number; vx: number; vy: number; baseAlpha: number; }
      function initDots() {
        const canvas = document.getElementById('dotsCanvas') as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.ready) return;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D | null;
        if (!ctx) return;
        canvas.dataset.ready = '1';

        const speed = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1;
        let width = 0; let height = 0;
        const resize = () => {
          if (!canvas.isConnected) return;
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth; height = window.innerHeight;
          canvas.width = Math.floor(width * dpr); canvas.height = Math.floor(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize(); window.addEventListener('resize', resize);

        const dots: Dot[] = [];
        const numDots = Math.min(240, Math.floor((width * height) / 9000));
        for (let i = 0; i < numDots; i++) {
          dots.push({
            x: Math.random() * width, y: Math.random() * height,
            baseRadius: Math.random() * 1.3 + 0.4,
            vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2,
            baseAlpha: Math.random() * 0.35 + 0.15,
          });
        }
        const animate = () => {
          if (!canvas.isConnected) return;
          ctx.clearRect(0, 0, width, height);
          const lightX = width / 2; const lightY = -window.scrollY;
          const maxLight = Math.min(width, height) * 0.65;
          for (const dot of dots) {
            dot.x += dot.vx * speed; dot.y += dot.vy * speed;
            if (dot.x < 0) dot.x = width; if (dot.x > width) dot.x = 0;
            if (dot.y < 0) dot.y = height; if (dot.y > height) dot.y = 0;
            const distance = Math.hypot(dot.x - lightX, dot.y - lightY);
            ctx.beginPath();
            if (distance < maxLight) {
              const lightFactor = Math.pow(1 - distance / maxLight, 1.8);
              const radius = dot.baseRadius + lightFactor * 1.2;
              const alpha = Math.min(1, dot.baseAlpha + lightFactor * 0.65);
              ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);
              const r = Math.round(180 * (1 - lightFactor));
              const g = Math.round(180 * (1 - lightFactor) + 255 * lightFactor);
              const b = Math.round(190 * (1 - lightFactor) + 255 * lightFactor);
              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;
              if (lightFactor > 0.4) { ctx.shadowColor = 'rgba(0, 255, 255, 0.6)'; ctx.shadowBlur = 6; }
              else { ctx.shadowBlur = 0; }
            } else {
              ctx.arc(dot.x, dot.y, dot.baseRadius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(180, 180, 190, ${dot.baseAlpha})`; ctx.shadowBlur = 0;
            }
            ctx.fill();
          }
          requestAnimationFrame(animate);
        };
        animate();
      }

      function initLit() {
        const el = document.querySelector('[data-lit]') as HTMLElement | null;
        if (!el || el.dataset.ready) return;
        el.dataset.ready = '1';
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const words = Array.from(el.querySelectorAll('.w')) as HTMLElement[];
        el.classList.add('armed');
        let ticking = false;
        let listening = false;
        const update = () => {
          ticking = false;
          if (!el.isConnected) return;
          const vh = window.innerHeight;
          const rect = el.getBoundingClientRect();
          const start = vh * 0.9; const end = vh * 0.35;
          const progress = Math.min(1, Math.max(0, (start - rect.top) / (start - end + rect.height)));
          const lit = Math.round(progress * words.length);
          words.forEach((w, i) => w.classList.toggle('on', i < lit));
        };
        const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
        const startListening = () => {
          if (listening) return;
          listening = true;
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll);
          onScroll();
        };
        const stopListening = () => {
          if (!listening) return;
          listening = false;
          window.removeEventListener('scroll', onScroll);
          window.removeEventListener('resize', onScroll);
        };
        const io = new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) startListening();
          else stopListening();
        });
        io.observe(el);
      }

      function init() {
        initDots();
        initLit();
      }
      document.addEventListener('astro:page-load', init);
      init();
    </script>

    <style>
      .sf, .sf * { font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, sans-serif !important; }
      .orb, .sf .orb, .sf .orb * { font-family: 'Orbitron', sans-serif !important; }
      .spotlight-campana {
        background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0, 255, 255, 0.12) 0%, rgba(0, 255, 255, 0.03) 40%, rgba(0, 255, 255, 0.008) 70%, transparent 100%);
        filter: blur(60px);
      }
      .nav { position: sticky; top: 0; z-index: 50; background: rgba(5, 5, 7, 0.55); border-bottom: 1px solid rgba(255, 255, 255, 0.06); backdrop-filter: saturate(180%) blur(20px); }
      .nav__in { max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; justify-content: space-between; }
      .brand__name { font-size: 1.05rem; font-weight: 700; letter-spacing: 0.18em; color: #fff; }
      .nav__links { display: flex; gap: 32px; font-size: 14px; color: #86868b; }
      .nav__links a:hover { color: #fff; }
      .rise { opacity: 0; animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards; }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }

      /* ESTILOS BENTO GRID Y SEO TEXT */
      .section { margin-top: clamp(64px, 10vw, 120px); }
      .bento { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 16px; margin-top: clamp(32px, 5vw, 48px); }
      .card { position: relative; overflow: hidden; padding: clamp(24px, 3vw, 36px); border-radius: 28px; border: 1px solid rgba(255, 255, 255, 0.09); background: linear-gradient(180deg, rgba(255, 255, 255, 0.055), rgba(255, 255, 255, 0.015) 45%, rgba(0, 0, 0, 0.55)); backdrop-filter: blur(24px); }
      .card--wide { grid-column: span 4; display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: end; }
      .card--narrow { grid-column: span 2; display: flex; flex-direction: column; justify-content: space-between; gap: 32px; }
      .card--full { grid-column: span 6; display: grid; grid-template-columns: 1fr minmax(180px, 240px); gap: 32px; align-items: center; }
      .card h3 { font-size: 1.125rem; font-weight: 700; color: #fff; }
      .card p { margin-top: 12px; max-width: 44ch; font-size: 0.9375rem; line-height: 1.65; color: #86868b; }
      .stat__n { font-size: clamp(2.75rem, 5vw, 4rem); font-weight: 800; color: #fff; }
      .stat__n small { margin-left: 0.5em; font-size: 0.3em; color: #00ffff; }
      .stat__cap { font-size: 0.8125rem; color: #86868b; }

      .slots { width: 100%; height: auto; }
      .slots .on { stroke: #00ffff; fill: rgba(0, 255, 255, 0.07); }
      .slots .off { stroke: rgba(255, 255, 255, 0.2); }
      .slots .dim-line { stroke: #00ffff; stroke-width: 1.25; }
      .slots text { font-size: 11px; fill: #86868b; font-family: monospace; }

      .lit { margin-top: 20px; max-width: 28em; font-size: clamp(1.4rem, 3.1vw, 2.5rem); font-weight: 600; line-height: 1.28; color: #f5f5f7; }
      .lit.armed .w { color: rgba(245, 245, 247, 0.22); transition: color 0.35s ease; }
      .lit.armed .w.on { color: #f5f5f7; }

      @media (max-width: 900px) {
        .card--wide, .card--narrow, .card--full { grid-column: span 6; }
      }
    </style>
  </body>
</html>