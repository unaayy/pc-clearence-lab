---
// src/pages/politica-de-privacidad.astro - Página de Política de Privacidad (Liquid Glass HUD)
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const langPrefix = lang === 'en' ? '/en' : '';
const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{lang === 'en' ? 'Privacy Policy & Cookies - Data Protection | LIDUNAX' : 'Política de Privacidad y Cookies - Protección de Datos | LIDUNAX'}</title>
    <link rel="icon" type="image/png" href="/logo2.webp?v=5" />
    <meta name="description" content="Política de privacidad de Lidunax: tratamiento de datos anónimos, política de cookies, publicidad de Google AdSense y programa de afiliados." />
    <link rel="canonical" href={canonicalURL} />

    <!-- Carga de Orbitron -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Detección automática de idioma ultrarrápida -->
    <script is:inline>
      (function () {
        const savedLang = localStorage.getItem('lidunax_lang');
        const browserLang = (navigator.language || navigator.userLanguage || '').slice(0, 2);
        const targetLang = savedLang || (browserLang === 'en' ? 'en' : 'es');
        const currentPath = window.location.pathname;

        if (targetLang === 'en' && !currentPath.startsWith('/en')) {
          window.location.replace('/en' + currentPath);
        }
      })();
    </script>

    <!-- Datos Estructurados JSON-LD Schema.org para WebPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Política de Privacidad - Lidunax",
      "description": "Política de privacidad, uso de cookies y tratamiento de datos para el sitio web lidunax.com.",
      "url": canonicalURL.href,
      "publisher": {
        "@type": "Organization",
        "name": "Lidunax",
        "url": "https://www.lidunax.com"
      }
    })} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-[#00ffff] selection:text-black">
    
    <canvas id="dotsCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true"></canvas>
    <div class="spotlight-campana absolute top-0 left-1/2 -translate-x-1/2 w-[100vw] h-[620px] pointer-events-none z-0" aria-hidden="true"></div>

    <div class="page relative z-10 flex flex-col min-h-screen justify-between">
      
      <header class="nav sf">
        <div class="nav__in">
          <a href={langPrefix || '/'} class="brand flex items-center gap-3">
            <img src="/logoancho.webp" alt="LDX" width="160" height="32" class="h-8 sm:h-10 w-auto object-contain" />
            <span class="brand__name orb">LIDUNAX</span>
          </a>

          <nav class="nav__links" aria-label="Principal" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
            <a href={langPrefix || '/'} class="hover:text-white transition-colors">{t('nav.home')}</a>
            <a href={`${langPrefix}/faq`} class="hover:text-white transition-colors">{t('nav.faq')}</a>
            <a href={`${langPrefix}/about`} class="hover:text-white transition-colors">{t('nav.about')}</a>
          </nav>
        </div>
      </header>

      <main class="main w-full max-w-4xl mx-auto px-4 pt-16 pb-24 space-y-12">
        
        <section class="text-center space-y-4 rise" style="--d:.05s">
          <h1 class="text-3xl sm:text-5xl font-bold tracking-widest uppercase orb bg-gradient-to-b from-[#ffffff] via-[#ffffff] to-[#8e8e93] bg-clip-text text-transparent">
            {lang === 'en' ? 'PRIVACY POLICY' : 'POLÍTICA DE PRIVACIDAD'}
          </h1>
          <p class="text-[#86868b] text-sm sm:text-base tracking-wide max-w-xl mx-auto font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
            {lang === 'en'
              ? 'Data protection framework, anonymous metrics, and cookie management on lidunax.com.'
              : 'Marco de protección de datos, métricas anónimas y gestión de cookies en lidunax.com.'}
          </p>
        </section>

        <section class="card relative p-6 sm:p-10 space-y-10 rise-soft" style="--d:.2s">
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-[1px] bg-gradient-to-r from-transparent via-[#00ffff]/30 to-transparent pointer-events-none"></div>

          <div class="space-y-2 border-b border-white/5 pb-6">
            <span class="text-xs font-orbitron text-[#00ffff] tracking-widest uppercase orb opacity-80">// {lang === 'en' ? 'DATA_PROTECTION' : 'PROTECCIÓN_DE_DATOS'}</span>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
              {lang === 'en'
                ? 'At Lidunax, accessible from lidunax.com, one of our main priorities is transparency and safeguarding visitor privacy.'
                : 'En Lidunax, accesible desde lidunax.com, una de nuestras máximas prioridades es la transparencia y la salvaguarda de la privacidad de nuestros visitantes.'}
            </p>
          </div>

          <div class="space-y-8">
            <div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] space-y-3">
              <span class="text-[#00ffff] text-xs font-orbitron tracking-widest orb">01 // {lang === 'en' ? 'TELEMETRY & METRICS' : 'TELEMETRÍA Y MÉTRICAS'}</span>
              <h2 class="text-white text-lg font-semibold" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en' ? 'Minimal Collection & Anonymous Data' : 'Recopilación Mínima y Datos Anónimos'}
              </h2>
              <p class="text-sm text-[#86868b] font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en'
                  ? 'Lidunax requires no user registration or input forms. As a hardware clearance tool, we collect only anonymous usage metrics via essential technical cookies for system stability.'
                  : 'Lidunax no requiere registro de usuario, formularios de entrada de datos ni almacena información personal sensible. Como plataforma analítica de compatibilidad de hardware, recopilamos únicamente métricas anónimas de navegación a través de cookies técnicas esenciales para garantizar la estabilidad y rendimiento del simulador.'}
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] space-y-3">
              <span class="text-[#00ffff] text-xs font-orbitron tracking-widest orb">02 // {lang === 'en' ? 'THIRD-PARTY PROVIDERS' : 'PROVEEDORES DE TERCEROS'}</span>
              <h2 class="text-white text-lg font-semibold" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en' ? 'Advertising & Affiliates (Google AdSense & Amazon)' : 'Publicidad y Afiliación (Google AdSense y Amazon)'}
              </h2>
              <p class="text-sm text-[#86868b] font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en'
                  ? 'This site uses third-party advertising and analytics services like Google AdSense and the Amazon EU Associates Program, which may use cookies to serve contextual ads.'
                  : 'Este sitio web utiliza servicios analíticos y publicitarios gestionados por terceros, tales como Google AdSense y el Programa de Afiliados de Amazon EU. Estos proveedores pueden emplear cookies (como la cookie DART de Google) para servir anuncios contextuales basados en visitas previas del usuario a esta o a otras páginas web.'}
              </p>
            </div>

            <div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] space-y-3">
              <span class="text-[#00ffff] text-xs font-orbitron tracking-widest orb">03 // {lang === 'en' ? 'USER CONTROL' : 'CONTROL DEL USUARIO'}</span>
              <h2 class="text-white text-lg font-semibold" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en' ? 'Cookie Management & Disabling' : 'Gestión y Desactivación de Cookies'}
              </h2>
              <p class="text-sm text-[#86868b] font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                {lang === 'en'
                  ? 'Visitors can disable cookies through individual browser options (Chrome, Firefox, Safari, Edge). Check official developer documentation for details.'
                  : 'Cualquier visitante puede optar por desactivar las cookies a través de las opciones individuales de su navegador web (Chrome, Firefox, Safari, Edge). Para obtener información más detallada sobre la gestión de cookies en navegadores específicos, consulte los sitios web oficiales de sus respectivos desarrolladores.'}
              </p>
            </div>
          </div>

          <div class="bg-black/40 border border-white/10 rounded-2xl p-4 sm:p-6 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs text-[#86868b] font-light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
              {lang === 'en' ? 'Have questions regarding site privacy?' : '¿Tienes dudas sobre cómo gestionamos la privacidad en el sitio?'}
            </span>
            <a href={`${langPrefix}/contacto`} class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-[#00ffff]/50 text-xs font-orbitron text-[#00ffff] tracking-wider transition-all duration-300 orb">
              {lang === 'en' ? 'CONTACT SUPPORT →' : 'CONTACTAR SOPORTE →'}
            </a>
          </div>

        </section>

      </main>

      <Footer />
    </div>

    <script>
      interface Dot { x: number; y: number; baseRadius: number; vx: number; vy: number; baseAlpha: number; }

      function initDots() {
        const canvas = document.getElementById('dotsCanvas') as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.ready) return;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D | null;
        if (!ctx) return;
        canvas.dataset.ready = '1';

        const speed = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1;
        let width = 0; let height = 0;

        const resize = () => {
          if (!canvas.isConnected) { window.removeEventListener('resize', resize); return; }
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth; height = window.innerHeight;
          canvas.width = Math.floor(width * dpr); canvas.height = Math.floor(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize(); window.addEventListener('resize', resize);

        const dots: Dot[] = [];
        const numDots = Math.min(240, Math.floor((width * height) / 9000));
        for (let i = 0; i < numDots; i++) {
          dots.push({
            x: Math.random() * width, y: Math.random() * height,
            baseRadius: Math.random() * 1.3 + 0.4,
            vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2,
            baseAlpha: Math.random() * 0.35 + 0.15,
          });
        }

        const animate = () => {
          if (!canvas.isConnected) return;
          ctx.clearRect(0, 0, width, height);

          const lightX = width / 2;
          const lightY = -window.scrollY;
          const maxLight = Math.min(width, height) * 0.65;

          for (const dot of dots) {
            dot.x += dot.vx * speed; dot.y += dot.vy * speed;
            if (dot.x < 0) dot.x = width; if (dot.x > width) dot.x = 0;
            if (dot.y < 0) dot.y = height; if (dot.y > height) dot.y = 0;

            const distance = Math.hypot(dot.x - lightX, dot.y - lightY);
            ctx.beginPath();

            if (distance < maxLight) {
              const lightFactor = Math.pow(1 - distance / maxLight, 1.8);
              const radius = dot.baseRadius + lightFactor * 1.2;
              const alpha = Math.min(1, dot.baseAlpha + lightFactor * 0.65);
              ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);

              const r = Math.round(180 * (1 - lightFactor));
              const g = Math.round(180 * (1 - lightFactor) + 255 * lightFactor);
              const b = Math.round(190 * (1 - lightFactor) + 255 * lightFactor);
              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;

              if (lightFactor > 0.4) { ctx.shadowColor = 'rgba(0, 255, 255, 0.6)'; ctx.shadowBlur = 6; } 
              else { ctx.shadowBlur = 0; }
            } else {
              ctx.arc(dot.x, dot.y, dot.baseRadius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(180, 180, 190, ${dot.baseAlpha})`; ctx.shadowBlur = 0;
            }
            ctx.fill();
          }
          requestAnimationFrame(animate);
        };
        animate();
      }
      document.addEventListener('astro:page-load', initDots);
      initDots();
    </script>

    <style>
      .orb { font-family: 'Orbitron', sans-serif !important; }
      .spotlight-campana { background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(0, 255, 255, 0.12) 0%, rgba(0, 255, 255, 0.03) 40%, rgba(0, 255, 255, 0.008) 70%, transparent 100%); filter: blur(60px); }
      .nav { position: sticky; top: 0; z-index: 50; background: rgba(5, 5, 7, 0.55); border-bottom: 1px solid rgba(255, 255, 255, 0.06); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); }
      .nav__in { max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; justify-content: space-between; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand__name { font-size: 1.05rem; font-weight: 700; letter-spacing: 0.18em; color: #fff; }
      .nav__links { display: flex; gap: 32px; font-size: 14px; color: #86868b; }
      @media (max-width: 560px) { .brand__name { display: none; } .nav__links { gap: 20px; font-size: 13px; } }
      .rise { opacity: 0; animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards; }
      .rise-soft { opacity: 0; animation: rise-soft 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards; }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
      @keyframes rise-soft { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
      .card { border-radius: 28px; border: 1px solid rgba(255, 255, 255, 0.09); background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01) 45%, rgba(0, 0, 0, 0.6)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 30px 60px rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(32px); backdrop-filter: blur(32px); }
      @media (prefers-reduced-motion: reduce) { .rise, .rise-soft { animation: none; opacity: 1; transform: none; filter: none; } }
    </style>
  </body>
</html>