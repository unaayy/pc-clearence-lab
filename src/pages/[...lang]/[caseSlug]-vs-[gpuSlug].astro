---
import casesData from '../../data/cases.json';
import gpusData from '../../data/gpus.json';
import Footer from '../../components/Footer.astro';
import '../../styles/global.css';
import { getStoresForLocale } from '../../config/stores.js';
import { useTranslations } from '../../i18n/utils';

// 1. GENERADOR DE RUTAS (pSEO)
export async function getStaticPaths() {
  const cases = casesData.slice(0, 40);
  const gpus = gpusData.slice(0, 40);

  const paths = [];
  const langs = [undefined, 'en'];

  for (const lang of langs) {
    for (const pcCase of cases) {
      for (const gpu of gpus) {
        paths.push({
          params: { lang, caseSlug: pcCase.slug, gpuSlug: gpu.slug },
          props: { pcCase, gpu }
        });
      }
    }
  }
  return paths;
}

// 2. RECUPERAR DATOS DE LA COMBINACIÓN ACTUAL
const { pcCase, gpu } = Astro.props;
const { lang: langParam } = Astro.params;
const lang = langParam === 'en' ? 'en' : 'es';

if (!pcCase || !gpu) {
  return Astro.redirect('/404');
}

const t = useTranslations(lang);
const langPrefix = lang === 'en' ? '/en' : '';

const currentLang = lang;
const stores = getStoresForLocale(currentLang);

const caseQuery = `${pcCase.brand} ${pcCase.model}`.trim();
const gpuQuery = `${gpu.brand} ${gpu.model}`.trim();

// 3. CÁLCULOS Y ESTADOS
const caseMaxLength = pcCase.maxGpuLengthMM || pcCase.maxGpuLength || 350;
const gpuLength = gpu.dimensions?.lengthMM || gpu.length || gpu.lengthMM || 300;

const margin = caseMaxLength - gpuLength;

let status = 'verde';
let colorHex = '#10b981';
let statusText = lang === 'en' ? 'OPTIMAL CLEARANCE' : 'COMPATIBILIDAD ÓPTIMA';
let statusMessage = lang === 'en' ? 'CLEARANCE CONFIRMED' : 'HOLGURA CONFIRMADA';

if (margin < 0) {
  status = 'rojo';
  colorHex = '#f43f5e';
  statusText = lang === 'en' ? 'PHYSICAL INCOMPATIBILITY' : 'INCOMPATIBILIDAD FÍSICA';
  statusMessage = lang === 'en' ? 'IMMINENT FRONT COLLISION' : 'COLISIÓN FRONTAL INMINENTE';
} else if (margin <= 15) {
  status = 'amarillo';
  colorHex = '#fbbf24';
  statusText = lang === 'en' ? 'TIGHT FIT' : 'COMPATIBILIDAD AJUSTADA';
  statusMessage = lang === 'en' ? 'EXTREMELY TIGHT CLEARANCE' : 'ESPACIO EXTREMADAMENTE REDUCIDO';
}

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');

// 4. SEO: nombres normalizados y respuestas dinámicas
const gpuFullName = `${gpu.brand} ${gpu.model}`;
const caseFullName = `${pcCase.brand} ${pcCase.model}`;
const marginLabel = margin > 0 ? `+${margin}mm` : `${margin}mm`;

const faqAnswerFit = lang === 'en'
  ? (status === 'verde'
    ? `Yes. The ${gpuFullName} (${gpuLength}mm) fits without issue in the ${caseFullName}, which supports up to ${caseMaxLength}mm. There is ${margin}mm of clearance remaining, plenty for comfortable installation and good front airflow.`
    : status === 'amarillo'
    ? `It fits, but very tightly. The ${gpuFullName} measures ${gpuLength}mm and the ${caseFullName} supports up to ${caseMaxLength}mm, leaving only ${margin}mm of clearance. We recommend double-checking measurements before buying.`
    : `No. The ${gpuFullName} (${gpuLength}mm) exceeds the maximum length supported by the ${caseFullName} (${caseMaxLength}mm) by ${Math.abs(margin)}mm. You will need a larger case or a shorter GPU.`)
  : (status === 'verde'
    ? `Sí. La ${gpuFullName} (${gpuLength}mm) entra sin problema en la ${caseFullName}, que admite hasta ${caseMaxLength}mm. Quedan ${margin}mm libres, holgura suficiente para un montaje cómodo y un buen flujo de aire frontal.`
    : status === 'amarillo'
    ? `Entra, pero muy justa. La ${gpuFullName} mide ${gpuLength}mm y la ${caseFullName} admite hasta ${caseMaxLength}mm, dejando solo ${margin}mm de margen. Recomendamos medir dos veces antes de comprar y revisar la gestión de cables.`
    : `No. La ${gpuFullName} (${gpuLength}mm) supera en ${Math.abs(margin)}mm la longitud máxima admitida por la ${caseFullName} (${caseMaxLength}mm). Necesitarás una caja de mayor formato o una gráfica más corta.`);

const radiatorMargin = margin - 25;
const faqAnswerRadiator = lang === 'en'
  ? (radiatorMargin > 0
    ? `Yes, approximately ${radiatorMargin}mm of clearance remains after accounting for front fans (25mm), which is enough for an AIO radiator in most cases.`
    : `Not recommended. After deducting space for front fans (25mm), the actual clearance is insufficient (${radiatorMargin}mm), so a front AIO radiator will likely collide with this GPU.`)
  : (radiatorMargin > 0
    ? `Sí, quedarían aproximadamente ${radiatorMargin}mm libres tras descontar el hueco que ocupan los ventiladores frontales (25mm), suficiente para un radiador AIO en la mayoría de los casos.`
    : `No es recomendable. Una vez descontado el espacio de los ventiladores frontales (25mm), el margen real es insuficiente (${radiatorMargin}mm), por lo que un radiador AIO frontal probablemente no encaje junto a esta gráfica.`);

const metaDescription = `${gpuFullName} (${gpuLength}mm) vs ${caseFullName} (max ${caseMaxLength}mm): ${marginLabel} clearance. ${statusText.toLowerCase()}.`;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: lang === 'en' ? `Does the ${gpuFullName} fit in the ${caseFullName}?` : `¿Cabe la ${gpuFullName} en la ${caseFullName}?`,
      acceptedAnswer: { '@type': 'Answer', text: faqAnswerFit },
    },
    {
      '@type': 'Question',
      name: lang === 'en' ? `How much clearance remains between the ${gpuFullName} and front panel?` : `¿Cuánto margen queda entre la ${gpuFullName} y el frontal del chasis?`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: lang === 'en' ? `Total clearance is ${marginLabel}.` : `El margen total es de ${marginLabel}.`,
      },
    },
    {
      '@type': 'Question',
      name: lang === 'en' ? `Can I install a front AIO radiator with this GPU?` : `¿Puedo instalar un radiador AIO en el frontal con esta gráfica montada?`,
      acceptedAnswer: { '@type': 'Answer', text: faqAnswerRadiator },
    },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: lang === 'en' ? 'Home' : 'Inicio', item: `https://www.lidunax.com${langPrefix}/` },
    { '@type': 'ListItem', position: 2, name: `${caseFullName} vs ${gpuFullName}`, item: canonicalURL.toString() },
  ],
};
---
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{gpu.brand} {gpu.model} vs {pcCase.brand} {pcCase.model} - LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.webp?v=5" />
    <meta name="description" content={metaDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="LIDUNAX" />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="LIDUNAX" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'es_ES'} />
    <meta property="og:title" content={`${gpuFullName} vs ${caseFullName} - LIDUNAX`} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content="https://www.lidunax.com/logo2.webp" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${gpuFullName} vs ${caseFullName}`} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content="https://www.lidunax.com/logo2.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />

    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen font-sans selection:bg-[#00ffff] selection:text-black">
    <style is:global>
      :root {
        --ease-elegant: cubic-bezier(0.16, 1, 0.3, 1);
        --ease-breathe: cubic-bezier(0.45, 0, 0.55, 1);
        --ease-fluid: cubic-bezier(0.22, 1, 0.36, 1);
      }
      @keyframes dashFlow { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -36; } }
      .animate-cable { animation: dashFlow 1.7s linear infinite; }
      @keyframes pulseGlow { 0%, 100% { opacity: 0.9; } 50% { opacity: 0.45; } }
      .animate-glow { animation: pulseGlow 3.4s var(--ease-breathe) infinite; }
      @keyframes ambientPulse { 0%, 100% { opacity: 0.95; } 50% { opacity: 0.6; } }
      .animate-ambient { animation: ambientPulse 5.2s var(--ease-breathe) infinite; }
      @keyframes fanSpin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
      .fan-spin { animation: fanSpin 4s linear infinite; }
      @keyframes breeze { 0% { transform: translateX(0) scaleX(0.85); opacity: 0; } 18% { opacity: 0.55; } 55% { opacity: 0.3; } 100% { transform: translateX(-260px) scaleX(1.05); opacity: 0; } }
      .animate-breeze { animation: breeze 5.5s var(--ease-fluid) infinite; }
      @keyframes whirlwind { 0% { transform: translateY(0) scale(0.92); opacity: 0; } 30% { opacity: 0.32; } 70% { opacity: 0.12; } 100% { transform: translateY(32px) scale(1.15); opacity: 0; } }
      .animate-whirlwind { animation: whirlwind 3.6s var(--ease-fluid) infinite; }
      @keyframes statusBreathe { 0% { transform: scale(1); opacity: 0.55; } 100% { transform: scale(1.9); opacity: 0; } }
      .animate-status-pulse { animation: statusBreathe 2.6s var(--ease-breathe) infinite; }
      @keyframes materialize { from { opacity: 0; transform: scale(0.97); } to { opacity: 1; transform: scale(1); } }
      .animate-materialize { animation: materialize 1.1s var(--ease-elegant) both; animation-delay: 0.1s; transform-origin: center; }
      @keyframes revealFade { from { opacity: 0; transform: translateY(14px); filter: blur(6px); } to { opacity: 1; transform: translateY(0); filter: blur(0); } }
      .animate-reveal { animation: revealFade 0.9s var(--ease-elegant) both; }
      @media (prefers-reduced-motion: reduce) {
        .animate-cable, .animate-glow, .animate-ambient, .fan-spin, .animate-breeze, .animate-whirlwind, .animate-status-pulse, .animate-reveal, .animate-materialize { animation: none !important; }
      }
    </style>

    <header class="border-b border-white/10 bg-black/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href={langPrefix || '/'} class="flex items-center gap-3">
          <img src="/logoancho.webp" alt="LDX" width="160" height="32" class="h-8 w-auto object-contain" />
          <span class="font-orbitron font-bold tracking-widest hidden sm:block">LIDUNAX</span>
        </a>
        <nav class="flex gap-6 text-sm font-orbitron tracking-wider text-slate-400">
          <a href={langPrefix || '/'} class="hover:text-[#00ffff] transition-colors">
            {lang === 'en' ? '← BACK TO SEARCH' : '← VOLVER AL BUSCADOR'}
          </a>
        </nav>
      </div>
    </header>

    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12">
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-bold font-orbitron mb-3 uppercase tracking-wide">
          <span class="text-slate-400 block text-lg mb-1">
            {lang === 'en' ? 'Dimensional Clearance Report' : 'Informe de Compatibilidad Dimensional'}
          </span>
          {pcCase.brand} {pcCase.model}
        </h1>
        <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
          {lang === 'en' ? 'Analyzing volumetric clearance when installing the' : 'Analizando el despeje volumétrico al instalar la tarjeta gráfica'} <strong class="text-white">{gpu.brand} {gpu.model}</strong>.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 mb-12">
        <div class="relative bg-[#0a0a0c] border border-white/5 rounded-[24px] overflow-hidden min-h-[460px] flex items-center justify-center p-4 sm:p-8 shadow-[inset_0_0_80px_rgba(0,0,0,0.8)] animate-reveal">
          <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          
          <svg viewBox="0 0 500 400" class="w-full max-w-[500px] relative z-10 drop-shadow-[0_0_15px_rgba(0,0,0,0.5)] animate-materialize">
            <defs>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="softGlow" x="-60%" y="-60%" width="220%" height="220%">
                <feGaussianBlur stdDeviation="1.4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <linearGradient id="windGradient" x1="0%" y1="0%" x2="100%" y2="0%">
                <stop offset="0%" stop-color="#00ffff" stop-opacity="0" />
                <stop offset="50%" stop-color="#00ffff" stop-opacity="0.9" />
                <stop offset="100%" stop-color="#00ffff" stop-opacity="0" />
              </linearGradient>
              <linearGradient id="heatGradient" x1="0%" y1="0%" x2="0%" y2="100%">
                <stop offset="0%" stop-color={colorHex} stop-opacity="0.85" />
                <stop offset="100%" stop-color={colorHex} stop-opacity="0" />
              </linearGradient>
              <pattern id="dotPattern" x="0" y="0" width="8" height="8" patternUnits="userSpaceOnUse">
                <rect x="0" y="0" width="3" height="3" fill="white" opacity="0.3"/>
              </pattern>
            </defs>

            <g transform="translate(50, 40)">
              <path class="animate-ambient" d="M 20 0 L 380 0 L 400 20 L 400 280 L 380 300 L 20 300 L 0 280 L 0 20 Z" fill="none" stroke={colorHex} stroke-width="3" filter="url(#glow)"/>
              <path d="M 25 10 L 375 10 L 390 25 L 390 275 L 375 290 L 25 290 L 10 275 L 10 25 Z" fill="none" stroke={colorHex} stroke-width="1" opacity="0.4"/>
              
              <path d="M 40 300 L 60 320 L 100 320 L 100 300 Z" fill="#111" stroke={colorHex} stroke-width="1.5" />
              <path d="M 300 300 L 300 320 L 340 320 L 360 300 Z" fill="#111" stroke={colorHex} stroke-width="1.5" />
              <rect x="382" y="40" width="10" height="220" fill="none" stroke={colorHex} stroke-width="1" stroke-dasharray="4 4" opacity="0.3"/>
              
              <rect x="25" y="30" width="220" height="190" rx="4" fill="none" stroke="white" stroke-width="1" stroke-opacity="0.15"/>
              <text x="35" y="48" fill="#444" font-family="Orbitron" font-size="9" letter-spacing="1.5">{lang === 'en' ? 'CASE' : 'CHASIS'}</text>
              {(() => {
                const caseLabelAvailableWidth = 195;
                const caseLabelBaseFontSize = 11;
                const caseLabelAvgCharWidth = 0.58;
                const caseLabelEstWidth = caseFullName.length * caseLabelBaseFontSize * caseLabelAvgCharWidth;
                const caseLabelFontSize =
                  caseLabelEstWidth > caseLabelAvailableWidth
                    ? Math.max(6.5, (caseLabelAvailableWidth / caseFullName.length) / caseLabelAvgCharWidth)
                    : caseLabelBaseFontSize;
                return (
                  <text
                    x="35"
                    y="68"
                    fill="#9ca3af"
                    font-family="Orbitron"
                    font-size={caseLabelFontSize}
                    font-weight="600"
                    letter-spacing="0.5"
                    textLength={caseLabelEstWidth > caseLabelAvailableWidth ? caseLabelAvailableWidth : undefined}
                    lengthAdjust="spacingAndGlyphs"
                  >{caseFullName}</text>
                );
              })()}

              <g opacity="0.5">
                <g class="fan-spin" style="transform-origin: 366px 80px; animation-duration: 4s;">
                  <circle cx="366" cy="80" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 64 L 366 96 M 350 80 L 382 80 M 355 69 L 377 91 M 355 91 L 377 69" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
                <g class="fan-spin" style="transform-origin: 366px 145px; animation-duration: 4.6s;">
                  <circle cx="366" cy="145" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 129 L 366 161 M 350 145 L 382 145 M 355 134 L 377 156 M 355 156 L 377 134" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
                <g class="fan-spin" style="transform-origin: 366px 210px; animation-duration: 4.3s;">
                  <circle cx="366" cy="210" r="16" fill="none" stroke={colorHex} stroke-width="1" opacity="0.3"/>
                  <path d="M 366 194 L 366 226 M 350 210 L 382 210 M 355 199 L 377 221 M 355 221 L 377 199" stroke={colorHex} stroke-width="1.5" opacity="0.5"/>
                </g>
              </g>

              <g stroke="url(#windGradient)" stroke-width="1.3" fill="none" stroke-linecap="round" filter="url(#softGlow)">
                <path d="M 340 80 Q 250 82 150 75" class="animate-breeze" style="animation-delay: 0s;" opacity="0"/>
                <path d="M 340 145 Q 250 145 150 145" class="animate-breeze" style="animation-delay: 1.5s;" opacity="0"/>
                <path d="M 340 210 Q 250 208 150 215" class="animate-breeze" style="animation-delay: 3s;" opacity="0"/>
                <path d="M 340 110 Q 250 110 150 110" class="animate-breeze" style="animation-delay: 0.8s;" opacity="0"/>
                <path d="M 340 175 Q 250 175 150 175" class="animate-breeze" style="animation-delay: 2.2s;" opacity="0"/>
              </g>

              {(() => {
                const maxGpuWidthSvg = 325; 
                const gpuWidthSvg = Math.min((gpuLength / caseMaxLength) * maxGpuWidthSvg, maxGpuWidthSvg);
                const whirlwinds = Array.from({ length: Math.floor(gpuWidthSvg / 50) });

                const gpuLabelPadding = 20;
                const gpuLabelAvailableWidth = Math.max(gpuWidthSvg - 30, 60);
                const gpuLabelBaseFontSize = 11;
                const gpuLabelAvgCharWidth = 0.62;
                const gpuLabelEstWidth = gpuFullName.length * gpuLabelBaseFontSize * gpuLabelAvgCharWidth;
                const gpuLabelFontSize =
                  gpuLabelEstWidth > gpuLabelAvailableWidth
                    ? Math.max(6.5, (gpuLabelAvailableWidth / gpuFullName.length) / gpuLabelAvgCharWidth)
                    : gpuLabelBaseFontSize;
                const gpuLabelBoxWidth = Math.min(
                  gpuLabelAvailableWidth + gpuLabelPadding,
                  Math.max(140, gpuLabelEstWidth + gpuLabelPadding)
                );

                return (
                  <g transform="translate(15, 170)">
                    <path d={`M ${gpuWidthSvg - 45} 0 C ${gpuWidthSvg - 30} -40, ${gpuWidthSvg + 20} 50, ${gpuWidthSvg + 10} 120`} fill="none" stroke={colorHex} stroke-width="3" stroke-dasharray="10 8" class="animate-cable" filter="url(#glow)"/>
                    <path d={`M ${gpuWidthSvg - 35} 0 C ${gpuWidthSvg - 20} -40, ${gpuWidthSvg + 30} 50, ${gpuWidthSvg + 20} 120`} fill="none" stroke={colorHex} stroke-width="3" stroke-dasharray="10 8" class="animate-cable" filter="url(#glow)"/>
                    
                    <rect x={gpuWidthSvg - 50} y="-12" width="22" height="12" rx="2" fill="#111" stroke={colorHex} stroke-width="1.5"/>

                    <rect x="0" y="0" width={gpuWidthSvg} height="40" rx="4" fill="#0d1117" stroke={colorHex} stroke-width="2" filter="url(#glow)"/>
                    <rect x="15" y="10" width={gpuWidthSvg - 30} height="20" fill="url(#dotPattern)" />
                    
                    <rect x={(gpuWidthSvg / 2) - (gpuLabelBoxWidth / 2)} y="10" width={gpuLabelBoxWidth} height="20" fill="#0d1117" rx="2" />
                    <text
                      x={gpuWidthSvg / 2}
                      y="24"
                      fill="white"
                      font-family="Orbitron"
                      font-size={gpuLabelFontSize}
                      font-weight="bold"
                      text-anchor="middle"
                      letter-spacing="0.5"
                      textLength={gpuLabelEstWidth > gpuLabelAvailableWidth ? gpuLabelAvailableWidth : undefined}
                      lengthAdjust="spacingAndGlyphs"
                    >{gpuFullName}</text>

                    <g stroke="url(#heatGradient)" stroke-width="1.3" fill="none" stroke-linecap="round">
                      {whirlwinds.map((_, i) => {
                        const startX = 25 + i * 50;
                        const delay = i * 0.6;
                        return (
                          <path 
                            d={`M ${startX} 42 C ${startX - 15} 55, ${startX + 15} 65, ${startX - 5} 78`} 
                            class="animate-whirlwind" 
                            style={`animation-delay: ${delay}s;`} 
                            opacity="0"
                          />
                        );
                      })}
                    </g>

                    <g transform={`translate(${gpuWidthSvg + 15}, 0)`}>
                      <line x1="0" y1="20" x2="35" y2="20" stroke={colorHex} stroke-width="1.5" stroke-dasharray="4 4" class="animate-glow"/>
                      <rect x="15" y="5" width="60" height="26" rx="13" fill="#0d1117" stroke={colorHex} stroke-width="1.5" filter="url(#glow)"/>
                      <text x="45" y="22" fill={colorHex} font-family="Orbitron" font-size="11" font-weight="bold" text-anchor="middle">{margin > 0 ? `+${margin}mm` : `${margin}mm`}</text>
                    </g>
                  </g>
                );
              })()}
            </g>
          </svg>
        </div>

        <div class="flex flex-col gap-4">
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-xl relative overflow-hidden animate-reveal" style="animation-delay: 0.12s;">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${colorHex}`}></div>
            
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-status-pulse absolute inline-flex h-full w-full rounded-full" style={`background-color: ${colorHex}`}></span>
                <span class="relative inline-flex rounded-full h-3 w-3" style={`background-color: ${colorHex}`}></span>
              </span>
              <h2 class="font-orbitron font-bold tracking-widest text-sm uppercase" style={`color: ${colorHex}`}>
                {statusText}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">
                  {lang === 'en' ? 'MAX LENGTH' : 'LONGITUD MÁXIMA'}
                </span>
                <span class="font-orbitron font-bold text-2xl text-white">{caseMaxLength} <small class="text-[0.5em] text-slate-400">mm</small></span>
              </div>
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">
                  {lang === 'en' ? 'TOTAL MARGIN' : 'MARGEN TOTAL'}
                </span>
                <span class="font-orbitron font-bold text-2xl" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin}` : margin} <small class="text-[0.5em]">mm</small></span>
              </div>
            </div>
          </div>

          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-2xl flex flex-col justify-between flex-1 animate-reveal" style="animation-delay: 0.22s;">
            <h3 class="font-orbitron text-xs tracking-[0.2em] text-slate-400 mb-4 uppercase">
              {lang === 'en' ? 'CHECK AVAILABILITY:' : 'COMPROBAR HARDWARE:'}
            </h3>

            <div class="space-y-3">
              {stores.map((store) => (
                <div class="relative bg-white/[0.02] border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10 overflow-hidden">
                  <div class="flex items-center justify-between mb-3">
                    <span class="font-orbitron text-xs font-bold tracking-wider text-white uppercase">
                      {store.name}
                    </span>
                  </div>

                  <div class="grid grid-cols-2 gap-3">
                    <a
                      href={store.buildUrl(caseQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>{lang === 'en' ? 'Case' : 'Caja'}</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                    <a
                      href={store.buildUrl(gpuQuery)}
                      target="_blank"
                      rel="nofollow noopener noreferrer"
                      class="font-orbitron text-xs py-2.5 px-3 bg-white/[0.04] hover:bg-white/10 border border-white/5 hover:border-white/20 rounded-xl text-center text-slate-300 hover:text-white transition-all flex items-center justify-center gap-1.5"
                    >
                      <span>GPU</span>
                      <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  </div>

                  <div 
                    class="absolute bottom-0 left-0 right-0 h-[2px]" 
                    style={`background: linear-gradient(90deg, transparent 0%, ${store.color} 50%, transparent 100%);`}
                  ></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold font-orbitron mb-6 mt-12">
        {lang === 'en' ? 'Compared Dimension Metrics' : 'Métricas de Dimensiones Comparadas'}
      </h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] overflow-hidden mb-12 text-sm sm:text-base">
        <div class="grid grid-cols-4 px-6 py-4 border-b border-white/5 text-[10px] sm:text-xs font-orbitron text-[#00ffff] tracking-widest uppercase">
          <div>{lang === 'en' ? 'Parameter' : 'Parámetro'}</div>
          <div>{lang === 'en' ? 'Chassis' : 'Chasis'}</div>
          <div>{lang === 'en' ? 'GPU Card' : 'Tarjeta GPU'}</div>
          <div>{lang === 'en' ? 'Margin' : 'Margen'}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center">
          <div class="font-bold">{lang === 'en' ? 'Max Length' : 'Longitud Máxima'}</div>
          <div class="text-slate-300">{caseMaxLength} mm</div>
          <div class="text-slate-300">{gpuLength} mm</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin} mm` : `${margin} mm`}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 items-center bg-white/[0.02]">
          <div class="font-bold">{lang === 'en' ? 'Front Clearance' : 'Holgura con Frontal'}</div>
          <div class="text-slate-300">- 25 mm ({lang === 'en' ? 'Fans' : 'Ventiladores'})</div>
          <div class="text-slate-300">-</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>
            {margin - 25 > 0 ? `+${margin - 25} mm ${lang === 'en' ? 'Free' : 'Libres'}` : (lang === 'en' ? 'Tight / Collision' : 'Ajustado / Colisión')}
          </div>
        </div>
      </div>

      <h2 class="text-2xl font-bold font-orbitron mb-6">{lang === 'en' ? 'Assembly Analysis' : 'Análisis de Ensamblaje'}</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] p-6 sm:p-8 mb-16 text-slate-300 leading-relaxed">
        <p class="mb-6">
          {lang === 'en' 
            ? `When installing the ${gpu.brand} ${gpu.model} (${gpuLength} mm length) inside the ${pcCase.brand} ${pcCase.model} chassis, the remaining front space is ${margin > 0 ? `+${margin}` : margin} mm.`
            : `Al instalar la ${gpu.brand} ${gpu.model} (longitud de ${gpuLength} mm) dentro del chasis ${pcCase.brand} ${pcCase.model}, el espacio frontal restante es de ${margin > 0 ? `+${margin}` : margin} mm.`}
        </p>

        <div class="bg-[#111] border border-white/10 rounded-xl p-5 mb-6">
          <strong class="font-orbitron text-[11px] text-white tracking-widest uppercase mb-2 block">
            {lang === 'en' ? 'CABLE MANAGEMENT (12VHPWR):' : 'GESTIÓN DE CABLEADO (12VHPWR):'}
          </strong>
          <p class="text-sm">
            {lang === 'en' 
              ? 'Due to this GPU connector and its rigidity, we recommend using a 90º angled cable or side adapter to avoid pressing pins against the side glass panel.'
              : 'Debido al conector de esta gráfica y su rigidez, recomendamos usar un cable acodado a 90º o adaptador lateral para evitar presionar los pines contra el cristal templado lateral.'}
          </p>
        </div>
      </div>

      <h2 class="text-2xl font-bold font-orbitron mb-6">{lang === 'en' ? 'Frequently Asked Questions' : 'Preguntas Frecuentes'}</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] mb-16 divide-y divide-white/5">
        <details class="group p-6 sm:p-8">
          <summary class="cursor-pointer font-orbitron text-sm sm:text-base text-white list-none flex justify-between items-center gap-4">
            {lang === 'en' ? `Does the ${gpu.brand} ${gpu.model} fit in the ${pcCase.brand} ${pcCase.model}?` : `¿Cabe la ${gpu.brand} ${gpu.model} en la ${pcCase.brand} ${pcCase.model}?`}
            <span class="text-slate-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="text-slate-300 text-sm leading-relaxed mt-4">{faqAnswerFit}</p>
        </details>
        <details class="group p-6 sm:p-8">
          <summary class="cursor-pointer font-orbitron text-sm sm:text-base text-white list-none flex justify-between items-center gap-4">
            {lang === 'en' ? 'How much clearance remains between the GPU and front panel?' : '¿Cuánto margen queda entre la gráfica y el frontal del chasis?'}
            <span class="text-slate-500 group-open:rotate-45 transition-transform text-xl leading-none shrink-0">+</span>
          </summary>
          <p class="text-slate-300 text-sm leading-relaxed mt-4">
            {lang === 'en' ? 'Total clearance is' : 'El margen total es de'} <strong style={`color: ${colorHex}`}>{marginLabel}</strong>.
          </p>
        </details>
      </div>

    </main>

    <Footer />
  </body>
</html>