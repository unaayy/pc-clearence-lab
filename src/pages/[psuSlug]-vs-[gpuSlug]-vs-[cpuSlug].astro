---
// src/pages/[psuSlug]-vs-[gpuSlug]-vs-[cpuSlug].astro
import hardwareData from '../data/hardware.json';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

// 1. GENERADOR DE RUTAS DINÁMICAS (pSEO)
export async function getStaticPaths() {
  const psus = (hardwareData.psus && hardwareData.psus.length > 0) 
    ? hardwareData.psus 
    : [{ slug: 'corsair-rm850e', brand: 'Corsair', model: 'RM850e', wattage: 850, has12VHPWR: true }];

  const gpus = (hardwareData.gpus && hardwareData.gpus.length > 0) 
    ? hardwareData.gpus 
    : [{ slug: 'rtx-4090', brand: 'NVIDIA', model: 'RTX 4090', tdp: 450 }];

  const cpus = (hardwareData.cpus && hardwareData.cpus.length > 0) 
    ? hardwareData.cpus 
    : [{ slug: 'core-i9-14900k', brand: 'Intel', model: 'Core i9-14900K', tdp: 253 }];

  const paths = [];
  for (const psu of psus) {
    for (const gpu of gpus) {
      for (const cpu of cpus) {
        paths.push({
          params: { 
            psuSlug: psu.slug, 
            gpuSlug: gpu.slug, 
            cpuSlug: cpu.slug 
          },
          props: { psu, gpu, cpu }
        });
      }
    }
  }
  return paths;
}

// 2. RECUPERAR DATOS DE LA COMBINACIÓN ACTUAL
const { psu, gpu, cpu } = Astro.props;

// 3. MOTOR DE CÁLCULO ENERGÉTICO
const overhead = 80; // Placa base, RAM, SSD, ventiladores
const rawDemand = (gpu.tdp || gpu.watts || 250) + (cpu.tdp || cpu.watts || 120) + overhead;
const recommendedDemand = Math.ceil(rawDemand * 1.25); // Margen de seguridad +25%
const psuPower = psu.wattage || psu.watts || 750;
const margin = psuPower - recommendedDemand;

// Lógica de colores semáforo
let status = 'verde';
let colorHex = '#10b981'; // Emerald
let statusText = 'POTENCIA ÓPTIMA';
let statusMessage = 'FLUJO ENERGÉTICO ESTABLE';

if (margin < 0) {
  status = 'rojo';
  colorHex = '#f43f5e'; // Rose
  statusText = 'POTENCIA INSUFICIENTE';
  statusMessage = 'DÉFICIT ENERGÉTICO CRÍTICO';
} else if (margin < 100) {
  status = 'amarillo';
  colorHex = '#fbbf24'; // Amber
  statusText = 'POTENCIA AL LÍMITE';
  statusMessage = 'ADVERTENCIA DE SOBRECARGA';
}

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Soporta la {psu.brand} {psu.model} a la {gpu.brand} {gpu.model} y {cpu.model}? - LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.png?v=5" />
    <meta name="description" content={`Análisis técnico de consumo: Comprueba si los ${psuPower}W de la fuente ${psu.brand} ${psu.model} son suficientes para alimentar una ${gpu.brand} ${gpu.model} y un procesador ${cpu.model}.`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="canonical" href={canonicalURL} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen font-sans selection:bg-[#00ffff] selection:text-black">
    
    <!-- Navbar -->
    <header class="border-b border-white/10 bg-black/50 backdrop-blur-md sticky top-0 z-50">
      <div class="max-w-[1200px] mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-3">
          <img src="/logoancho.png" alt="LDX" class="h-8 w-auto object-contain" />
          <span class="font-orbitron font-bold tracking-widest hidden sm:block">LIDUNAX</span>
        </a>
        <nav class="flex gap-6 text-sm font-orbitron tracking-wider text-slate-400">
          <a href="/fuente-psu" class="hover:text-[#00ffff] transition-colors">← VOLVER AL BUSCADOR</a>
        </nav>
      </div>
    </header>

    <main class="max-w-[1200px] mx-auto px-4 sm:px-6 py-12">
      
      <!-- Encabezado del reporte -->
      <div class="mb-10 text-center sm:text-left">
        <h1 class="text-3xl sm:text-4xl font-bold font-orbitron mb-3 uppercase tracking-wide">
          <span class="text-slate-400 block text-lg mb-1">Informe de Telemetría Energética</span>
          {psu.brand} {psu.model}
        </h1>
        <p class="text-slate-400 max-w-2xl text-sm sm:text-base">
          Consumo combinado con la gráfica <strong class="text-white">{gpu.brand} {gpu.model}</strong> y el procesador <strong class="text-white">{cpu.brand} {cpu.model}</strong>.
        </p>
      </div>

      <!-- Diagrama visual y panel de diagnóstico -->
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-6 mb-12">
        
        <!-- DIAGRAMA VISUAL ESQUEMÁTICO (Hardware Dibujado) -->
        <div class="relative bg-[#0a0a0c] border border-white/5 rounded-[24px] overflow-hidden min-h-[460px] flex items-center justify-center p-4 sm:p-8 shadow-[inset_0_0_80px_rgba(0,0,0,0.8)]">
          <div class="absolute inset-0 opacity-[0.15]" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          
          <svg viewBox="0 0 400 420" class="w-full max-w-[460px] relative z-10 drop-shadow-[0_0_15px_rgba(0,0,0,0.5)]">
            <defs>
              <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                <feGaussianBlur stdDeviation="4" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
              <filter id="softGlow">
                <feGaussianBlur stdDeviation="2" result="blur" />
                <feMerge>
                  <feMergeNode in="blur" />
                  <feMergeNode in="SourceGraphic" />
                </feMerge>
              </filter>
            </defs>

            <!-- CABLES ANIMADOS: Fluyen desde la PSU hacia GPU y CPU -->
            <path d="M 200 280 C 200 200 100 210 100 130" fill="none" stroke={colorHex} stroke-width="4" filter="url(#glow)" stroke-dasharray="10 8" class="animate-[dash_1s_linear_infinite]" />
            <path d="M 200 280 C 200 200 300 210 300 150" fill="none" stroke={colorHex} stroke-width="4" filter="url(#glow)" stroke-dasharray="10 8" class="animate-[dash_1s_linear_infinite]" />

            <!-- ==================== DIBUJO GPU (Izquierda) ==================== -->
            <g transform="translate(30, 80)">
              <text x="70" y="-22" fill="white" font-family="Orbitron" font-size="14" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{gpu.tdp || gpu.watts}W</text>
              <text x="70" y="-8" fill="#888" font-family="monospace" font-size="9" text-anchor="middle" letter-spacing="1">TDP GPU</text>
              
              <!-- Chasis GPU -->
              <rect x="0" y="0" width="140" height="50" rx="4" fill="#0d1117" stroke="white" stroke-width="1.5" stroke-opacity="0.3"/>
              <!-- Línea superior detallada -->
              <path d="M 10 0 L 130 0" stroke="white" stroke-width="2" stroke-opacity="0.6" />
              
              <!-- 3 Ventiladores -->
              <circle cx="25" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="70" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="115" cy="25" r="14" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              
              <!-- Aspas cruzadas -->
              <path d="M 25 11 L 25 39 M 11 25 L 39 25" stroke="white" stroke-opacity="0.1" />
              <path d="M 70 11 L 70 39 M 56 25 L 84 25" stroke="white" stroke-opacity="0.1" />
              <path d="M 115 11 L 115 39 M 101 25 L 129 25" stroke="white" stroke-opacity="0.1" />

              <!-- Puerto PCIe inferior -->
              <rect x="30" y="50" width="60" height="4" fill="#0d1117" stroke="white" stroke-opacity="0.4" stroke-width="1"/>
            </g>

            <!-- ==================== DIBUJO CPU (Derecha) ==================== -->
            <g transform="translate(265, 80)">
              <text x="35" y="-22" fill="white" font-family="Orbitron" font-size="14" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{cpu.tdp || cpu.watts}W</text>
              <text x="35" y="-8" fill="#888" font-family="monospace" font-size="9" text-anchor="middle" letter-spacing="1">TDP CPU</text>

              <!-- Placa del procesador -->
              <rect x="0" y="0" width="70" height="70" rx="4" fill="#0d1117" stroke="white" stroke-width="1.5" stroke-opacity="0.3"/>
              
              <!-- Muesca de Socket -->
              <polygon points="4,4 10,4 4,10" fill="white" fill-opacity="0.4"/>
              
              <!-- Pines/Contactos laterales -->
              <path d="M -2 10 L -2 60 M 72 10 L 72 60" stroke="white" stroke-opacity="0.4" stroke-width="2" stroke-dasharray="2 3"/>
              
              <!-- IHS (Cápsula térmica) -->
              <rect x="12" y="12" width="46" height="46" rx="4" fill="#151b23" stroke="white" stroke-width="1" stroke-opacity="0.4"/>
              <rect x="20" y="20" width="30" height="30" rx="2" fill="none" stroke="white" stroke-opacity="0.1" stroke-width="1"/>
            </g>

            <!-- ==================== DIBUJO PSU (Centro Abajo) ==================== -->
            <g transform="translate(130, 280)">
              <!-- Chasis Principal de la Fuente -->
              <rect x="0" y="0" width="140" height="80" rx="6" fill="#0d1117" stroke={colorHex} stroke-width="2.5" filter="url(#glow)"/>
              
              <!-- Ventilador interno (Rejilla) -->
              <circle cx="50" cy="40" r="28" fill="#151b23" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <circle cx="50" cy="40" r="10" fill="none" stroke="white" stroke-opacity="0.2" stroke-width="1"/>
              <!-- Patrón de rejas -->
              <path d="M 22 40 L 78 40 M 50 12 L 50 68 M 30 20 L 70 60 M 30 60 L 70 20" stroke="white" stroke-opacity="0.1" stroke-width="1.5"/>

              <!-- Panel trasero de conectores -->
              <rect x="110" y="15" width="16" height="24" rx="2" fill="none" stroke="white" stroke-opacity="0.3"/>
              <rect x="114" y="20" width="8" height="4" fill="white" fill-opacity="0.4"/>
              <rect x="114" y="28" width="8" height="4" fill="white" fill-opacity="0.4"/>
              <!-- Switch de encendido -->
              <rect x="110" y="50" width="16" height="16" rx="2" fill="#151b23" stroke="white" stroke-opacity="0.3"/>
              <circle cx="118" cy="58" r="3" fill="white" fill-opacity="0.5"/>

              <text x="70" y="112" fill="white" font-family="Orbitron" font-size="16" font-weight="bold" text-anchor="middle" filter="url(#softGlow)">{psuPower}W</text>
              <text x="70" y="128" fill={colorHex} font-family="monospace" font-size="10" text-anchor="middle" letter-spacing="1">FUENTE PSU</text>
            </g>

            <!-- ==================== BADGE CENTRAL (MARGEN ENERGÉTICO) ==================== -->
            <g transform="translate(155, 200)">
              <!-- Píldora de fondo -->
              <rect x="0" y="0" width="90" height="26" rx="13" fill="#0d1117" stroke={colorHex} stroke-width="1.5" filter="url(#glow)"/>
              <text x="45" y="17" fill={colorHex} font-family="monospace" font-size="11" font-weight="bold" text-anchor="middle">{margin > 0 ? `+${margin}W` : `${margin}W`}</text>
            </g>

          </svg>

          <style>
            /* Animación de pulsos de energía fluyendo desde la fuente (dashoffset negativo) */
            @keyframes dash {
              from { stroke-dashoffset: 0; }
              to { stroke-dashoffset: -36; }
            }
          </style>
        </div>

        <!-- Panel lateral de estado y disponibilidad -->
        <div class="flex flex-col gap-4">
          
          <!-- TARJETA DE DIAGNÓSTICO -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-xl relative overflow-hidden">
            <div class="absolute top-0 left-0 w-full h-1" style={`background-color: ${colorHex}`}></div>
            
            <div class="flex items-center gap-3 mb-6">
              <span class="relative flex h-3 w-3">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full opacity-75" style={`background-color: ${colorHex}`}></span>
                <span class="relative inline-flex rounded-full h-3 w-3" style={`background-color: ${colorHex}`}></span>
              </span>
              <h2 class="font-orbitron font-bold tracking-widest text-sm uppercase" style={`color: ${colorHex}`}>
                {statusMessage}
              </h2>
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">DEMANDA ESTIMADA</span>
                <span class="font-orbitron font-bold text-2xl text-white">{recommendedDemand} <small class="text-[0.5em] text-slate-400">W</small></span>
              </div>
              <div>
                <span class="block text-[10px] text-slate-500 uppercase tracking-widest font-mono mb-1">MARGEN LIBRE</span>
                <span class="font-orbitron font-bold text-2xl" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin}` : margin} <small class="text-[0.5em]">W</small></span>
              </div>
            </div>
          </div>

          <!-- ESCÁNER DE DISPONIBILIDAD (Estilo 100% Orbitron y colores oscuros) -->
          <div class="bg-[#0a0a0c] border border-white/5 rounded-[24px] p-6 shadow-2xl flex flex-col justify-between flex-1">
            <h3 class="font-orbitron text-xs tracking-[0.2em] text-slate-400 mb-4 uppercase">
              ESCÁNER DE DISPONIBILIDAD:
            </h3>

            <div class="space-y-3">
              <!-- AMAZON ES -->
              <div class="bg-[#141210]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-xs font-bold tracking-wider text-white block mb-3 uppercase">
                  AMAZON ES
                </span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    Fuente →
                  </a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    GPU →
                  </a>
                </div>
              </div>

              <!-- PCCOMPONENTES -->
              <div class="bg-[#18120d]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-xs font-bold tracking-wider text-white block mb-3 uppercase">
                  PCCOMPONENTES
                </span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    Fuente →
                  </a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    GPU →
                  </a>
                </div>
              </div>

              <!-- COOLMOD -->
              <div class="bg-[#0e111a]/90 border border-white/5 rounded-2xl p-4 transition-all hover:border-white/10">
                <span class="font-orbitron text-xs font-bold tracking-wider text-white block mb-3 uppercase">
                  COOLMOD
                </span>
                <div class="grid grid-cols-2 gap-3">
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    Fuente →
                  </a>
                  <a href="#" class="font-orbitron text-xs py-2.5 px-4 bg-white/[0.04] hover:bg-[#00ffff]/10 border border-white/5 hover:border-[#00ffff]/30 rounded-xl text-center text-slate-300 hover:text-[#00ffff] transition-all">
                    GPU →
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>

      </div>

      <!-- Tabla de Métricas -->
      <h2 class="text-2xl font-bold font-orbitron mb-6 mt-12">Métricas de Dimensiones Comparadas</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] overflow-hidden mb-12 text-sm sm:text-base">
        <div class="grid grid-cols-4 px-6 py-4 border-b border-white/5 text-[10px] sm:text-xs font-orbitron text-[#00ffff] tracking-widest uppercase">
          <div>Parámetro</div>
          <div>Fuente PSU</div>
          <div>Hardware (CPU+GPU)</div>
          <div>Diagnóstico</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center">
          <div class="font-bold">Potencia Nominal</div>
          <div class="text-slate-300">{psuPower} W</div>
          <div class="text-slate-300">{rawDemand} W (Bruto)</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{status === 'rojo' ? 'INSUFICIENTE' : 'OK'}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 border-b border-white/5 items-center bg-white/[0.02]">
          <div class="font-bold">Picos Transitorios</div>
          <div class="text-slate-300">Soporte ATX</div>
          <div class="text-slate-300">{recommendedDemand} W (+25%)</div>
          <div class="font-orbitron font-bold" style={`color: ${colorHex}`}>{margin > 0 ? `+${margin} W LIBRES` : `${margin} W DÉFICIT`}</div>
        </div>

        <div class="grid grid-cols-4 px-6 py-5 items-center">
          <div class="font-bold">Conector PCIe</div>
          <div class="text-slate-300">{psu.has12VHPWR ? '12VHPWR Nativo' : 'Clásico 8-pin'}</div>
          <div class="text-slate-300">{(gpu.tdp || gpu.watts) > 280 ? 'Requiere 12VHPWR' : 'Estándar'}</div>
          <div class="font-orbitron font-bold">
            {!psu.has12VHPWR && (gpu.tdp || gpu.watts) > 280 ? <span class="text-amber-400">Adaptador Necesario</span> : <span class="text-emerald-400">Compatible</span>}
          </div>
        </div>
      </div>

      <!-- Análisis narrativo de ensamblaje (SEO) -->
      <h2 class="text-2xl font-bold font-orbitron mb-6">Análisis de Ensamblaje</h2>
      <div class="bg-[#0a0a0c] border border-white/5 rounded-[20px] p-6 sm:p-8 mb-16 text-slate-300 leading-relaxed">
        <p class="mb-6">
          Al emparejar la fuente de alimentación <strong class="text-white">{psu.brand} {psu.model}</strong> de <strong class="text-[#00ffff]">{psuPower}W</strong> con el procesador <strong class="text-white">{cpu.brand} {cpu.model}</strong> y la tarjeta gráfica <strong class="text-white">{gpu.brand} {gpu.model}</strong>, la demanda eléctrica de pico alcanza los <strong>{recommendedDemand}W</strong>.
        </p>

        <div class="bg-[#111] border border-white/10 rounded-xl p-5 mb-6">
          <strong class="font-orbitron text-[11px] text-white tracking-widest uppercase mb-2 block">GESTIÓN DE PICOS DE TENSIÓN:</strong>
          <p class="text-sm">
            Para evitar disparos intempestivos del OCP/OPP provocados por los picos transitorios de potencia de las GPUs modernas, Lidunax evalúa un margen de seguridad del 25% por encima del consumo teórico.
          </p>
        </div>

        <ul class="space-y-3 text-sm">
          {status === 'verde' && (
            <li class="flex items-start gap-2 text-emerald-400">
              <span>↳</span> <span class="text-slate-300"><strong class="text-emerald-400 font-normal">Capacidad holgada:</strong> Cuentas con {margin}W de reserva. La fuente trabajará en su zona de máxima eficiencia energética (50%-70% de carga) reduciendo ruido y temperatura.</span>
            </li>
          )}
          {status === 'amarillo' && (
            <li class="flex items-start gap-2 text-amber-400">
              <span>↳</span> <span class="text-slate-300"><strong class="text-amber-400 font-normal">Carga elevada:</strong> La fuente podrá alimentar el equipo, pero operará cerca del límite térmico bajo cargas de trabajo pesadas.</span>
            </li>
          )}
          {status === 'rojo' && (
            <li class="flex items-start gap-2 text-rose-500">
              <span>↳</span> <span class="text-slate-300"><strong class="text-rose-500 font-normal">Sobrecarga detectada:</strong> Hay un déficit de {Math.abs(margin)}W. Sufrirás apagados de protección cuando la GPU y la CPU alcancen su frecuencia Boost máxima simultáneamente.</span>
            </li>
          )}
          {!psu.has12VHPWR && (gpu.tdp || gpu.watts) > 280 && (
            <li class="flex items-start gap-2 text-amber-400">
              <span>↳</span> <span class="text-slate-300"><strong class="text-amber-400 font-normal">Advertencia de cables:</strong> La gráfica requiere un conector 12VHPWR que esta fuente no tiene de forma nativa. Necesitarás usar el adaptador "pulpo" incluido en la caja de la GPU.</span>
            </li>
          )}
        </ul>
      </div>

    </main>

    <Footer />
  </body>
</html>