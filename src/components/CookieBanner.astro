---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const langPrefix = lang === 'en' ? '/en' : '';
const isEn = lang === 'en';
---

<div id="cookie-banner" class="fixed bottom-0 left-0 w-full bg-slate-950/95 border-t border-white/10 backdrop-blur-md z-[100] transition-transform duration-500 translate-y-full pointer-events-none">
  <div class="max-w-6xl mx-auto px-6 py-4 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-sm pointer-events-auto">
    <div class="text-slate-300">
      <p>
        <strong>Lidunax</strong> {isEn 
          ? 'uses technical and third-party cookies (Google AdSense, Amazon Associates) to analyze traffic and show personalized advertising. By continuing to browse, you accept our'
          : 'utiliza cookies técnicas y de terceros (Google AdSense, Amazon Afiliados) para analizar el tráfico y mostrar publicidad personalizada. Al continuar navegando, aceptas nuestra'}
        <a href={`${langPrefix}/privacidad`} class="text-[#00F0FF] hover:underline">
          {isEn ? 'Privacy Policy' : 'Política de Privacidad'}
        </a> 
        {isEn ? 'and the use of cookies.' : 'y el uso de cookies.'}
      </p>
    </div>
    <div class="flex items-center gap-3 shrink-0">
      <button id="btn-rechazar" type="button" class="px-4 py-2 rounded-lg text-slate-400 hover:text-white border border-transparent hover:border-white/10 transition">
        {isEn ? 'Reject' : 'Rechazar'}
      </button>
      <button id="btn-aceptar" type="button" class="px-5 py-2 rounded-lg bg-[#00F0FF]/10 text-[#00F0FF] border border-[#00F0FF]/50 hover:bg-[#00F0FF] hover:text-black font-bold transition">
        {isEn ? 'Accept Cookies' : 'Aceptar Cookies'}
      </button>
    </div>
  </div>
</div>

<script>
  const initCookieBanner = () => {
    const banner = document.getElementById('cookie-banner');
    const btnAceptar = document.getElementById('btn-aceptar');
    const btnRechazar = document.getElementById('btn-rechazar');

    if (!banner || !btnAceptar || !btnRechazar) return;

    if (!localStorage.getItem('lidunax_cookies_accepted')) {
      banner.classList.remove('translate-y-full', 'pointer-events-none');
    }

    const ocultarBanner = (accepted: boolean) => {
      localStorage.setItem('lidunax_cookies_accepted', String(accepted));
      banner.classList.add('translate-y-full', 'pointer-events-none');
    };

    btnAceptar.onclick = () => ocultarBanner(true);
    btnRechazar.onclick = () => ocultarBanner(false);
  };

  initCookieBanner();
  document.addEventListener('astro:page-load', initCookieBanner);
</script>