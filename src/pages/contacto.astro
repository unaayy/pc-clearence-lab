---
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Contacto - Lidunax</title>
  </head>
  <body class="bg-black text-slate-100 min-h-screen font-sans flex flex-col justify-between">
    <header class="border-b border-white/10 p-6">
      <a href="/" class="text-lg font-bold text-white font-mono">LID<span class="text-[#00F0FF]">UNAX</span></a>
    </header>

    <main class="max-w-3xl mx-auto px-6 py-12 space-y-6 text-slate-300">
      <h1 class="text-3xl font-bold text-white">Contacto</h1>
      <p>¿Has encontrado un error en las medidas de un componente o quieres sugerir un nuevo chasis/GPU para nuestra base de datos?</p>
      
      <div class="bg-slate-900 border border-white/10 p-6 rounded-2xl font-mono">
        <p class="text-white font-bold mb-2">Correo de soporte e información:</p>
        <p class="text-[#00F0FF]">contacto@lidunax.com</p>
      </div>
    </main>

    <Footer />
  </body>
</html>