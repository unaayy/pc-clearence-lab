---
import hardwareData from '../data/hardware.json';
import SearchInterface from '../components/SearchInterface.jsx';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { cases, gpus } = hardwareData;
const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Lidunax - Comprobador Físico de Hardware y Compatibilidad</title>
    <meta name="description" content="Verifica el espacio libre, holguras y compatibilidad física entre tu chasis y tarjeta gráfica en Lidunax." />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Verificación de Google Search Console -->
    <meta name="google-site-verification" content="oW0LQ9UeXUlzYGx2i7G0AKePLsI9r4p7-o7MxJE0oAI" />
    
    <!-- Carga de la fuente Zen Dots -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Zen+Dots&display=swap" rel="stylesheet">
  </head>

  <body class="bg-black text-slate-100 min-h-screen font-sans selection:bg-[#00F0FF] selection:text-black relative overflow-x-hidden flex flex-col justify-between">
    
    <!-- Fondo Estilo Grid Cyberpunk -->
    <div class="fixed inset-0 bg-[radial-gradient(#1e293b_1px,transparent_1px)] [background-size:24px_24px] opacity-40 pointer-events-none"></div>
    <div class="fixed -top-40 -left-40 w-96 h-96 bg-[#00F0FF]/10 rounded-full blur-[120px] pointer-events-none"></div>
    <div class="fixed -bottom-40 -right-40 w-96 h-96 bg-emerald-500/10 rounded-full blur-[120px] pointer-events-none"></div>

    <div>
      <!-- Navbar Superior con marca LIDUNAX -->
      <header class="relative z-50 border-b border-white/10 backdrop-blur-md bg-black/40">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
          
          <!-- Logo Lidunax -->
          <a href="/" class="flex items-center gap-3 group">
            <div class="w-10 h-10 rounded-xl bg-black border border-[#00F0FF]/50 flex items-center justify-center shadow-[0_0_10px_rgba(0,240,255,0.2)] group-hover:border-[#00F0FF] transition">
              <span class="text-[#00F0FF] text-sm font-bold" style="font-family: 'Orbitron', sans-serif;">LDX</span>
            </div>
            <span class="text-lg tracking-wider font-bold text-white" style="font-family: 'Orbitron', sans-serif;">LID<span class="text-[#00F0FF]">UNAX</span></span>
          </a>

          <!-- Espacio vacío (Botón de 'Iniciar sesión' eliminado) -->
          <div></div>
        </div>
      </header>

      <!-- Bloque Principal -->
      <main class="relative z-10 max-w-4xl mx-auto px-4 pt-16 pb-12 space-y-12">
        
        <!-- Título Principal -->
        <div class="text-center space-y-4">
          <h1 class="text-3xl sm:text-5xl font-extrabold tracking-wide text-white uppercase" style="font-family: 'Orbitron', sans-serif;">
            COMPROBAR <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#00F0FF] to-emerald-400">COMPATIBILIDAD</span>
          </h1>
          <p class="text-slate-300 text-base sm:text-lg font-mono max-w-xl mx-auto">
            Verifica el espacio libre y las holguras exactas antes de ensamblar tu PC.
          </p>
        </div>

        <!-- Buscador Interactivo -->
        <SearchInterface client:load cases={cases} gpus={gpus} />

        <!-- Tagline de afiliados bajo el buscador -->
        <p class="text-center text-xs text-slate-500 font-mono">
          * Lidunax analiza las métricas de espacio libre mediante la base de datos oficial de fabricantes.
        </p>

        <!-- Sección SEO & Guía de Tolerancias para AdSense -->
        <section class="pt-12 border-t border-white/10 space-y-12">
          
          <!-- Explicación Técnica -->
          <div class="space-y-4">
            <h2 class="text-xl sm:text-2xl font-bold text-white uppercase tracking-wide" style="font-family: 'Orbitron', sans-serif;">
              ¿Cómo evaluamos la compatibilidad física en Lidunax?
            </h2>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-mono">
              El análisis de compatibilidad de Lidunax contrasta las dimensiones reales de profundidad, anchura y altura de la tarjeta gráfica frente al espacio libre del chasis, teniendo en cuenta la instalación de radiadores frontales y el margen lateral para el conector de alimentación.
            </p>
          </div>

          <!-- Cuadrícula de Métricas Clave -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-slate-950/60 border border-white/10 p-5 rounded-2xl space-y-2">
              <div class="text-[#00F0FF] font-bold text-base font-mono">01 // Holgura Longitudinal</div>
              <p class="text-slate-400 text-xs leading-relaxed font-mono">
                Medimos la longitud total de la GPU frente al espacio máximo del chasis, restando 30mm si se monta un radiador de refrigeración líquida AIO en el frontal.
              </p>
            </div>

            <div class="bg-slate-950/60 border border-white/10 p-5 rounded-2xl space-y-2">
              <div class="text-[#00F0FF] font-bold text-base font-mono">02 // Espacio Lateral 12VHPWR</div>
              <p class="text-slate-400 text-xs leading-relaxed font-mono">
                Las gráficas modernas sufren sobrecalentamiento si el cable se dobla contra el cristal. Garantizamos un margen mínimo de 35mm para evitar el estrés del conector.
              </p>
            </div>

            <div class="bg-slate-950/60 border border-white/10 p-5 rounded-2xl space-y-2">
              <div class="text-[#00F0FF] font-bold text-base font-mono">03 // Grosor de Ranuras PCIe</div>
              <p class="text-slate-400 text-xs leading-relaxed font-mono">
                Verificamos las ranuras de expansión (slots) requeridas para asegurar que el disipador de la gráfica no colisione con el cobertor de la fuente de alimentación.
              </p>
            </div>
          </div>

          <!-- Sección de Preguntas Frecuentes (FAQs) -->
          <div class="space-y-6 pt-6">
            <h3 class="text-lg font-bold text-white uppercase tracking-wider font-mono">Preguntas Frecuentes sobre Montaje de PC</h3>
            
            <div class="space-y-4 text-sm font-mono">
              <div class="border border-white/10 bg-slate-950/40 p-4 rounded-xl space-y-2">
                <h4 class="text-slate-100 font-bold">¿Qué ocurre si la holgura entre la GPU y el chasis es inferior a 10 mm?</h4>
                <p class="text-slate-400 text-xs leading-relaxed">
                  Aunque la tarjeta quepa físicamente, un espacio inferior a 10 mm restringe el flujo de aire entrante desde los ventiladores frontales, aumentando las temperaturas de funcionamiento e impactando el rendimiento térmico.
                </p>
              </div>

              <div class="border border-white/10 bg-slate-950/40 p-4 rounded-xl space-y-2">
                <h4 class="text-slate-100 font-bold">¿Por qué es importante usar un adaptador acodado a 90°?</h4>
                <p class="text-slate-400 text-xs leading-relaxed">
                  En conectores 12VHPWR/12V-2x6, doblar excesivamente el cable de alimentación principal al cerrar el panel de cristal templado puede causar una mala inserción de los pines y generar un fallo eléctrico.
                </p>
              </div>
            </div>
          </div>

        </section>

        <!-- Combinaciones Frecuentes -->
        <section class="pt-8 space-y-5">
          <div class="flex items-center gap-3 text-xs sm:text-sm text-slate-400 uppercase tracking-widest" style="font-family: 'Orbitron', sans-serif;">
            <span class="w-2 h-2 rounded-full bg-[#00F0FF] animate-pulse"></span>
            Combinaciones frecuentes
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {cases.slice(0, 3).map((caseItem) => (
              gpus.slice(0, 2).map((gpuItem) => (
                <a
                  href={`/${caseItem.slug}-vs-${gpuItem.slug}`}
                  class="bg-slate-950/60 hover:bg-slate-900 border border-white/10 hover:border-[#00F0FF]/50 p-4 rounded-2xl text-sm text-slate-200 transition-all duration-300 flex items-center justify-between group backdrop-blur-sm"
                >
                  <div class="truncate pr-2">
                    <div class="text-white font-bold text-sm sm:text-base truncate" style="font-family: 'Orbitron', sans-serif;">{caseItem.brand} {caseItem.model}</div>
                    <div class="text-slate-400 text-xs font-mono truncate">vs {gpuItem.brand} {gpuItem.model}</div>
                  </div>
                  <span class="text-[#00F0FF] text-base opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all">→</span>
                </a>
              ))
            ))}
          </div>
        </section>

      </main>
    </div>

    <!-- Footer Global con aviso de Amazon -->
    <Footer />

  </body>
</html>