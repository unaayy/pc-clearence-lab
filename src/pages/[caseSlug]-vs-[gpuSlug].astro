---
import hardwareData from '../data/hardware.json';
import { calculateClearance } from '../utils/clearanceEngine';
import { AffiliateBanners } from '../components/AffiliateBanners';
import { ClearanceCanvas } from '../components/ClearanceCanvas';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

export async function getStaticPaths() {
  const { cases, gpus } = hardwareData;
  const paths = [];

  for (const caseItem of cases) {
    for (const gpuItem of gpus) {
      paths.push({
        params: { caseSlug: caseItem.slug, gpuSlug: gpuItem.slug },
        props: { caseObj: caseItem, gpuObj: gpuItem },
      });
    }
  }
  return paths;
}

const { caseObj, gpuObj } = Astro.props;
const result = calculateClearance(caseObj, gpuObj);
const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>¿Es compatible la {gpuObj.brand} {gpuObj.model} con la caja {caseObj.brand} {caseObj.model}? - Lidunax</title>
    <meta name="description" content={`Análisis técnico de compatibilidad física entre la tarjeta gráfica ${gpuObj.brand} ${gpuObj.model} y la caja ${caseObj.brand} ${caseObj.model}.`} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Datos Estructurados JSON-LD Schema.org -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": `Compatibilidad: ${caseObj.brand} ${caseObj.model} vs ${gpuObj.brand} ${gpuObj.model}`,
      "description": `Informe técnico de tolerancia física, espacio libre y holgura entre la caja ${caseObj.brand} ${caseObj.model} y la gráfica ${gpuObj.brand} ${gpuObj.model}.`,
      "url": canonicalURL.toString(),
      "about": [
        {
          "@type": "Thing",
          "name": `${caseObj.brand} ${caseObj.model}`
        },
        {
          "@type": "Thing",
          "name": `${gpuObj.brand} ${gpuObj.model}`
        }
      ]
    })} />
  </head>

  <body class="bg-black text-slate-100 min-h-screen font-sans flex flex-col justify-between selection:bg-[#00F0FF] selection:text-black">
    <div>
      <header class="border-b border-white/10 backdrop-blur-md bg-black/40">
        <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
          <a href="/" class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-black border border-[#00F0FF]/50 flex items-center justify-center shadow-[0_0_10px_rgba(0,240,255,0.2)]">
              <span class="text-[#00F0FF] text-sm font-bold" style="font-family: 'Orbitron', sans-serif;">LDX</span>
            </div>
            <span class="text-lg tracking-wider font-bold text-white" style="font-family: 'Orbitron', sans-serif;">LID<span class="text-[#00F0FF]">UNAX</span></span>
          </a>

          <nav class="flex gap-6 text-sm font-mono text-slate-300">
            <a href="/" class="hover:text-[#00F0FF] transition-colors">Inicio</a>
            <a href="/faq" class="hover:text-[#00F0FF] transition-colors">FAQ</a>
          </nav>
        </div>
      </header>

      <main class="max-w-4xl mx-auto px-4 py-12 space-y-10">
        
        <div class="text-center space-y-3">
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white" style="font-family: 'Orbitron', sans-serif;">
            {caseObj.brand} {caseObj.model} <span class="text-[#00F0FF]">VS</span> {gpuObj.brand} {gpuObj.model}
          </h1>
          <p class="text-slate-400 font-mono text-sm">
            Informe técnico de tolerancia física, espacio libre y flujo de aire.
          </p>
        </div>

        <!-- GRÁFICA VISUAL -->
        <div class="w-full flex justify-center py-4">
          <ClearanceCanvas client:load caseObj={caseObj} gpuObj={gpuObj} />
        </div>

        <!-- Banners de Afiliación & Resultado -->
        <AffiliateBanners client:load result={result} gpuObj={gpuObj} caseObj={caseObj} />

        <!-- Tabla de Especificaciones Comparativas -->
        <section class="bg-slate-950/60 border border-white/10 p-6 rounded-2xl space-y-4">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider font-mono">
            Métricas de Dimensiones Comparadas
          </h2>
          
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm font-mono border-collapse">
              <thead>
                <tr class="border-b border-white/10 text-[#00F0FF]">
                  <th class="py-3 px-2">Parámetro</th>
                  <th class="py-3 px-2">Caja: {caseObj.model}</th>
                  <th class="py-3 px-2">GPU: {gpuObj.model}</th>
                  <th class="py-3 px-2">Resultado / Margen</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-white/5 text-slate-300">
                <tr>
                  <td class="py-3 px-2 font-semibold">Longitud Máxima</td>
                  <td class="py-3 px-2">{caseObj.maxGpuLengthMM} mm</td>
                  <td class="py-3 px-2">{gpuObj.dimensions.lengthMM} mm</td>
                  <td class="py-3 px-2 font-bold text-[#00F0FF]">{result.frontMarginMM} mm libres</td>
                </tr>
                <tr>
                  <td class="py-3 px-2 font-semibold">Ancho / Margen Lateral</td>
                  <td class="py-3 px-2">{caseObj.internalWidthMM} mm</td>
                  <td class="py-3 px-2">{gpuObj.dimensions.widthMM} mm</td>
                  <td class="py-3 px-2">{result.lateralMarginMM} mm para cable</td>
                </tr>
                <tr>
                  <td class="py-3 px-2 font-semibold">Conector / Alimentación</td>
                  <td class="py-3 px-2">-</td>
                  <td class="py-3 px-2">{gpuObj.connectorType}</td>
                  <td class="py-3 px-2">{result.status === 'RED' ? 'Incompatible' : 'Compatible'}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </section>

        <!-- Análisis Técnico y Evaluación Dinámica -->
        <section class="bg-slate-950/40 border border-white/10 p-6 rounded-2xl space-y-4 text-sm font-mono text-slate-300 leading-relaxed">
          <h2 class="text-lg font-bold text-white uppercase tracking-wider font-mono">
            Análisis de Ensamblaje y Flujo de Aire
          </h2>
          
          <p>
            Al instalar la <strong>{gpuObj.brand} {gpuObj.model}</strong> (longitud de <strong>{gpuObj.dimensions.lengthMM} mm</strong>) dentro del chasis <strong>{caseObj.brand} {caseObj.model}</strong> (capaz de albergar hasta <strong>{caseObj.maxGpuLengthMM} mm</strong>), el espacio frontal restante es de <strong>{result.frontMarginMM} mm</strong> (descontando el grosor estándar de instalación frontal).
          </p>

          <!-- Condicional por margen frontal (AIO/Refrigeración) -->
          {result.frontMarginMM < 15 && result.frontMarginMM >= 0 && (
            <p class="text-amber-400">
              <strong>Nota sobre AIO/Refrigeración:</strong> El espacio libre es estrecho ({result.frontMarginMM} mm). Si planeas montar un radiador de refrigeración líquida frontal, recuerda que los radiadores estándar ocupan ~27 mm (más 25 mm de ventiladores), por lo que deberás montar el AIO en el panel superior.
            </p>
          )}

          <!-- Condicional por conector 12VHPWR / Alimentación -->
          {gpuObj.connectorType?.includes('16-pin') || gpuObj.connectorType?.includes('12VHPWR') ? (
            <p class="text-slate-300">
              <strong>Gestión de Cableado:</strong> Esta tarjeta gráfica utiliza el conector <strong>{gpuObj.connectorType}</strong>. Se recomienda verificar que la holgura lateral supere los 30 mm respecto al panel lateral de cristal para evitar doblados pronunciados en el cable de alimentación.
            </p>
          ) : null}

          <!-- Lista de avisos del motor de compatibilidad -->
          <div class="space-y-2 mt-4">
            {result.warnings.map((warning) => (
              <p class={result.status === 'GREEN' ? "text-[#00FF66]" : result.status === 'YELLOW' ? "text-[#FFCC00]" : "text-[#FF0055]"}>
                <strong>Aviso técnico:</strong> {warning}
              </p>
            ))}
          </div>
        </section>

      </main>
    </div>

    <Footer />
  </body>
</html>