---
// src/pages/aviso-legal.astro - Página de Aviso Legal y Afiliación (Liquid Glass HUD)
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, 'https://www.lidunax.com');
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aviso Legal y Afiliación - Términos | LIDUNAX</title>
    <link rel="icon" type="image/png" href="/logo2.png?v=5" />
    <meta name="description" content="Términos de uso, exención de responsabilidad sobre telemetría de hardware y divulgación del programa de afiliados de Lidunax." />
    <link rel="canonical" href={canonicalURL} />

    <!-- Carga de Orbitron -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Datos Estructurados JSON-LD Schema.org para WebPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebPage",
      "name": "Aviso Legal - Lidunax",
      "description": "Aviso legal, exención de responsabilidad y programa de afiliados para el sitio web lidunax.com.",
      "url": canonicalURL.href,
      "publisher": {
        "@type": "Organization",
        "name": "Lidunax",
        "url": "https://www.lidunax.com"
      }
    })} />
  </head>

  <body class="bg-[#050507] text-white min-h-screen relative overflow-x-hidden flex flex-col justify-between selection:bg-[#00ffff] selection:text-black">
    
    <!-- Canvas interactivo de partículas -->
    <canvas id="dotsCanvas" class="fixed inset-0 w-full h-full pointer-events-none z-0" aria-hidden="true"></canvas>

    <!-- Campana Cenital (Fuente de luz) -->
    <div class="spotlight-campana absolute top-0 left-1/2 -translate-x-1/2 w-[100vw] h-[620px] pointer-events-none z-0" aria-hidden="true"></div>

    <div class="page relative z-10 flex flex-col min-h-screen justify-between">
      
      <!-- Navbar Estandarizado -->
      <header class="nav sf">
        <div class="nav__in">
         <a href="/" class="brand flex items-center gap-3">
      <img src="/logoancho.png" alt="LDX" width="160" height="32" class="h-8 sm:h-10 w-auto object-contain" />
      <span class="brand__name orb">LIDUNAX</span>
    </a>

          <nav class="nav__links" aria-label="Principal" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
            <a href="/" class="hover:text-white transition-colors">Inicio</a>
            <a href="/faq" class="hover:text-white transition-colors">FAQ</a>
            <a href="/about" class="hover:text-white transition-colors">Sobre nosotros</a>
          </nav>
        </div>
      </header>

      <!-- Contenido Principal -->
      <main class="main w-full max-w-4xl mx-auto px-4 pt-16 pb-24 space-y-12">
        
        <!-- Hero Section Aviso Legal -->
        <section class="text-center space-y-4 rise" style="--d:.05s">
          <h1 class="text-3xl sm:text-5xl font-bold tracking-widest uppercase orb bg-gradient-to-b from-[#ffffff] via-[#ffffff] to-[#8e8e93] bg-clip-text text-transparent">
            AVISO LEGAL
          </h1>
          <p class="text-[#86868b] text-sm sm:text-base tracking-wide max-w-xl mx-auto font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
            Términos de uso, marco regulatorio y políticas de exención aplicables a la plataforma <code class="text-[#00ffff] bg-black/40 px-1.5 py-0.5 rounded text-xs font-mono">lidunax.com</code>.
          </p>
        </section>

        <!-- Bloque Principal Liquid Glass -->
        <section class="card relative p-6 sm:p-10 space-y-10 rise-soft" style="--d:.2s">
          <!-- Brillo superior decorativo de la tarjeta -->
          <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[60%] h-[1px] bg-gradient-to-r from-transparent via-[#00ffff]/30 to-transparent pointer-events-none"></div>

          <!-- Introducción -->
          <div class="space-y-2 border-b border-white/5 pb-6">
            <span class="text-xs font-orbitron text-[#00ffff] tracking-widest uppercase orb opacity-80">// MARCO_REGULATORIO</span>
            <p class="text-slate-300 text-sm sm:text-base leading-relaxed font-light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
              El presente aviso legal regula el acceso, navegación y uso del sitio web oficial <strong class="text-white font-semibold">lidunax.com</strong>.
            </p>
          </div>

          <!-- Secciones Legales -->
          <div class="space-y-8">
            
            <!-- 01 Exención de Responsabilidad -->
            <div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] space-y-3">
              <span class="text-[#00ffff] text-xs font-orbitron tracking-widest orb">01 // EXENCIÓN DE RESPONSABILIDAD</span>
              <h2 class="text-white text-lg font-semibold" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                Tolerancias y Variaciones de Hardware
              </h2>
              <p class="text-sm text-[#86868b] font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                Lidunax proporciona un simulador automatizado de compatibilidad de hardware basado en las especificaciones oficiales publicadas por los fabricantes. Aunque trabajamos de forma continua para mantener la precisión de los datos, Lidunax no se hace responsable de variaciones mínimas en el ensamblaje final, revisiones de chasis no notificadas o modificaciones físicas realizadas por las marcas.
              </p>
            </div>

            <!-- 02 Enlaces de Afiliados -->
            <div class="p-6 rounded-2xl border border-white/5 bg-white/[0.01] space-y-3">
              <span class="text-[#00ffff] text-xs font-orbitron tracking-widest orb">02 // ENLACES DE AFILIADOS</span>
              <h2 class="text-white text-lg font-semibold" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                Divulgación del Programa de Afiliados
              </h2>
              <p class="text-sm text-[#86868b] font-light leading-relaxed" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
                Lidunax participa en el <strong class="text-slate-200 font-medium">Programa de Afiliados de Amazon EU</strong>, un programa de publicidad para afiliados diseñado para ofrecer a sitios web un modo de obtener comisiones por publicidad, publicitando e incluyendo enlaces directos a <span class="text-[#00ffff] font-mono text-xs">Amazon.es</span> y otras tiendas asociadas.
              </p>
            </div>

          </div>

          <!-- Badge Footer de Transparencia -->
          <div class="bg-black/40 border border-white/10 rounded-2xl p-4 sm:p-6 text-center sm:text-left flex flex-col sm:flex-row items-center justify-between gap-4">
            <span class="text-xs text-[#86868b] font-light" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;">
              ¿Tienes alguna consulta legal o sobre tratamiento de datos?
            </span>
            <a href="/contacto" class="px-4 py-2 rounded-xl bg-white/5 border border-white/10 hover:border-[#00ffff]/50 text-xs font-orbitron text-[#00ffff] tracking-wider transition-all duration-300 orb">
              CONTACTAR SOPORTE →
            </a>
          </div>

        </section>

      </main>

      <Footer />
    </div>

    <!-- Script de Partículas Reactivas -->
    <script>
      interface Dot { x: number; y: number; baseRadius: number; vx: number; vy: number; baseAlpha: number; }

      function initDots() {
        const canvas = document.getElementById('dotsCanvas') as HTMLCanvasElement | null;
        if (!canvas || canvas.dataset.ready) return;
        const ctx = canvas.getContext('2d') as CanvasRenderingContext2D | null;
        if (!ctx) return;
        canvas.dataset.ready = '1';

        const speed = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1;
        let width = 0; let height = 0;

        const resize = () => {
          if (!canvas.isConnected) { window.removeEventListener('resize', resize); return; }
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          width = window.innerWidth; height = window.innerHeight;
          canvas.width = Math.floor(width * dpr); canvas.height = Math.floor(height * dpr);
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };
        resize(); window.addEventListener('resize', resize);

        const dots: Dot[] = [];
        const numDots = Math.min(240, Math.floor((width * height) / 9000));
        for (let i = 0; i < numDots; i++) {
          dots.push({
            x: Math.random() * width, y: Math.random() * height,
            baseRadius: Math.random() * 1.3 + 0.4,
            vx: (Math.random() - 0.5) * 0.2, vy: (Math.random() - 0.5) * 0.2,
            baseAlpha: Math.random() * 0.35 + 0.15,
          });
        }

        const animate = () => {
          if (!canvas.isConnected) return;
          ctx.clearRect(0, 0, width, height);

          const lightX = width / 2;
          const lightY = -window.scrollY;
          const maxLight = Math.min(width, height) * 0.65;

          for (const dot of dots) {
            dot.x += dot.vx * speed; dot.y += dot.vy * speed;
            if (dot.x < 0) dot.x = width; if (dot.x > width) dot.x = 0;
            if (dot.y < 0) dot.y = height; if (dot.y > height) dot.y = 0;

            const distance = Math.hypot(dot.x - lightX, dot.y - lightY);
            ctx.beginPath();

            if (distance < maxLight) {
              const lightFactor = Math.pow(1 - distance / maxLight, 1.8);
              const radius = dot.baseRadius + lightFactor * 1.2;
              const alpha = Math.min(1, dot.baseAlpha + lightFactor * 0.65);
              ctx.arc(dot.x, dot.y, radius, 0, Math.PI * 2);

              const r = Math.round(180 * (1 - lightFactor));
              const g = Math.round(180 * (1 - lightFactor) + 255 * lightFactor);
              const b = Math.round(190 * (1 - lightFactor) + 255 * lightFactor);
              ctx.fillStyle = `rgba(${r}, ${g}, ${b}, ${alpha})`;

              if (lightFactor > 0.4) { ctx.shadowColor = 'rgba(0, 255, 255, 0.6)'; ctx.shadowBlur = 6; } 
              else { ctx.shadowBlur = 0; }
            } else {
              ctx.arc(dot.x, dot.y, dot.baseRadius, 0, Math.PI * 2);
              ctx.fillStyle = `rgba(180, 180, 190, ${dot.baseAlpha})`; ctx.shadowBlur = 0;
            }
            ctx.fill();
          }
          requestAnimationFrame(animate);
        };
        animate();
      }
      document.addEventListener('astro:page-load', initDots);
      initDots();
    </script>

    <style>
      /* ───────── Tipografía y Sistema Global ───────── */
      .orb { font-family: 'Orbitron', sans-serif !important; }

      .spotlight-campana {
        background: radial-gradient(
          ellipse 80% 50% at 50% 0%, rgba(0, 255, 255, 0.12) 0%, rgba(0, 255, 255, 0.03) 40%, rgba(0, 255, 255, 0.008) 70%, transparent 100%
        );
        filter: blur(60px);
      }

      /* ───────── Navbar (Reutilizado) ───────── */
      .nav { position: sticky; top: 0; z-index: 50; background: rgba(5, 5, 7, 0.55); border-bottom: 1px solid rgba(255, 255, 255, 0.06); -webkit-backdrop-filter: saturate(180%) blur(20px); backdrop-filter: saturate(180%) blur(20px); }
      .nav__in { max-width: 1200px; margin: 0 auto; padding: 0 24px; height: 64px; display: flex; align-items: center; justify-content: space-between; }
      .brand { display: flex; align-items: center; gap: 12px; }
      .brand__mark { width: 34px; height: 34px; border-radius: 10px; background: #121215; border: 1px solid rgba(255, 255, 255, 0.1); display: grid; place-items: center; transition: border-color 0.3s, box-shadow 0.3s; }
      .brand__mark span { color: #00ffff; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; }
      .brand:hover .brand__mark { border-color: rgba(0, 255, 255, 0.5); box-shadow: 0 0 20px rgba(0, 255, 255, 0.15); }
      .brand__name { font-size: 1.05rem; font-weight: 700; letter-spacing: 0.18em; color: #fff; }
      .nav__links { display: flex; gap: 32px; font-size: 14px; color: #86868b; }
      @media (max-width: 560px) { .brand__name { display: none; } .nav__links { gap: 20px; font-size: 13px; } }

      /* ───────── Animaciones de Entrada ───────── */
      .rise { opacity: 0; animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards; }
      .rise-soft { opacity: 0; animation: rise-soft 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) var(--d, 0s) forwards; }
      @keyframes rise { from { opacity: 0; transform: translateY(16px); filter: blur(8px); } to { opacity: 1; transform: none; filter: none; } }
      @keyframes rise-soft { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }

      /* ───────── Tarjeta Liquid Glass Base ───────── */
      .card { border-radius: 28px; border: 1px solid rgba(255, 255, 255, 0.09); background: linear-gradient(180deg, rgba(255, 255, 255, 0.04), rgba(255, 255, 255, 0.01) 45%, rgba(0, 0, 0, 0.6)); box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 30px 60px rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(32px); backdrop-filter: blur(32px); }

      /* Reduce motion fallback */
      @media (prefers-reduced-motion: reduce) {
        .rise, .rise-soft { animation: none; opacity: 1; transform: none; filter: none; }
      }
    </style>
  </body>
</html>